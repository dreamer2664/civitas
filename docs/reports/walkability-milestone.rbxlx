            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">NetworkSource</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Where the map's network data comes from. The map asks a source for a table and validates it
	(MapModel.validate); it never reads a file, a remote or a Workspace instance itself.

	Sources in use or planned:
	- module: UI/Map/NetworkData.luau, generated from docs/rail/NETWORK.md by tools/gen_network.py.
	  This is what the client ships. Roblox cannot read a Markdown file at runtime, so it is generated.
	- stub: tests/fixtures/network-stub.luau, synthetic. Used only to test the source boundary.

	Pure: no requires, so lune can test every source. A caller builds the source and passes it in.
]]

local NetworkSource = {}

-- `load` returns the data, or nil and a reason. A reason is for the developer log, not the player.
export type Source = {
	name: string,
	load: () -> (any?, string?),
}

-- A source that returns the given table as is. Validation happens in the map, not here.
function NetworkSource.fromTable(name: string, data: any): Source
	return {
		name = name,
		load = function()
			return data, nil
		end,
	}
end

-- A source that always fails with a reason. Used to test the "unavailable" screen.
function NetworkSource.unavailable(name: string, reason: string): Source
	return {
		name = name,
		load = function()
			return nil, reason
		end,
	}
end

return NetworkSource
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Navigation</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Screen navigation as an immutable stack. Pure: every operation returns a new value, so a test
	can replay any sequence of presses and check the result.

	Rules (the spec in UI-SPEC §6 is the source of truth):
	- Pushing the screen already on top does nothing (double taps must not stack screens).
	- Pushing a screen already in the stack pops back to it. The stack never holds duplicates, so
	  "back" always returns to a screen the player has actually seen, in order.
	- Back at the root reports "atRoot". The caller then opens the pause menu, rather than the
	  navigation layer deciding what the game does.
]]

local Navigation = {}

export type Stack = { ids: { string } }
export type BackResult = "popped" | "atRoot"

function Navigation.new(root: string): Stack
	assert(root ~= "", "Navigation root must be a non-empty screen id")
	return { ids = { root } }
end

function Navigation.top(nav: Stack): string
	return nav.ids[#nav.ids]
end

function Navigation.depth(nav: Stack): number
	return #nav.ids
end

function Navigation.contains(nav: Stack, id: string): boolean
	for _, existing in nav.ids do
		if existing == id then
			return true
		end
	end
	return false
end

function Navigation.push(nav: Stack, id: string): Stack
	assert(id ~= "", "screen id must be non-empty")
	if Navigation.top(nav) == id then
		return nav
	end
	-- Revisiting a screen pops back to it, so the stack holds no duplicates.
	local ids = {}
	for _, existing in nav.ids do
		table.insert(ids, existing)
		if existing == id then
			return { ids = ids }
		end
	end
	table.insert(ids, id)
	return { ids = ids }
end

function Navigation.replace(nav: Stack, id: string): Stack
	assert(id ~= "", "screen id must be non-empty")
	local ids = table.clone(nav.ids)
	ids[#ids] = id
	return { ids = ids }
end

function Navigation.back(nav: Stack): (Stack, BackResult)
	if #nav.ids <= 1 then
		return nav, "atRoot"
	end
	local ids = table.clone(nav.ids)
	table.remove(ids)
	return { ids = ids }, "popped"
end

return Navigation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Style</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Roblox binding of the Theme tokens: Color3, Enum.Font, TextSize, reduced motion. This file only
	converts a token into a Roblox value. It decides nothing. A new value belongs in Theme.luau.

	Fonts are an explicit table rather than Enum.Font[name]: a misspelt face then fails analysis
	instead of silently falling back to the default look the directive forbids.
]]

local Theme = require(script.Parent.Theme)
local Layout = require(script.Parent.Layout)

local Style = {}

export type ColorName =
	"ink"
	| "surface"
	| "raised"
	| "pressed"
	| "hairline"
	| "text"
	| "textMuted"
	| "textFaint"
	| "accent"
	| "accentText"
	| "proceed"
	| "caution"
	| "stop"
	| "sign"
	| "signText"

export type TypeName =
	"display"
	| "title"
	| "heading"
	| "body"
	| "label"
	| "caption"
	| "sign"
	| "signLarge"
	| "numXL"
	| "numL"
	| "numM"

local FONTS: { [string]: Enum.Font } = {
	BuilderSansExtraBold = Enum.Font.BuilderSansExtraBold,
	BuilderSansBold = Enum.Font.BuilderSansBold,
	BuilderSansMedium = Enum.Font.BuilderSansMedium,
	BuilderSans = Enum.Font.BuilderSans,
	RobotoCondensed = Enum.Font.RobotoCondensed,
	RobotoMono = Enum.Font.RobotoMono,
}

-- Set by the settings screen. When true, every transition duration except `instant` is zero.
local reducedMotion = false

function Style.setReducedMotion(enabled: boolean)
	reducedMotion = enabled
end

function Style.hex(hex: string): Color3
	local r, g, b = Theme.rgb(hex)
	return Color3.fromRGB(r, g, b)
end

function Style.color(name: ColorName): Color3
	return Style.hex(Theme.palette[name])
end

-- Transition length in seconds for a motion token. Reduced motion collapses it to zero.
function Style.duration(name: "instant" | "fast" | "base" | "slow"): number
	if reducedMotion then
		return 0
	end
	return Theme.motion[name]
end

export type Elevation = "flat" | "raised" | "overlay"

-- Fill colour for a depth level. The level-to-token mapping is data in Theme.elevation.
function Style.elevation(level: Elevation): Color3
	return Style.color(Theme.elevation[level] :: ColorName)
end

function Style.font(name: TypeName): Enum.Font
	local face = Theme.type[name].face
	local font = FONTS[face]
	assert(font ~= nil, `Style has no Enum.Font mapping for '{face}'`)
	return font
end

-- Roblox class types are not structural tables, so TextLabel, TextButton and TextBox cannot be
-- passed as a `{ FontFace, TextSize }` table type. The one cast below is therefore guarded by an
-- explicit IsA check: anything that is not a text object is rejected before the cast happens.
type TextProperties = { FontFace: Font, TextSize: number }

-- Applies face and size from a type token. Size passes through the design floor and ceiling.
function Style.applyType(target: GuiObject, name: TypeName)
	if not (target:IsA("TextLabel") or target:IsA("TextButton") or target:IsA("TextBox")) then
		error(`Style.applyType needs a text object, got {target.ClassName}`)
	end
	local style = Theme.type[name]
	local text: TextProperties = target :: any
	text.FontFace = Font.fromEnum(Style.font(name))
	text.TextSize = Layout.clampTextSize(style.size, Theme.size.minTextSize, Theme.size.maxTextSize)

	-- The Roblox-side guard: reuse the constraint if the object already has one, so re-styling
	-- never stacks constraints. The floor is the design floor, not the platform minimum of 9.
	local existing = target:FindFirstChildOfClass("UITextSizeConstraint")
	local constraint: UITextSizeConstraint = existing or Instance.new("UITextSizeConstraint")
	if existing == nil then
		constraint.Parent = target
	end
	constraint.MinTextSize = Theme.size.minTextSize
	constraint.MaxTextSize = Theme.size.maxTextSize
end

return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Text</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Glyph coverage guard. A font that lacks a character draws a box, and nothing in Roblox warns
	about it, so this module checks every string a label is given against the coverage the font
	is declared to have, and fails loudly with the exact characters at fault.

	Pure: code points in, code points out. The Roblox components call it with the ranges from
	FontCoverage.luau. It deliberately knows nothing about fonts, so the same check runs in lune.
]]

local Text = {}

export type Range = { lo: number, hi: number }

local function isCovered(codepoint: number, ranges: { Range }): boolean
	for _, range in ranges do
		if codepoint >= range.lo and codepoint <= range.hi then
			return true
		end
	end
	return false
end

-- Each uncovered character once, as "Ł (U+0141)", in order of first appearance.
function Text.uncovered(s: string, ranges: { Range }): { string }
	if utf8.len(s) == nil then
		error("Text.uncovered: the string is not valid UTF-8, so its characters cannot be checked")
	end
	local missing: { string } = {}
	local seen: { [number]: boolean } = {}
	for _, codepoint in utf8.codes(s) do
		if not seen[codepoint] and not isCovered(codepoint, ranges) then
			seen[codepoint] = true
			table.insert(missing, `{utf8.char(codepoint)} (U+{string.format("%04X", codepoint)})`)
		end
	end
	return missing
end

-- Errors with the label, the characters and the remedy. A rendered box is the failure this stops.
function Text.assertCovered(label: string, s: string, ranges: { Range })
	local missing = Text.uncovered(s, ranges)
	if #missing > 0 then
		error(
			`{label} "{s}" uses characters the font is not declared to cover: {table.concat(
				missing,
				", "
			)}. `
				.. "Either change the text, or, once the glyphs are checked in Studio, add the range to FontCoverage.luau."
		)
	end
end

return Text
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Civitas Signal design tokens (see docs/ui/UI-SPEC.md, sections 3–5).

	Pure data plus pure colour maths: no Roblox API, so lune can test the contrast rules the spec
	promises. Conversion to Color3 and Enum.Font happens in UI/Style.luau.

	Why tokens instead of literals: every colour, font, size, space and duration used by a component
	is read from here, so the written spec and the running code cannot drift apart. A component that
	hard-codes a colour is a review rejection.
]]

local Theme = {}

export type Palette = {
	ink: string,
	surface: string,
	raised: string,
	pressed: string,
	hairline: string,
	text: string,
	textMuted: string,
	textFaint: string,
	accent: string,
	accentText: string,
	proceed: string,
	caution: string,
	stop: string,
	sign: string,
	signText: string,
}

export type TypeStyle = {
	face: string,
	size: number,
}

-- Hex strings without '#'. Values were chosen against the contrast table in UI-SPEC §4 and are
-- re-checked by tests/client/theme.spec.luau. Saturation is deliberately low: nothing here is neon.
Theme.palette = {
	ink = "0E1216", -- behind everything; the world shows through only as a dimmed backdrop
	surface = "161C22", -- panels
	raised = "1F262E", -- cards, buttons at rest
	pressed = "29323C", -- pressed and selected rows
	hairline = "3A4550", -- 1 px borders; decorative only, never the sole carrier of meaning
	text = "EEF1F3", -- primary text
	textMuted = "AEB8C1", -- secondary text
	textFaint = "949FA9", -- captions and units
	accent = "5B8DB8", -- platform blue: fills and focus rings only, never text
	accentText = "84ADD2", -- the same blue lightened for text: 4.5:1 or better on every surface
	proceed = "4E9A6B", -- signal green: normal running, on time
	caution = "D9A441", -- signal amber: late, speed restriction ahead
	stop = "D46B5E", -- signal red: emergency, door fault, danger
	sign = "1E3A46", -- station sign panel
	signText = "F3EFE4", -- warm white on sign panels, like enamel signage
} :: Palette

-- Six line colours for the network map. Each line is also identified by its code (a text badge),
-- so colour is never the only signal (WCAG 1.4.1). Badge text is always ink, and every colour
-- keeps ink at 4.5:1 or better and reaches 3:1 against `surface` (tests/client/theme.spec.luau).
-- Brick sits close to `stop`; the map never shows status colours beside lines, see UI-SPEC §8.
Theme.lineColours = {
	teal = "2A9696",
	ochre = "C99A2E",
	plum = "B47BAF",
	slate = "5C8AC8",
	brick = "C46E5E",
	moss = "6F8F3A",
} :: { [string]: string }

-- Typefaces are restricted to Enum.Font members verified against the Roblox API dump. Only the
-- family names are used; weight comes from the family itself, so no Font.new asset paths are needed.
Theme.type = {
	display = { face = "BuilderSansExtraBold", size = 36 } :: TypeStyle, -- main menu wordmark
	title = { face = "BuilderSansBold", size = 24 } :: TypeStyle, -- screen titles
	heading = { face = "BuilderSansMedium", size = 18 } :: TypeStyle,
	body = { face = "BuilderSans", size = 16 } :: TypeStyle,
	label = { face = "BuilderSansMedium", size = 14 } :: TypeStyle, -- buttons, chips
	caption = { face = "BuilderSans", size = 12 } :: TypeStyle, -- smallest permitted text
	sign = { face = "RobotoCondensed", size = 22 } :: TypeStyle, -- station and destination signs
	signLarge = { face = "RobotoCondensed", size = 40 } :: TypeStyle, -- platform numbers
	numXL = { face = "RobotoMono", size = 56 } :: TypeStyle, -- speed readout in the cab
	numL = { face = "RobotoMono", size = 28 } :: TypeStyle,
	numM = { face = "RobotoMono", size = 18 } :: TypeStyle, -- times on departure rows
}

-- 4-point grid. Every value is a multiple of 4; tests enforce it.
Theme.space = {
	s1 = 4,
	s2 = 8,
	s3 = 12,
	s4 = 16,
	s6 = 24,
	s8 = 32,
	s12 = 48,
}

Theme.radius = {
	sign = 2,
	control = 4,
	panel = 6,
}

Theme.size = {
	touchMin = 48, -- smallest tappable control, in pixels, on any device
	touchComfort = 56, -- cab controls and primary actions
	hairline = 1,
	focusRing = 2,
	dot = 12, -- status dot diameter
	minTextSize = 12, -- UITextSizeConstraint floor; Roblox documents values below 9 as unreadable
	maxTextSize = 72,
}

-- Durations in seconds. Motion is client-only (never a server TweenService: that replicates every
-- frame, see docs/RESOURCES.md). Reduced motion sets every duration except `instant` to 0.
export type Motion = {
	instant: number,
	fast: number,
	base: number,
	slow: number,
	easeStyle: string,
	easeDirection: string,
}

Theme.motion = {
	instant = 0,
	fast = 0.12,
	base = 0.2,
	slow = 0.32,
	easeStyle = "Quad",
	easeDirection = "Out",
} :: Motion

-- ---------------------------------------------------------------------------------------------
-- Colour maths. Pure, so the contrast rules can be tested without Roblox.
-- ---------------------------------------------------------------------------------------------

function Theme.rgb(hex: string): (number, number, number)
	if string.match(hex, "^%x%x%x%x%x%x$") == nil then
		error(`Theme colour must be exactly 6 hex digits, got "{hex}"`)
	end
	local r = tonumber(string.sub(hex, 1, 2), 16) :: number
	local g = tonumber(string.sub(hex, 3, 4), 16) :: number
	local b = tonumber(string.sub(hex, 5, 6), 16) :: number
	return r, g, b
end

local function linear(channel: number): number
	-- sRGB transfer function from WCAG 2.x. Channel is 0..255.
	local c = channel / 255
	if c <= 0.03928 then
		return c / 12.92
	end
	return ((c + 0.055) / 1.055) ^ 2.4
end

function Theme.luminance(hex: string): number
	local r, g, b = Theme.rgb(hex)
	return 0.2126 * linear(r) + 0.7152 * linear(g) + 0.0722 * linear(b)
end

-- Elevation is a fill step, not a drop shadow: shadows cost fill-rate on low-end phones and the
-- palette is night-lit (dark ink base, warm text), so depth reads as a lighter surface. Each level
-- must be lighter than the one below it; tests/client/theme.spec.luau checks that order.
Theme.elevation = {
	flat = "surface",
	raised = "raised",
	overlay = "pressed",
} :: { [string]: string }

-- WCAG 2.x contrast ratio, from 1 to 21.
function Theme.contrast(a: string, b: string): number
	local la = Theme.luminance(a)
	local lb = Theme.luminance(b)
	local hi = math.max(la, lb)
	local lo = math.min(la, lb)
	return (hi + 0.05) / (lo + 0.05)
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
