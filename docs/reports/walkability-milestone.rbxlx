        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CityGenerator</string>
            <string name="Source"><![CDATA[--!strict
-- Pure deterministic city plan. Roblox instance creation lives in CityBuilder, so the exact
-- geometry used by the server can also be tested and rendered headlessly with Lune/Python.
local CityGenerator = {}

export type Segment = {
	axis: string,
	center: number,
	start: number,
	finish: number,
	width: number,
	kind: string,
}

export type Building = {
	x: number,
	z: number,
	width: number,
	depth: number,
	height: number,
	rotation: number,
	style: string,
	landmark: boolean,
	name: string,
}

export type Point = { x: number, z: number, label: string }

local function hash(a: number, b: number, seed: number): number
	local value = (a * 73856093 + b * 19349663 + seed * 83492791) % 2147483647
	value = (value * 48271) % 2147483647
	return value
end

local function range(value: number, minimum: number, maximum: number): number
	return minimum + (value % (maximum - minimum + 1))
end

local function roadKind(
	value: number,
	index: number,
	count: number,
	stationCoordinate: number?,
	laneCoordinates: { number }
): string
	if index == 1 or index == count or value == stationCoordinate then
		return "arterial"
	end
	if table.find(laneCoordinates, value) ~= nil then
		return "lane"
	end
	return "local"
end

local function roadWidth(kind: string, streets: any): number
	if kind == "arterial" then
		return streets.arterialWidth
	elseif kind == "lane" then
		return streets.laneWidth
	end
	return streets.localWidth
end

local function distanceToSegment(
	px: number,
	pz: number,
	x1: number,
	z1: number,
	x2: number,
	z2: number
): number
	local dx = x2 - x1
	local dz = z2 - z1
	local lengthSquared = dx * dx + dz * dz
	local t = math.clamp(((px - x1) * dx + (pz - z1) * dz) / lengthSquared, 0, 1)
	local nearestX = x1 + t * dx
	local nearestZ = z1 + t * dz
	local offsetX = px - nearestX
	local offsetZ = pz - nearestZ
	return math.sqrt(offsetX * offsetX + offsetZ * offsetZ)
end

local function squareContains(x: number, z: number, config: any): boolean
	-- Reserve a small public-realm apron as well as the square footprint, so its approaches
	-- cannot be sealed off by a lot placed directly against the paving edge.
	if
		math.abs(x - config.square.centerX) < config.square.width / 2 + 38
		and math.abs(z - config.square.centerZ) < config.square.depth / 2 + 24
	then
		return true
	end
	for _, square in ipairs(config.pocketSquares) do
		if
			math.abs(x - square.centerX) < square.width / 2 + 12
			and math.abs(z - square.centerZ) < square.depth / 2 + 12
		then
			return true
		end
	end
	return false
end

local function stationContains(x: number, z: number, config: any): boolean
	return math.abs(x - config.station.centerX) < config.station.width / 2 + 20
		and z > config.station.forecourtZ - 18
		and z < config.station.entryZ + 28
end

local function segmentSquareInterval(
	street: any,
	square: any,
	sidewalkWidth: number,
	curbWidth: number
): { number }?
	local dx = street.finishX - street.startX
	local dz = street.finishZ - street.startZ
	local length = math.sqrt(dx * dx + dz * dz)
	local edgeRadius = street.width / 2 + sidewalkWidth + curbWidth
	local insetX = edgeRadius * math.abs(dz) / length
	local insetZ = edgeRadius * math.abs(dx) / length
	local minX = square.centerX - square.width / 2 + insetX
	local maxX = square.centerX + square.width / 2 - insetX
	local minZ = square.centerZ - square.depth / 2 + insetZ
	local maxZ = square.centerZ + square.depth / 2 - insetZ
	if minX >= maxX or minZ >= maxZ then
		return nil
	end
	local enterT = 0
	local exitT = 1
	local function clipAxis(
		origin: number,
		delta: number,
		minimum: number,
		maximum: number
	): boolean
		if math.abs(delta) < 1e-8 then
			return origin >= minimum and origin <= maximum
		end
		local first = (minimum - origin) / delta
		local second = (maximum - origin) / delta
		local axisEnter = math.min(first, second)
		local axisExit = math.max(first, second)
		enterT = math.max(enterT, axisEnter)
		exitT = math.min(exitT, axisExit)
		return enterT < exitT
	end
	if
		not clipAxis(street.startX, dx, minX, maxX) or not clipAxis(street.startZ, dz, minZ, maxZ)
	then
		return nil
	end
	local clippedStart = math.max(0, enterT)
	local clippedFinish = math.min(1, exitT)
	if clippedStart >= clippedFinish then
		return nil
	end
	return { clippedStart, clippedFinish }
end

local function splitSegmentForSquares(street: any, squares: { any }, streets: any): { any }
	local cuts = {}
	for _, square in ipairs(squares) do
		local interval =
			segmentSquareInterval(street, square, streets.sidewalkWidth, streets.curbWidth)
		if interval then
			table.insert(cuts, { start = interval[1], finish = interval[2], square = square })
		end
	end
	if #cuts == 0 then
		return { street }
	end
	table.sort(cuts, function(a, b)
		return a.start < b.start
	end)
	local mergedCuts = {}
	for _, cut in ipairs(cuts) do
		local previous = mergedCuts[#mergedCuts]
		if previous and cut.start <= previous.finish then
			previous.finish = math.max(previous.finish, cut.finish)
		else
			table.insert(mergedCuts, { start = cut.start, finish = cut.finish })
		end
	end
	local dx = street.finishX - street.startX
	local dz = street.finishZ - street.startZ
	local fragments = {}
	local cursor = 0
	local function addFragment(startT: number, finishT: number)
		if finishT - startT <= 1e-8 then
			return
		end
		local fragment = table.clone(street)
		fragment.startX = street.startX + dx * startT
		fragment.startZ = street.startZ + dz * startT
		fragment.finishX = street.startX + dx * finishT
		fragment.finishZ = street.startZ + dz * finishT
		fragment.name = street.name .. "_approach_" .. tostring(#fragments + 1)
		table.insert(fragments, fragment)
	end
	for _, cut in ipairs(mergedCuts) do
		addFragment(cursor, cut.start)
		cursor = math.max(cursor, cut.finish)
	end
	addFragment(cursor, 1)
	return fragments
end

function CityGenerator.generate(config: any): any
	local plan: any = {
		ground = config.ground,
		streets = {},
		intersections = {},
		streetGaps = {},
		squareStreetCuts = {},
		blocks = {},
		buildings = {},
		landmarks = {},
		plaza = config.square,
		pocketSquares = config.pocketSquares,
		station = config.station,
		route = {},
		districtBounds = {
			{
				name = "District A — Historic Centre slice",
				minX = config.ground.centerX - config.ground.width / 2,
				maxX = config.ground.centerX + config.ground.width / 2,
				minZ = config.ground.centerZ - config.ground.depth / 2,
				maxZ = config.ground.centerZ + config.ground.depth / 2,
			},
		},
	}
	local streets = config.streets

	for index, x in ipairs(streets.gridX) do
		local kind = roadKind(x, index, #streets.gridX, streets.stationAvenueX, streets.laneX)
		table.insert(plan.streets, {
			axis = "z",
			center = x,
			start = streets.minZ,
			finish = streets.maxZ,
			width = roadWidth(kind, streets),
			kind = kind,
		})
	end
	for index, z in ipairs(streets.gridZ) do
		local kind = roadKind(z, index, #streets.gridZ, nil, streets.laneZ)
		table.insert(plan.streets, {
			axis = "x",
			center = z,
			start = streets.minX,
			finish = streets.maxX,
			width = roadWidth(kind, streets),
			kind = kind,
		})
	end
	for _, vertical in ipairs(plan.streets) do
		if vertical.axis == "z" then
			for _, horizontal in ipairs(plan.streets) do
				if
					horizontal.axis == "x"
					and vertical.center >= horizontal.start
					and vertical.center <= horizontal.finish
					and horizontal.center >= vertical.start
					and horizontal.center <= vertical.finish
				then
					table.insert(plan.intersections, {
						x = vertical.center,
						z = horizontal.center,
						radius = streets.cornerRadius,
						widthX = vertical.width,
						widthZ = horizontal.width,
					})
				end
			end
		end
	end
	for _, cut in ipairs(streets.cutSegments) do
		table.insert(plan.streets, {
			axis = "segment",
			startX = cut.x1,
			startZ = cut.z1,
			finishX = cut.x2,
			finishZ = cut.z2,
			width = streets.laneWidth,
			kind = "lane",
			name = cut.name,
		})
	end

	local landmarkLots: { { x: number, z: number, name: string, style: string, height: number } } =
		{
			{ x = -570, z = -375, name = "Old Town Clock Tower", style = "tower", height = 112 },
			{ x = -275, z = -375, name = "St. Elian's Church", style = "church", height = 78 },
			{ x = -120, z = -370, name = "Civic Archive Tower", style = "tower", height = 96 },
			{ x = 520, z = -370, name = "North Gate Hotel", style = "hotel", height = 64 },
			{ x = -570, z = -220, name = "Covered Market Hall", style = "market", height = 34 },
			{ x = -120, z = -220, name = "Guildhall", style = "civic", height = 58 },
			{ x = 520, z = -220, name = "Riverside Exchange", style = "tower", height = 105 },
			{ x = -570, z = 75, name = "Opera House", style = "civic", height = 48 },
			{ x = -120, z = 75, name = "South Arcade Tower", style = "tower", height = 88 },
			{ x = 520, z = 75, name = "Museum of Navigation", style = "civic", height = 42 },
			{ x = -570, z = 370, name = "West Bastion Tower", style = "tower", height = 72 },
			{ x = 520, z = 370, name = "East Gate Basilica", style = "church", height = 66 },
		}
	for _, item in ipairs(landmarkLots) do
		table.insert(plan.landmarks, {
			x = item.x,
			z = item.z,
			width = if item.style == "market" then 86 else 44,
			depth = if item.style == "market" then 58 else 42,
			height = item.height,
			rotation = 0,
			style = item.style,
			landmark = true,
			name = item.name,
		})
	end

	local blockIndex = 0
	for xi = 1, #streets.gridX - 1 do
		for zi = 1, #streets.gridZ - 1 do
			local leftKind = roadKind(
				streets.gridX[xi],
				xi,
				#streets.gridX,
				streets.stationAvenueX,
				streets.laneX
			)
			local rightKind = roadKind(
				streets.gridX[xi + 1],
				xi + 1,
				#streets.gridX,
				streets.stationAvenueX,
				streets.laneX
			)
			local topKind = roadKind(streets.gridZ[zi], zi, #streets.gridZ, nil, streets.laneZ)
			local bottomKind =
				roadKind(streets.gridZ[zi + 1], zi + 1, #streets.gridZ, nil, streets.laneZ)
			local left = streets.gridX[xi]
				+ roadWidth(leftKind, streets) / 2
				+ config.blocks.streetInset
			local right = streets.gridX[xi + 1]
				- roadWidth(rightKind, streets) / 2
				- config.blocks.streetInset
			local top = streets.gridZ[zi]
				+ roadWidth(topKind, streets) / 2
				+ config.blocks.streetInset
			local bottom = streets.gridZ[zi + 1]
				- roadWidth(bottomKind, streets) / 2
				- config.blocks.streetInset
			local block = {
				id = blockIndex + 1,
				xi = xi,
				zi = zi,
				minX = left,
				maxX = right,
				minZ = top,
				maxZ = bottom,
			}
			table.insert(plan.blocks, block)
			blockIndex += 1

			for lotX = 1, config.blocks.lotsAcross do
				for lotZ = 1, config.blocks.lotsDeep do
					local cellWidth = (right - left) / config.blocks.lotsAcross
					local cellDepth = (bottom - top) / config.blocks.lotsDeep
					local x = left + (lotX - 0.5) * cellWidth
					local z = top + (lotZ - 0.5) * cellDepth
					local reserved = squareContains(x, z, config) or stationContains(x, z, config)
					for _, landmark in ipairs(plan.landmarks) do
						if
							math.abs(x - landmark.x) < landmark.width / 2 + 23
							and math.abs(z - landmark.z) < landmark.depth / 2 + 23
						then
							reserved = true
						end
					end
					for _, street in ipairs(plan.streets) do
						if street.axis == "segment" then
							local clearance = street.width / 2
								+ streets.sidewalkWidth
								+ math.max(config.blocks.maxWidth, config.blocks.maxDepth) / 2
								+ config.blocks.lotGap
							if
								distanceToSegment(
									x,
									z,
									street.startX,
									street.startZ,
									street.finishX,
									street.finishZ
								) < clearance
							then
								reserved = true
							end
						end
					end
					if not reserved then
						local h = hash(blockIndex, lotX * 17 + lotZ, config.seed)
						local plotWidth = math.min(
							cellWidth - config.blocks.lotGap,
							range(h, config.blocks.minWidth, config.blocks.maxWidth)
						)
						local plotDepth = math.min(
							cellDepth - config.blocks.lotGap,
							range(
								math.floor(h / 17),
								config.blocks.minDepth,
								config.blocks.maxDepth
							)
						)
						table.insert(plan.buildings, {
							x = x,
							z = z,
							width = plotWidth,
							depth = plotDepth,
							height = range(
								math.floor(h / 31),
								config.blocks.minHeight,
								config.blocks.maxHeight
							),
							rotation = if h % 4 == 0 then 90 else 0,
							style = if h % 5 == 0 then "corner-shop" else "historic-terrace",
							frontage = if h % 5 == 0
								then "shopfront"
								elseif h % 4 == 1 then "recessed-entry"
								elseif h % 3 == 0 then "awning"
								else "stone-plinth",
							landmark = false,
							name = "Block "
								.. tostring(blockIndex)
								.. " Plot "
								.. tostring(lotX)
								.. "-"
								.. tostring(lotZ),
						})
					end
				end
			end
		end
	end

	-- Merge adjacent cells into explicit larger parcels and remove their shared road runs.
	-- Freed road footprints become open courtyard space within each irregular superblock.
	local cellBlocks = plan.blocks
	local cellByKey = {}
	for _, cell in ipairs(cellBlocks) do
		cellByKey[tostring(cell.xi) .. ":" .. tostring(cell.zi)] = cell
	end
	local mergedBlocks = {}
	local claimedCells = {}
	local function key(xi: number, zi: number): string
		return tostring(xi) .. ":" .. tostring(zi)
	end
	for _, group in ipairs(config.blocks.superblocks) do
		local groupedCells = {}
		local memberSet = {}
		local minX = math.huge
		local maxX = -math.huge
		local minZ = math.huge
		local maxZ = -math.huge
		for _, reference in ipairs(group.cells) do
			local cellKey = key(reference[1], reference[2])
			local cell = cellByKey[cellKey]
			if cell == nil or claimedCells[cellKey] then
				error("Invalid or overlapping superblock cell " .. cellKey)
			end
			claimedCells[cellKey] = true
			memberSet[cellKey] = true
			table.insert(groupedCells, cell)
			minX = math.min(minX, cell.minX)
			maxX = math.max(maxX, cell.maxX)
			minZ = math.min(minZ, cell.minZ)
			maxZ = math.max(maxZ, cell.maxZ)
		end
		for _, cell in ipairs(groupedCells) do
			local eastKey = key(cell.xi + 1, cell.zi)
			if memberSet[eastKey] then
				table.insert(plan.streetGaps, {
					axis = "z",
					center = streets.gridX[cell.xi + 1],
					start = streets.gridZ[cell.zi],
					finish = streets.gridZ[cell.zi + 1],
				})
			end
			local southKey = key(cell.xi, cell.zi + 1)
			if memberSet[southKey] then
				table.insert(plan.streetGaps, {
					axis = "x",
					center = streets.gridZ[cell.zi + 1],
					start = streets.gridX[cell.xi],
					finish = streets.gridX[cell.xi + 1],
				})
			end
		end
		table.insert(mergedBlocks, {
			id = #mergedBlocks + 1,
			name = group.name,
			superblock = true,
			cells = groupedCells,
			minX = minX,
			maxX = maxX,
			minZ = minZ,
			maxZ = maxZ,
		})
	end
	for _, cell in ipairs(cellBlocks) do
		if not claimedCells[key(cell.xi, cell.zi)] then
			table.insert(mergedBlocks, {
				id = #mergedBlocks + 1,
				name = "Block " .. tostring(cell.id),
				superblock = false,
				cells = { cell },
				minX = cell.minX,
				maxX = cell.maxX,
				minZ = cell.minZ,
				maxZ = cell.maxZ,
			})
		end
	end
	plan.blocks = mergedBlocks

	local originalStreets = plan.streets
	local openStreetRuns = {}
	for _, street in ipairs(originalStreets) do
		if street.axis == "segment" then
			for _, square in ipairs(plan.pocketSquares) do
				local interval =
					segmentSquareInterval(street, square, streets.sidewalkWidth, streets.curbWidth)
				if interval then
					table.insert(plan.squareStreetCuts, {
						streetName = street.name,
						squareName = square.name,
						axis = "segment",
						startT = interval[1],
						finishT = interval[2],
					})
				end
			end
			for _, fragment in ipairs(splitSegmentForSquares(street, plan.pocketSquares, streets)) do
				table.insert(openStreetRuns, fragment)
			end
		else
			local gaps = {}
			for _, gap in ipairs(plan.streetGaps) do
				if gap.axis == street.axis and gap.center == street.center then
					table.insert(gaps, gap)
				end
			end
			local profileHalfWidth = street.width / 2 + streets.sidewalkWidth + streets.curbWidth
			for _, square in ipairs(plan.pocketSquares) do
				local transverseCenter = if street.axis == "z"
					then square.centerX
					else square.centerZ
				local transverseHalfSize = if street.axis == "z"
					then square.width / 2
					else square.depth / 2
				if
					math.abs(street.center - transverseCenter) + profileHalfWidth
					<= transverseHalfSize
				then
					local squareCenter = if street.axis == "z"
						then square.centerZ
						else square.centerX
					local squareHalfSize = if street.axis == "z"
						then square.depth / 2
						else square.width / 2
					local cut = {
						start = squareCenter - squareHalfSize,
						finish = squareCenter + squareHalfSize,
					}
					table.insert(gaps, cut)
					table.insert(plan.squareStreetCuts, {
						streetName = street.kind .. "_" .. street.axis .. "_" .. tostring(
							street.center
						),
						squareName = square.name,
						axis = street.axis,
						center = street.center,
						start = cut.start,
						finish = cut.finish,
					})
				end
			end
			table.sort(gaps, function(a, b)
				return a.start < b.start
			end)
			local cursor = street.start
			for _, gap in ipairs(gaps) do
				local gapStart = math.max(street.start, gap.start)
				local gapFinish = math.min(street.finish, gap.finish)
				if gapStart > cursor then
					local run = table.clone(street)
					run.start = cursor
					run.finish = gapStart
					table.insert(openStreetRuns, run)
				end
				cursor = math.max(cursor, gapFinish)
			end
			if cursor < street.finish then
				local run = table.clone(street)
				run.start = cursor
				run.finish = street.finish
				table.insert(openStreetRuns, run)
			end
		end
	end
	plan.streets = openStreetRuns

	-- An unbroken pedestrian spine: north sidewalk, square connection, forecourt, then concourse.
	-- Waypoints are centers of physical walk surfaces, not decorative route annotations.
	local sidewalkX = streets.stationAvenueX + streets.arterialWidth / 2 + streets.sidewalkWidth / 2
	local squareWest = config.square.centerX - config.square.width / 2
	local squareSouth = config.square.centerZ + config.square.depth / 2
	plan.route = {
		{ x = sidewalkX, z = -640, label = "sidewalk spawn" },
		{
			x = sidewalkX,
			z = config.square.centerZ - config.square.depth / 2,
			label = "historic grid sidewalk",
		},
		{
			x = squareWest,
			z = config.square.centerZ - config.square.depth / 2,
			label = "square north-west walk",
		},
		{ x = config.square.centerX, z = config.square.centerZ, label = "public square" },
		{ x = squareWest, z = squareSouth, label = "square south-west walk" },
		{ x = sidewalkX, z = squareSouth, label = "square south sidewalk return" },
		{ x = sidewalkX, z = config.station.forecourtZ, label = "station forecourt" },
		{ x = config.station.centerX, z = config.station.entryZ, label = "station entrance" },
		{ x = config.station.centerX, z = config.station.concourseZ, label = "concourse" },
	}

	local extraTowerParts = 0
	for _, landmark in ipairs(plan.landmarks) do
		if landmark.style == "tower" then
			extraTowerParts += 1
		end
	end
	-- Exact Part count for the current builder recipe, including facade accents and
	-- radius-cut curb segments; diagonal lanes use five Parts each.
	local streetPartCount = 0
	for _, street in ipairs(plan.streets) do
		if street.axis == "segment" then
			streetPartCount += 5
		else
			local curbGaps = {}
			for _, intersection in ipairs(plan.intersections) do
				if
					(street.axis == "z" and intersection.x == street.center)
					or (street.axis == "x" and intersection.z == street.center)
				then
					local coordinate = if street.axis == "z" then intersection.z else intersection.x
					local crossingWidth = if street.axis == "z"
						then intersection.widthZ
						else intersection.widthX
					local halfGap = crossingWidth / 2 + intersection.radius
					table.insert(
						curbGaps,
						{ start = coordinate - halfGap, finish = coordinate + halfGap }
					)
				end
			end
			table.sort(curbGaps, function(a, b)
				return a.start < b.start
			end)
			local cursor = street.start
			local curbPieces = 0
			for _, gap in ipairs(curbGaps) do
				local gapStart = math.clamp(gap.start, street.start, street.finish)
				local gapFinish = math.clamp(gap.finish, street.start, street.finish)
				if gapStart > cursor then
					curbPieces += 1
				end
				cursor = math.max(cursor, gapFinish)
			end
			if cursor < street.finish then
				curbPieces += 1
			end
			streetPartCount += 3 + 2 * curbPieces
		end
	end
	local ordinaryPartCount = 0
	for _, building in ipairs(plan.buildings) do
		local facadeParts = if building.frontage == "shopfront"
			then 4
			elseif building.frontage == "recessed-entry" then 2
			elseif building.frontage == "awning" then 1
			else 0
		ordinaryPartCount += 3 + facadeParts
	end
	local estimatedParts = 1
		+ streetPartCount
		+ ordinaryPartCount
		+ #plan.landmarks * 3
		+ extraTowerParts
		+ 2
		+ #plan.pocketSquares
		+ (8 + 2 * #config.station.rearExitOffsets)
		+ (#plan.route - 1)
		+ 1
	plan.stats = {
		blockCount = #plan.blocks,
		superblockCount = #config.blocks.superblocks,
		pocketSquareCount = #plan.pocketSquares,
		buildingCount = #plan.buildings,
		landmarkCount = #plan.landmarks,
		streetSegmentCount = #plan.streets,
		routeLength = CityGenerator.routeLength(plan.route),
		routeLinkCount = #plan.route - 1,
		estimatedParts = estimatedParts,
		partBudget = config.buildingBudget.partTarget,
	}
	return plan
end

function CityGenerator.routeLength(route: { Point }): number
	local distance = 0
	for index = 2, #route do
		local previous = route[index - 1]
		local current = route[index]
		local dx = current.x - previous.x
		local dz = current.z - previous.z
		distance += math.sqrt(dx * dx + dz * dz)
	end
	return distance
end

return CityGenerator
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="22">
          <Properties>
            <string name="Name">WorldBootstrap</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[--!strict
-- Server bootstraps one deterministic world build; no Studio placement or ticking is required.
local Workspace = game:GetService("Workspace")
local config = require(script.Parent.CityConfig)
local generator = require(script.Parent.CityGenerator)
local builder = require(script.Parent.CityBuilder)

-- Workspace streaming properties are NotScriptable in Roblox's current API. They are
-- authored in default.project.json; the district model carries explicit stream-in bounds.

local plan = generator.generate(config)
local world = builder.build(plan, config, Workspace)
world:SetAttribute("StreamingBoundaryPadding", config.streaming.districtEdgePadding)
world:SetAttribute("WalkRouteStuds", plan.stats.routeLength)
world:SetAttribute("GeneratedPartEstimate", plan.stats.estimatedParts)
local generatedPartCount = world:GetAttribute("GeneratedPartCount")
if typeof(generatedPartCount) ~= "number" then
	error("CityBuilder did not report a numeric generated-part count")
end
print(
	string.format(
		"Civitas World: %d buildings, %d landmarks, %.0f-stud acceptance route, %d parts",
		plan.stats.buildingCount,
		plan.stats.landmarkCount,
		plan.stats.routeLength,
		generatedPartCount
	)
)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="26">
          <Properties>
            <string name="Name">Input</string>
          </Properties>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Bindings</string>
              <string name="Source"><![CDATA[--!strict
--[[
	The control table: which physical input, and which on-screen control, triggers each action in
	each context. Pure data. Key names are Enum.KeyCode member names as strings, so this file has no
	Roblox dependency; tools/check_enums.py verifies every name against the Roblox API dump, so a
	typo cannot ship silently.

	Contexts are separate because the same key means different things on foot and in the cab
	(Escape is "pause" on foot and "back" in menus). Conflicts are only checked inside a context.

	Safety rules that tests enforce (tests/client/bindings.spec.luau):
	- Every cab action that matters while moving has a binding on keyboard, gamepad and touch.
	- The emergency brake is never on Space or Enter, which are reached by accident.
]]

local Bindings = {}

export type Touch = { id: string, label: string }
export type Action = {
	keyboard: { string },
	gamepad: { string },
	touch: Touch?,
}
export type Context = { [string]: Action }

Bindings.contexts = {
	cab = {
		throttleUp = {
			keyboard = { "W" },
			gamepad = { "ButtonR2" },
			touch = { id = "throttleSlider", label = "Throttle" },
		},
		brakeService = {
			keyboard = { "S" },
			gamepad = { "ButtonL2" },
			touch = { id = "brakeSlider", label = "Brake" },
		},
		brakeEmergency = {
			keyboard = { "Backspace" },
			gamepad = { "ButtonB" },
			touch = { id = "emergencyBrake", label = "Emergency" },
		},
		reverserUp = {
			keyboard = { "Q" },
			gamepad = { "DPadUp" },
			touch = { id = "reverserUp", label = "Reverser" },
		},
		reverserDown = {
			keyboard = { "Z" },
			gamepad = { "DPadDown" },
			touch = { id = "reverserDown", label = "Reverser" },
		},
		horn = {
			keyboard = { "H" },
			gamepad = { "ButtonL3" },
			touch = { id = "horn", label = "Horn" },
		},
		doors = {
			keyboard = { "C" },
			gamepad = { "ButtonL1" },
			touch = { id = "doors", label = "Doors" },
		},
		map = {
			keyboard = { "M" },
			gamepad = { "ButtonSelect" },
			touch = { id = "map", label = "Map" },
		},
		pause = {
			keyboard = { "Escape" },
			gamepad = { "ButtonStart" },
			touch = { id = "menu", label = "Menu" },
		},
	} :: Context,
	onFoot = {
		interact = {
			keyboard = { "E" },
			gamepad = { "ButtonX" },
			touch = { id = "interact", label = "Interact" },
		},
		map = {
			keyboard = { "M" },
			gamepad = { "ButtonSelect" },
			touch = { id = "map", label = "Map" },
		},
		pause = {
			keyboard = { "Escape" },
			gamepad = { "ButtonStart" },
			touch = { id = "menu", label = "Menu" },
		},
	} :: Context,
	menu = {
		select = {
			keyboard = { "Return" },
			gamepad = { "ButtonA" },
			touch = { id = "tap", label = "Select" },
		},
		back = {
			keyboard = { "Escape" },
			gamepad = { "ButtonB" },
			touch = { id = "back", label = "Back" },
		},
		tabPrevious = {
			keyboard = { "LeftBracket" },
			gamepad = { "ButtonL1" },
			touch = nil,
		},
		tabNext = {
			keyboard = { "RightBracket" },
			gamepad = { "ButtonR1" },
			touch = nil,
		},
	} :: Context,
}

-- Short glyph text for prompts. Gamepad names are printed as the labels on the controller, so a
-- player reads "A" and sees the same button.
Bindings.glyphs = {
	ButtonA = "A",
	ButtonB = "B",
	ButtonX = "X",
	ButtonY = "Y",
	ButtonL1 = "LB",
	ButtonR1 = "RB",
	ButtonL2 = "LT",
	ButtonR2 = "RT",
	ButtonL3 = "LS",
	ButtonR3 = "RS",
	ButtonStart = "Menu",
	ButtonSelect = "View",
	DPadUp = "D-Up",
	DPadDown = "D-Down",
	Escape = "Esc",
	Backspace = "Backspace",
	Return = "Enter",
	LeftBracket = "[",
	RightBracket = "]",
} :: { [string]: string }

return Bindings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">InputMode</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Which input family the UI should speak: keyboard, gamepad or touch. Pure, and dependency-free:
	the binding and glyph tables are passed in, because Roblox resolves requires through
	`script.Parent`, which lune cannot follow (see Layout.luau for the same rule).

	The rule comes from Roblox's own guidance: UserInputService.PreferredInput follows the player's
	most recent interaction, so a phone with a Bluetooth gamepad reports Gamepad, and a tablet with
	a keyboard reports KeyboardAndMouse. Checking TouchEnabled alone would show touch prompts to a
	player who is holding a controller.
]]

local InputMode = {}

export type Mode = "keyboard" | "gamepad" | "touch"

-- Shape of one entry in Bindings.contexts. Declared again here rather than imported, for the reason
-- above; tests/client/bindings.spec.luau checks that the two stay compatible.
export type Binding = {
	keyboard: { string },
	gamepad: { string },
	touch: { id: string, label: string }?,
}

-- `preferred` is the name of a PreferredInput member. `hasTouch` only matters when the value is
-- unknown: a touch-capable device then falls back to touch, anything else to keyboard.
function InputMode.fromPreferred(preferred: string, hasTouch: boolean): Mode
	if preferred == "Touch" then
		return "touch"
	elseif preferred == "Gamepad" or preferred == "MicroGamepad" then
		return "gamepad"
	elseif preferred == "KeyboardAndMouse" then
		return "keyboard"
	end
	return if hasTouch then "touch" else "keyboard"
end

-- The text a player should read for a binding, e.g. "E", "RT" or "Brake". Returns nil when the
-- binding has nothing for this mode, so a missing prompt shows up in tests rather than as an empty
-- label on screen.
function InputMode.promptFor(mode: Mode, binding: Binding, glyphs: { [string]: string }): string?
	if mode == "touch" then
		local touch = binding.touch
		return if touch then touch.label else nil
	end
	local keys = if mode == "gamepad" then binding.gamepad else binding.keyboard
	local first = keys[1]
	if first == nil then
		return nil
	end
	return glyphs[first] or first
end

return InputMode
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="Folder" referent="30">
            <Properties>
              <string name="Name">Components</string>
            </Properties>
            <Item class="ModuleScript" referent="31">
              <Properties>
                <string name="Name">Button</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Button: the only interactive control style. Flat fill, 1 px edge, 4 px corners, no default
	Roblox look (AutoButtonColor is off, and the press state comes from Theme).

	Behaviour the spec depends on:
	- Never smaller than the touch minimum (Layout.touchSize), whatever width is requested.
	- Selectable, with a visible focus ring, so gamepad navigation has somewhere to stand.
	- Disabled buttons are inactive and skipped by focus, rather than hidden. Hidden controls
	  confuse players who are looking for them.
	- Pressed feedback is a short client-side tween. It is never replicated.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Layout = require(script.Parent.Parent.Layout)
local Label = require(script.Parent.Label)

local Button = {}

export type Variant = "primary" | "secondary" | "danger"
export type Options = {
	text: string,
	variant: Variant?,
	width: number?,
	height: number?,
	onActivated: () -> (),
}

type Look = { fill: Style.ColorName, label: Style.ColorName, edge: Style.ColorName }

local LOOKS: { [Variant]: Look } = {
	primary = { fill = "accent", label = "ink", edge = "accent" },
	secondary = { fill = "raised", label = "text", edge = "hairline" },
	danger = { fill = "stop", label = "ink", edge = "stop" },
}

local DEFAULT_WIDTH = 160

function Button.new(options: Options): TextButton
	local variant: Variant = options.variant or "secondary"
	local look = LOOKS[variant]
	Label.checkText(options.text, "label")
	local width, height = Layout.touchSize(
		options.width or DEFAULT_WIDTH,
		options.height or Theme.size.touchComfort,
		Theme.size.touchMin
	)

	local button = Instance.new("TextButton")
	button.Name = `Button_{options.text}`
	button.Text = string.upper(options.text)
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Selectable = true
	button.Size = UDim2.fromOffset(width, height)
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.BackgroundColor3 = Style.color(look.fill)
	button.TextColor3 = Style.color(look.label)
	Style.applyType(button, "label")

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Theme.radius.control)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Style.color(look.edge)
	stroke.Thickness = Theme.size.hairline
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = button

	local restFill = Style.color(look.fill)
	local pressedFill = restFill:Lerp(Style.color("ink"), 0.2)
	local info =
		TweenInfo.new(Style.duration("fast"), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local function fadeTo(color: Color3)
		TweenService:Create(button, info, { BackgroundColor3 = color }):Play()
	end

	button.MouseButton1Down:Connect(function()
		if button.Active then
			fadeTo(pressedFill)
		end
	end)
	button.MouseButton1Up:Connect(function()
		fadeTo(restFill)
	end)
	button.MouseLeave:Connect(function()
		fadeTo(restFill)
	end)

	button.SelectionGained:Connect(function()
		stroke.Thickness = Theme.size.focusRing
		stroke.Color = Style.color("accent")
	end)
	button.SelectionLost:Connect(function()
		stroke.Thickness = Theme.size.hairline
		stroke.Color = Style.color(look.edge)
	end)

	button.Activated:Connect(function()
		if button.Active then
			options.onActivated()
		end
	end)

	return button
end

-- Enables or disables a button without hiding it. Disabled buttons drop out of gamepad focus.
function Button.setEnabled(button: TextButton, enabled: boolean)
	button.Active = enabled
	button.Selectable = enabled
	button.TextTransparency = if enabled then 0 else 0.5
	button.BackgroundTransparency = if enabled then 0 else 0.3
end

return Button
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="32">
              <Properties>
                <string name="Name">Divider</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Divider: a 1 px hairline between groups. Decorative only; it never carries meaning on its own.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)

local Divider = {}

export type Options = {
	name: string?,
	vertical: boolean?,
}

function Divider.new(options: Options?): Frame
	local vertical = if options then options.vertical == true else false
	local frame = Instance.new("Frame")
	frame.Name = if options and options.name then options.name else "Divider"
	frame.BackgroundColor3 = Style.color("hairline")
	frame.BorderSizePixel = 0
	if vertical then
		frame.Size = UDim2.new(0, Theme.size.hairline, 1, 0)
	else
		frame.Size = UDim2.new(1, 0, 0, Theme.size.hairline)
	end
	return frame
end

return Divider
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="33">
              <Properties>
                <string name="Name">Field</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Field: a labelled text input. The caption is a label token above a raised well; the typed text
	is body type. An error is shown as the word "Error:" plus the message, in the stop colour, so a
	player who cannot see colour still reads it.

	Touch: the well is the comfortable touch size (56 px), so the input is easy to tap on a phone.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Label = require(script.Parent.Label)
local Panel = require(script.Parent.Panel)

local Field = {}

export type Options = {
	name: string?,
	label: string,
	placeholder: string?,
	text: string?,
}

export type FieldView = {
	root: Frame,
	input: TextBox,
	error: TextLabel,
}

function Field.new(options: Options): FieldView
	-- The caption and the placeholder are shown, so both pass the same coverage check as any label.
	Label.checkText(options.label, "label")
	if options.placeholder then
		Label.checkText(options.placeholder, "body")
	end

	local root = Instance.new("Frame")
	root.Name = if options.name then options.name else "Field"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 0)
	root.AutomaticSize = Enum.AutomaticSize.Y

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.space.s2)
	layout.Parent = root

	local caption =
		Label.new({ name = "Caption", text = options.label, type = "label", color = "textMuted" })
	caption.LayoutOrder = 1
	caption.AutomaticSize = Enum.AutomaticSize.Y
	caption.Size = UDim2.fromScale(1, 0)
	caption.Parent = root

	local well = Panel.new({ name = "Well", elevation = "raised" })
	well.LayoutOrder = 2
	well.Size = UDim2.new(1, 0, 0, Theme.size.touchComfort)
	well.Parent = root

	local input = Instance.new("TextBox")
	input.Name = "Input"
	input.BackgroundTransparency = 1
	input.BorderSizePixel = 0
	input.Size = UDim2.fromScale(1, 1)
	input.ClearTextOnFocus = false
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.TextColor3 = Style.color("text")
	input.PlaceholderColor3 = Style.color("textFaint")
	input.PlaceholderText = options.placeholder or ""
	input.Text = options.text or ""
	Style.applyType(input, "body")

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, Theme.space.s3)
	padding.PaddingRight = UDim.new(0, Theme.space.s3)
	padding.Parent = well
	input.Parent = well

	local errorLabel = Label.new({ name = "Error", text = " ", type = "caption", color = "stop" })
	errorLabel.LayoutOrder = 3
	errorLabel.AutomaticSize = Enum.AutomaticSize.Y
	errorLabel.Size = UDim2.fromScale(1, 0)
	errorLabel.Visible = false
	errorLabel.Parent = root

	return { root = root, input = input, error = errorLabel }
end

-- Shows the error with its word, or clears it when `message` is nil.
function Field.setError(view: FieldView, message: string?)
	if message == nil then
		view.error.Visible = false
		return
	end
	local text = `Error: {message}`
	Label.setText(view.error, text, "caption")
	view.error.Visible = true
end

return Field
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="34">
              <Properties>
                <string name="Name">Label</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Label: text in a type token and a colour token. Transparent, wraps, never default-styled.

	Every string is checked against the coverage of its face before it reaches the screen
	(UI/Text.luau). A character the font is not declared to cover fails here, with its name, in the
	build, not as a box on a player's screen. Label.checkText is the one place that rule lives;
	other components call it too.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Text = require(script.Parent.Parent.Text)
local FontCoverage = require(script.Parent.Parent.FontCoverage)

local Label = {}

export type Options = {
	name: string?,
	text: string,
	type: Style.TypeName?,
	color: Style.ColorName?,
	align: ("left" | "center" | "right")?,
}

-- Errors if `text` uses a character the face of `typeName` is not declared to cover.
function Label.checkText(text: string, typeName: Style.TypeName)
	Text.assertCovered("Text", text, FontCoverage.forFace(Theme.type[typeName].face))
end

local ALIGN: { [string]: Enum.TextXAlignment } = {
	left = Enum.TextXAlignment.Left,
	center = Enum.TextXAlignment.Center,
	right = Enum.TextXAlignment.Right,
}

function Label.new(options: Options): TextLabel
	local typeName: Style.TypeName = options.type or "body"
	Label.checkText(options.text, typeName)

	local label = Instance.new("TextLabel")
	label.Name = options.name or "Label"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.TextWrapped = true
	label.TextXAlignment = ALIGN[options.align or "left"]
	label.TextColor3 = Style.color(options.color or "text")
	label.Text = options.text
	Style.applyType(label, typeName)
	return label
end

-- Changing the text of an existing label goes through the same check.
function Label.setText(label: TextLabel, text: string, typeName: Style.TypeName)
	Label.checkText(text, typeName)
	label.Text = text
end

return Label
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="35">
              <Properties>
                <string name="Name">Meter</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Meter: a row of notches for throttle, brake and similar notched controls. Lit notches show the
	level; the numeric readout beside it carries the exact value. Colour is never the only
	signal: a lit notch is also a filled block, and the caller prints the number.

	The fill rule lives in Gauge.luau (pure, tested). This file only draws it.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Gauge = require(script.Parent.Parent.Gauge)

local Meter = {}

export type Tone = "proceed" | "caution" | "stop" | "accent"
export type Meter = {
	frame: Frame,
	segments: { Frame },
	notches: number,
}

-- Creates `notches` blocks laid out left to right. Each block is a separate Frame, so the meter
-- costs `notches` draw calls; keep notch counts small (the cab uses 8).
function Meter.new(notches: number, width: number, height: number): Meter
	assert(notches >= 1, "a meter needs at least one notch")
	local frame = Instance.new("Frame")
	frame.Name = "Meter"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(width, height)

	local gap = Theme.space.s1
	local blockW = (width - (notches - 1) * gap) / notches
	local segments: { Frame } = {}
	for i = 1, notches do
		local block = Instance.new("Frame")
		block.Name = `Notch{i}`
		block.BorderSizePixel = 0
		block.BackgroundColor3 = Style.color("pressed")
		block.Position = UDim2.fromOffset((i - 1) * (blockW + gap), 0)
		block.Size = UDim2.fromOffset(blockW, height)
		block.Parent = frame
		table.insert(segments, block)
	end
	return { frame = frame, segments = segments, notches = notches }
end

-- Lights the blocks up to the notch nearest to `value`, in the given tone.
function Meter.set(meter: Meter, value: number, minV: number, maxV: number, tone: Tone)
	local level = Gauge.notch(Gauge.fraction(value, minV, maxV), meter.notches)
	local lit = Style.color(tone)
	for i, block in meter.segments do
		block.BackgroundColor3 = if i <= level then lit else Style.color("pressed")
	end
end

return Meter
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="36">
              <Properties>
                <string name="Name">Panel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Panel: a surface container. Raised fill, 6 px corners and a 1 px hairline edge. Panels carry no
	behaviour; they only group controls and text. Depth comes from the fill step between surface
	and raised, not from drop shadows, which cost fill-rate on low-end phones.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)

local Panel = {}

export type Options = {
	name: string?,
	elevation: Style.Elevation?,
}

function Panel.new(options: Options?): Frame
	local frame = Instance.new("Frame")
	frame.Name = if options and options.name then options.name else "Panel"
	frame.BorderSizePixel = 0
	local level: Style.Elevation = if options and options.elevation
		then options.elevation
		else "flat"
	frame.BackgroundColor3 = Style.elevation(level)

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Theme.radius.panel)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Style.color("hairline")
	stroke.Thickness = Theme.size.hairline
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame

	return frame
end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="37">
              <Properties>
                <string name="Name">SignText</string>
                <string name="Source"><![CDATA[--!strict
--[[
	SignText: a station or destination sign. Warm white on a dark enamel-blue plate, upper case,
	condensed type, 2 px corners. It is the only place the game uses a plate look, so a platform
	sign and a departure board read as the same family of signage.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Label = require(script.Parent.Label)

local SignText = {}

export type Options = {
	text: string,
	large: boolean?,
	width: number?,
	height: number?,
	align: ("left" | "center")?,
}

function SignText.new(options: Options): TextLabel
	Label.checkText(options.text, if options.large then "signLarge" else "sign")
	local label = Instance.new("TextLabel")
	label.Name = `Sign_{options.text}`
	label.Text = string.upper(options.text)
	label.BorderSizePixel = 0
	label.BackgroundColor3 = Style.color("sign")
	label.TextColor3 = Style.color("signText")
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.TextXAlignment = if options.align == "left"
		then Enum.TextXAlignment.Left
		else Enum.TextXAlignment.Center
	label.Size = UDim2.fromOffset(options.width or 240, options.height or 48)
	Style.applyType(label, if options.large then "signLarge" else "sign")

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Theme.radius.sign)
	corner.Parent = label

	return label
end

return SignText
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="38">
              <Properties>
                <string name="Name">StatusDot</string>
                <string name="Source"><![CDATA[--!strict
--[[
	StatusDot: a status shown as a dot, its colour, and a required word. The word is mandatory
	on purpose. A dot on its own is colour-only signalling, which UI-SPEC §4 forbids: a player who
	cannot tell the colours apart would see nothing.

	Tones are tokens. `neutral` uses textMuted, not a status colour, so an idle state never looks
	like a warning.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Label = require(script.Parent.Label)

local StatusDot = {}

export type Tone = "proceed" | "caution" | "stop" | "neutral"

export type Options = {
	name: string?,
	tone: Tone,
	text: string,
}

local TONE: { [Tone]: Style.ColorName } = {
	proceed = "proceed",
	caution = "caution",
	stop = "stop",
	neutral = "textMuted",
}

function StatusDot.new(options: Options): Frame
	if options.text == "" then
		error("StatusDot needs a word: a dot without text is colour-only signalling (UI-SPEC §4)")
	end

	local row = Instance.new("Frame")
	row.Name = if options.name then options.name else "StatusDot"
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, Theme.size.touchMin)

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, Theme.space.s2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row

	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.LayoutOrder = 1
	dot.BorderSizePixel = 0
	dot.Size = UDim2.fromOffset(Theme.size.dot, Theme.size.dot)
	dot.BackgroundColor3 = Style.color(TONE[options.tone])
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.5, 0)
	round.Parent = dot
	dot.Parent = row

	local word = Label.new({ name = "Word", text = options.text, type = "label", color = "text" })
	word.LayoutOrder = 2
	word.Size = UDim2.new(1, -(Theme.size.dot + Theme.space.s2), 1, 0)
	word.Parent = row

	return row
end

return StatusDot
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="39">
              <Properties>
                <string name="Name">Toggle</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Toggle: an on/off control shown as a full-width button. The state is written in the label, so
	"Reduce motion: On" is readable without colour. On uses the accent fill with ink text; off
	stays on a raised fill with light text. Both pairs meet the text rule (tests/client/theme.spec).

	The control only renders state. The caller owns the value and calls Toggle.render after it
	changes, so the server or a settings store stays the single source of truth.
]]

local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)
local Label = require(script.Parent.Label)

local Toggle = {}

export type Options = {
	name: string?,
	label: string,
	value: boolean,
}

-- Writes "<label>: On" or "<label>: Off" into the button and sets its fill to match.
function Toggle.render(button: TextButton, label: string, value: boolean)
	local word = if value then "On" else "Off"
	local text = `{label}: {word}`
	Label.checkText(text, "label")
	button.Text = text
	if value then
		button.BackgroundColor3 = Style.color("accent")
		button.TextColor3 = Style.color("ink")
	else
		button.BackgroundColor3 = Style.color("raised")
		button.TextColor3 = Style.color("text")
	end
end

function Toggle.new(options: Options): TextButton
	Label.checkText(options.label, "label")

	local button = Instance.new("TextButton")
	button.Name = if options.name then options.name else "Toggle"
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, Theme.size.touchComfort)
	button.TextXAlignment = Enum.TextXAlignment.Left
	Style.applyType(button, "label")

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Theme.radius.control)
	corner.Parent = button

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, Theme.space.s4)
	padding.Parent = button

	Toggle.render(button, options.label, options.value)
	return button
end

return Toggle
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">FontCoverage</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Declared glyph coverage for each font face the UI uses. Read by UI/Text.luau.

	STATUS: CLAIMED, NOT MEASURED. Roblox documents the Font enum names but publishes no glyph
	coverage for BuilderSans or Roboto, and nothing in the sandbox can render them. So the claim
	below is the conservative set every modern European UI font is expected to cover: Basic Latin
	and Latin-1 Supplement, which carries ä ö ü ß é è à ç ñ ø å æ. Anything beyond it, such as
	Ł, ő, ş or ą, fails the guard until it is added.

	To extend a face: render the new characters in Studio on a TextLabel with that face, confirm
	no box appears, then add the range to `extra` with a comment saying when and by whom it was
	checked. Nothing is added speculatively.
]]

local FontCoverage = {}

export type Range = { lo: number, hi: number }

-- Basic Latin (space to tilde) and Latin-1 Supplement (no-break space to ÿ).
local CLAIMED: { Range } = {
	{ lo = 0x20, hi = 0x7E },
	{ lo = 0xA0, hi = 0xFF },
}

-- Added after a Studio check. Empty until one is made.
local extra: { [string]: { Range } } = {}

-- Ranges for a face name as used in Theme.type (for example "BuilderSans"). Unknown faces get the
-- claimed set only, so a new face cannot silently gain coverage.
function FontCoverage.forFace(face: string): { Range }
	local ranges: { Range } = table.clone(CLAIMED)
	local added: { Range } = extra[face] or {}
	for _, range in added do
		table.insert(ranges, range)
	end
	return ranges
end

FontCoverage.claimed = CLAIMED

return FontCoverage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Format</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Display formatting rules for departure boards, the cab and timetables. Pure, so the rules are
	tested: a delay of 61 seconds must read "+1 min", not "+0 min" or "On time".

	Clock values are seconds since local midnight of the service day, as the server sends them.
	Civitas uses a 24-hour clock, the convention on European railway signage.
]]

local Format = {}

export type DelayTone = "onTime" | "early" | "late" | "severelyLate" | "unknown"

local DAY_S = 86400
-- Services within ±60 s of the timetable count as on time. This matches the tolerance most
-- European operators publish, and it stops the board flickering between "On time" and "+1 min".
local ON_TIME_TOLERANCE_S = 60
-- Beyond five minutes a delay stops being a timing note and becomes a service disruption.
local SEVERE_DELAY_S = 300

local function isFinite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

-- "HH:MM" for a seconds value. Wraps past midnight, so 90 000 s reads "01:00".
function Format.clock(seconds: number): string
	if not isFinite(seconds) then
		return "--:--"
	end
	local s = math.floor(seconds) % DAY_S
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	return string.format("%02d:%02d", h, m)
end

-- Delay text and its tone. Negative values are early running.
function Format.delay(deltaS: number): (string, DelayTone)
	if not isFinite(deltaS) then
		return "--", "unknown"
	end
	if math.abs(deltaS) <= ON_TIME_TOLERANCE_S then
		return "On time", "onTime"
	end
	local minutes = math.floor(math.abs(deltaS) / 60 + 0.5)
	if deltaS < 0 then
		return `{minutes} min early`, "early"
	end
	if deltaS > SEVERE_DELAY_S then
		return `+{minutes} min`, "severelyLate"
	end
	return `+{minutes} min`, "late"
end

-- Speed as a whole number in the requested unit. Speed is sent in metres per second (SI); only
-- the view converts. A negative input is treated as magnitude, since the reverser sets direction.
function Format.speedText(mps: number, unit: "kmh" | "mph"): string
	if not isFinite(mps) then
		return "---"
	end
	local magnitude = math.abs(mps)
	local value = if unit == "kmh" then magnitude * 3.6 else magnitude * 2.236936
	return tostring(math.floor(value + 0.5))
end

-- Journey or dwell duration as "m:ss". Negative input is clamped to zero.
function Format.duration(seconds: number): string
	if not isFinite(seconds) then
		return "--:--"
	end
	local total = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", math.floor(total / 60), total % 60)
end

return Format
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Gauge</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Value-to-fill rules for meters: the throttle and brake notches, the speed bar and the reverser.
	Pure. The Roblox meter component only draws what these functions return.

	Throttle and brake are notched controls in real cabs, so the notch function rounds to the
	nearest notch rather than showing a fraction the driver cannot set.
]]

local Gauge = {}

local function isFinite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

-- Position of `value` between `minV` and `maxV` as 0..1. Out-of-range input is clamped; NaN and
-- a degenerate range read as zero, so an empty meter is shown rather than a broken one.
function Gauge.fraction(value: number, minV: number, maxV: number): number
	if not isFinite(value) or not isFinite(minV) or not isFinite(maxV) or maxV <= minV then
		return 0
	end
	return math.clamp((value - minV) / (maxV - minV), 0, 1)
end

-- Nearest notch in 0..notches for a 0..1 fraction. Notches must be at least 1.
function Gauge.notch(fraction: number, notches: number): number
	assert(notches >= 1 and math.floor(notches) == notches, "notches must be a whole number >= 1")
	if not isFinite(fraction) then
		return 0
	end
	return math.clamp(math.floor(fraction * notches + 0.5), 0, notches)
end

return Gauge
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="43">
            <Properties>
              <string name="Name">Hud</string>
            </Properties>
            <Item class="ModuleScript" referent="44">
              <Properties>
                <string name="Name">Compass</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Compass strip maths. Pure: numbers in, numbers out, no requires, so lune tests every rule.

	The strip shows a window of headings centred on the player's heading. A bearing (north is 0,
	clockwise positive, as in a real compass) maps to a horizontal pixel offset from the strip's
	centre, or nil when it is outside the visible window. The window wraps at 360 degrees, so a
	heading of 350 still shows a bearing of 10 just to its right.
]]

local Compass = {}

-- Normalises an angle to [-180, 180). Lua's % is floored, so this is correct for negative input.
function Compass.wrap(degrees: number): number
	return (degrees + 180) % 360 - 180
end

-- Horizontal offset in pixels from the strip centre, or nil if the bearing is outside the window.
-- `span` is the number of degrees the strip shows across its full width.
function Compass.offsetX(heading: number, bearing: number, width: number, span: number): number?
	assert(width > 0 and span > 0, "compass needs a positive width and span")
	local relative = Compass.wrap(bearing - heading)
	local half = span / 2
	if math.abs(relative) > half then
		return nil
	end
	return relative / half * (width / 2)
end

-- Cardinal and intercardinal marks. Shown as letters; minor ticks are drawn every 15 degrees.
Compass.cardinals = {
	{ bearing = 0, text = "N" },
	{ bearing = 90, text = "E" },
	{ bearing = 180, text = "S" },
	{ bearing = 270, text = "W" },
}

return Compass
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="45">
              <Properties>
                <string name="Name">CompassView</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Compass strip: a horizontal band across the top of the screen showing the headings near the
	player's heading. Positions come from Compass.offsetX with a width of 1, so each mark is placed as
	a fraction of the strip, and the strip works at any screen size. The heading is an input from the
	caller (the camera), not something this module reads.
]]

local Compass = require(script.Parent.Compass)
local Style = require(script.Parent.Parent.Style)
local Theme = require(script.Parent.Parent.Theme)
local Panel = require(script.Parent.Parent.Components.Panel)
local Label = require(script.Parent.Parent.Components.Label)

local CompassView = {}

export type View = {
	root: Frame,
	setHeading: (degrees: number) -> (),
	destroy: () -> (),
}

-- How many degrees the strip shows across its whole width.
local SPAN = 90
local TICK_EVERY = 15

-- One mark is a label or a tick, at a fixed bearing. Marks outside the window are hidden.
type Mark = { bearing: number, gui: GuiObject }

function CompassView.new(parent: GuiObject): View
	local root = Panel.new({ name = "Compass", elevation = "raised" })
	root.AnchorPoint = Vector2.new(0.5, 0)
	root.Position = UDim2.new(0.5, 0, 0, Theme.space.s4)
	root.Size = UDim2.new(0.6, 0, 0, Theme.size.dot * 2 + Theme.space.s3)
	root.Parent = parent

	local marks: { Mark } = {}
	-- A parameter, not a table field: Luau checks table fields exactly, which rejects a TextLabel as a GuiObject.
	local function addMark(bearing: number, gui: GuiObject)
		table.insert(marks, { bearing = bearing, gui = gui })
	end
	for _, cardinal in Compass.cardinals do
		local label = Label.new({
			name = `Cardinal{cardinal.text}`,
			text = cardinal.text,
			type = "label",
			color = "text",
			align = "center",
		})
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.5)
		label.Parent = root
		addMark(cardinal.bearing, label)
	end
	for bearing = 0, 359, TICK_EVERY do
		local isCardinal = bearing % 90 == 0
		if not isCardinal then
			local tick = Instance.new("Frame")
			tick.Name = `Tick{bearing}`
			tick.AnchorPoint = Vector2.new(0.5, 1)
			tick.Position = UDim2.fromScale(0.5, 1)
			tick.Size = UDim2.fromOffset(1, Theme.space.s2)
			tick.BackgroundColor3 = Style.color("textMuted")
			tick.BorderSizePixel = 0
			tick.Parent = root
			addMark(bearing, tick)
		end
	end

	local function setHeading(degrees: number)
		for _, mark in marks do
			local x = Compass.offsetX(degrees, mark.bearing, 1, SPAN)
			if x == nil then
				mark.gui.Visible = false
			else
				mark.gui.Visible = true
				mark.gui.Position = UDim2.fromScale(0.5 + x, mark.gui.Position.Y.Scale)
			end
		end
	end

	setHeading(0)

	return {
		root = root,
		setHeading = setHeading,
		destroy = function()
			root:Destroy()
		end,
	}
end

return CompassView
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="46">
              <Properties>
                <string name="Name">NamePlate</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Name plate: a short raised label at a screen position the caller computed. It serves stations
	and people. The caller projects a world position onto the screen. This module never reads a
	Workspace instance, so a plate for something that streams out is destroyed, not left pointing
	at nothing.
]]

local Theme = require(script.Parent.Parent.Theme)
local Panel = require(script.Parent.Parent.Components.Panel)
local Label = require(script.Parent.Parent.Components.Label)

local NamePlate = {}

export type Plate = {
	frame: Frame,
	setText: (text: string) -> (),
	moveTo: (x: number, y: number) -> (),
	destroy: () -> (),
}

-- `x` and `y` are the bottom-centre of the plate in pixels from the parent's top left, so a plate
-- sits above the point it names (the bottom edge is the anchor).
function NamePlate.new(parent: GuiObject, text: string): Plate
	local frame = Panel.new({ name = "NamePlate", elevation = "raised" })
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.AutomaticSize = Enum.AutomaticSize.XY
	frame.Parent = parent

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, Theme.space.s3)
	padding.PaddingRight = UDim.new(0, Theme.space.s3)
	padding.PaddingTop = UDim.new(0, Theme.space.s1)
	padding.PaddingBottom = UDim.new(0, Theme.space.s1)
	padding.Parent = frame

	local label = Label.new({
		name = "PlateText",
		text = text,
		type = "label",
		color = "text",
		align = "center",
	})
	label.AutomaticSize = Enum.AutomaticSize.XY
	label.Parent = frame

	local function setText(newText: string)
		Label.setText(label, newText, "label")
	end

	local function moveTo(x: number, y: number)
		frame.Position = UDim2.fromOffset(x, y)
	end

	return {
		frame = frame,
		setText = setText,
		moveTo = moveTo,
		destroy = function()
			frame:Destroy()
		end,
	}
end

return NamePlate
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="47">
              <Properties>
                <string name="Name">WalkHud</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Walk-mode HUD: the screen-space frame around the player on foot. Everything here is built from
	Theme through Style and the components in UI/Components. No default Roblox look.

	What it shows: a district sign at the top left (when the caller has a district name), an
	interaction prompt above the thumb zones (when there is something to act on), and, on touch, the
	movement pad and action buttons placed by Layout.touchControls.

	What it does not do: move anybody. Movement and actions leave through callbacks, and the walk
	controller (WALK · pave) decides what they mean. The HUD reads no Workspace instance, so it works
	while the city streams in and out. It takes the safe area from its ScreenGui's AbsoluteSize, which
	relies on ScreenInsets = DeviceSafeInsets shrinking that size; that is unverified without Studio.
]]

local UserInputService = game:GetService("UserInputService")

local Layout = require(script.Parent.Parent.Layout)
local Style = require(script.Parent.Parent.Style)
local Theme = require(script.Parent.Parent.Theme)
local Panel = require(script.Parent.Parent.Components.Panel)
local Label = require(script.Parent.Parent.Components.Label)
local Button = require(script.Parent.Parent.Components.Button)
local SignText = require(script.Parent.Parent.Components.SignText)
local CompassView = require(script.Parent.CompassView)
local NamePlate = require(script.Parent.NamePlate)

local WalkHud = {}

export type Action = { id: string, label: string, variant: Button.Variant? }
export type Options = {
	district: string?, -- top-left sign; nil hides it
	prompt: string?, -- interaction prompt; nil hides it
	actions: { Action }, -- right thumb, row by row; at most 6
	touch: boolean, -- true lays out touch controls; false leaves keyboard and gamepad alone
	compass: boolean, -- true shows the compass strip; the caller then calls setHeading
	onMove: (x: number, y: number) -> (),
	onAction: (id: string) -> (),
}

export type View = {
	root: ScreenGui,
	setPrompt: (text: string?) -> (),
	setDistrict: (text: string?) -> (),
	setHeading: (degrees: number) -> (),
	showPlate: (text: string) -> NamePlate.Plate,
	destroy: () -> (),
}

-- Gap between touch controls and from the zone edges. Theme owns the number; the layout maths
-- takes it as an argument so it stays testable.
local TOUCH_GAP = Theme.space.s2
local MAX_ACTIONS = 6

function WalkHud.new(root: ScreenGui, options: Options): View
	assert(
		#options.actions <= MAX_ACTIONS,
		`walk HUD supports {MAX_ACTIONS} actions, got {#options.actions}`
	)
	root.ResetOnSpawn = false
	root.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets

	local frame = Instance.new("Frame")
	frame.Name = "WalkHud"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = root

	local connections: { RBXScriptConnection } = {}
	local districtSign: TextLabel? = nil
	local prompt: TextLabel? = nil
	local controls: { GuiObject } = {}
	local compass: CompassView.View? = nil
	local plates: { NamePlate.Plate } = {}

	local function setDistrict(text: string?)
		if districtSign then
			districtSign:Destroy()
			districtSign = nil
		end
		if text == nil then
			return
		end
		local sign = SignText.new({ text = text, large = false, align = "left" })
		sign.Name = "District"
		sign.Position = UDim2.fromOffset(Theme.space.s4, Theme.space.s4)
		sign.Parent = frame
		districtSign = sign
	end

	local function setPrompt(text: string?)
		if prompt then
			prompt:Destroy()
			prompt = nil
		end
		if text == nil then
			return
		end
		local label = Label.new({
			name = "Prompt",
			text = text,
			type = "label",
			color = "text",
			align = "center",
		})
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		-- Above the thumb zones (which start at 55% of the height), so a prompt never sits under a thumb.
		label.Position = UDim2.fromScale(0.5, 0.45)
		label.Parent = frame
		prompt = label
	end

	setDistrict(options.district)
	setPrompt(options.prompt)

	if options.compass then
		compass = CompassView.new(frame)
	end

	if options.touch then
		local pad = Panel.new({ name = "MovePad", elevation = "raised" })
		pad.Parent = frame
		table.insert(controls, pad)

		local knob = Instance.new("Frame")
		knob.Name = "Knob"
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.fromOffset(Theme.size.touchComfort / 2, Theme.size.touchComfort / 2)
		knob.BackgroundColor3 = Style.color("accent")
		knob.BorderSizePixel = 0
		knob.Parent = pad
		local knobCorner = Instance.new("UICorner")
		knobCorner.CornerRadius = UDim.new(0.5, 0)
		knobCorner.Parent = knob

		local actionButtons: { TextButton } = {}
		for _, action in options.actions do
			local button = Button.new({
				text = action.label,
				variant = action.variant or "secondary",
				width = Theme.size.touchComfort,
				height = Theme.size.touchComfort,
				onActivated = function()
					options.onAction(action.id)
				end,
			})
			button.Parent = frame
			table.insert(actionButtons, button)
			table.insert(controls, button)
		end

		-- The pad captures one touch at a time: the first one that starts on it owns the stick until
		-- it lifts. Position is read from the pad's current AbsolutePosition each time, so a rotated
		-- or resized screen does not leave a stale centre.
		local activeTouch: InputObject? = nil
		local function updateStick(position: Vector3)
			local sx, sy = Layout.padVector({
				x = pad.AbsolutePosition.X,
				y = pad.AbsolutePosition.Y,
				w = pad.AbsoluteSize.X,
				h = pad.AbsoluteSize.Y,
			}, position.X, position.Y)
			options.onMove(sx, sy)
			local radius = math.min(pad.AbsoluteSize.X, pad.AbsoluteSize.Y) / 2
			knob.Position = UDim2.fromOffset(
				pad.AbsoluteSize.X / 2 + sx * radius,
				pad.AbsoluteSize.Y / 2 + sy * radius
			)
		end
		local function release()
			activeTouch = nil
			options.onMove(0, 0)
			knob.Position = UDim2.fromScale(0.5, 0.5)
		end

		table.insert(
			connections,
			pad.InputBegan:Connect(function(input: InputObject)
				if input.UserInputType == Enum.UserInputType.Touch and activeTouch == nil then
					activeTouch = input
					updateStick(input.Position)
				end
			end)
		)
		table.insert(
			connections,
			UserInputService.InputChanged:Connect(function(input: InputObject)
				if input == activeTouch then
					updateStick(input.Position)
				end
			end)
		)
		table.insert(
			connections,
			UserInputService.InputEnded:Connect(function(input: InputObject)
				if input == activeTouch then
					release()
				end
			end)
		)

		-- Positions follow the screen. Recomputed on every size change, never cached as pixels.
		local function relayout()
			local w, h = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
			if w <= 0 or h <= 0 then
				return
			end
			local safe = { x = 0, y = 0, w = w, h = h }
			local placed = Layout.touchControls(safe, TOUCH_GAP, #actionButtons)
			pad.Position = UDim2.fromOffset(placed.pad.x, placed.pad.y)
			pad.Size = UDim2.fromOffset(placed.pad.w, placed.pad.h)
			for i, button in actionButtons do
				local r = placed.actions[i]
				button.Position = UDim2.fromOffset(r.x, r.y)
				button.Size = UDim2.fromOffset(r.w, r.h)
			end
		end
		table.insert(connections, frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout))
		task.defer(relayout)
	end

	local destroyed = false
	local function destroy()
		if destroyed then
			return
		end
		destroyed = true
		for _, c in connections do
			c:Disconnect()
		end
		table.clear(connections)
		for _, control in controls do
			control:Destroy()
		end
		for _, plate in plates do
			plate.destroy()
		end
		if compass then
			compass.destroy()
		end
		frame:Destroy()
	end

	return {
		root = root,
		setPrompt = setPrompt,
		setDistrict = setDistrict,
		setHeading = function(degrees: number)
			if compass then
				compass.setHeading(degrees)
			end
		end,
		showPlate = function(text: string): NamePlate.Plate
			local plate = NamePlate.new(frame, text)
			table.insert(plates, plate)
			return plate
		end,
		destroy = destroy,
	}
end

return WalkHud
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Deterministic layout maths. Pure: takes numbers in, returns numbers out, so every rule in the
	UI spec (anchor resolution, breakpoints, safe areas, touch minimums, cab thumb zones) is checked
	by lune on the desktop, not by eye in a device emulator.

	Roblox resolves a GuiObject's top-left corner as:
	    origin = parent.origin + (scale * parent.size + offset) - anchor * size
	`anchorOrigin` below is that exact formula, so the tests describe what Roblox will draw.
]]

-- No requires here on purpose. Roblox resolves modules through `script.Parent`, which lune cannot
-- follow, so pure modules stay dependency-free and take token values as arguments. The Roblox
-- components pass Theme values in; the lune tests pass the same Theme values from their side.

local Layout = {}

export type Rect = { x: number, y: number, w: number, h: number }
export type Insets = { top: number, bottom: number, left: number, right: number }
export type Vec2 = { x: number, y: number }
export type UDim = { scale: number, offset: number }
export type Breakpoint = {
	class: "phone" | "tablet" | "desktop",
	orientation: "portrait" | "landscape",
}

-- UDim resolution: scale is a fraction of the parent, offset is added in pixels.
function Layout.resolve(d: UDim, parentPx: number): number
	return d.scale * parentPx + d.offset
end

-- Breakpoints use the short side, so a phone is a phone in both orientations. Thresholds sit
-- between common device classes: 500 separates phones (≤ 430 pt short side) from tablets
-- (≥ 744 pt); 800 separates tablets from desktop windows.
function Layout.classify(width: number, height: number): Breakpoint
	assert(width > 0 and height > 0, "Layout.classify needs a positive viewport")
	local short = math.min(width, height)
	local class: "phone" | "tablet" | "desktop" = "desktop"
	if short < 500 then
		class = "phone"
	elseif short < 800 then
		class = "tablet"
	end
	return {
		class = class,
		orientation = if height > width then "portrait" else "landscape",
	}
end

-- Horizontal gutter between the screen edge and content. The caller passes the spacing tokens
-- (Theme.space) so the mapping from class to gutter stays visible at the call site.
function Layout.gutter(bp: Breakpoint, phone: number, tablet: number, desktop: number): number
	if bp.class == "phone" then
		return phone
	elseif bp.class == "tablet" then
		return tablet
	end
	return desktop
end

-- Text is never smaller than the design floor, whatever a size calculation produces.
function Layout.clampTextSize(requested: number, minSize: number, maxSize: number): number
	return math.clamp(requested, minSize, maxSize)
end

-- Tappable areas grow to the touch minimum but never shrink below the design size.
function Layout.touchSize(w: number, h: number, touchMin: number): (number, number)
	return math.max(w, touchMin), math.max(h, touchMin)
end

function Layout.meetsTouchMinimum(w: number, h: number, touchMin: number): boolean
	return w >= touchMin and h >= touchMin
end

-- The area left after safe-area insets (notches, the Roblox top bar, the home indicator).
-- Clamped at zero so a degenerate viewport cannot produce a negative size.
function Layout.safeRect(width: number, height: number, insets: Insets): Rect
	local w = math.max(0, width - insets.left - insets.right)
	local h = math.max(0, height - insets.top - insets.bottom)
	return { x = insets.left, y = insets.top, w = w, h = h }
end

-- Top-left corner of a GuiObject inside `parent`, using Roblox's anchor semantics.
-- `position` is the UDim pair Roblox stores in Position; `anchor` is AnchorPoint (0..1 each).
function Layout.anchorOrigin(
	parent: Rect,
	size: Vec2,
	anchor: Vec2,
	position: { x: UDim, y: UDim }
): Vec2
	local px = Layout.resolve(position.x, parent.w) + parent.x
	local py = Layout.resolve(position.y, parent.h) + parent.y
	return {
		x = px - anchor.x * size.x,
		y = py - anchor.y * size.y,
	}
end

-- Largest rectangle of a given aspect ratio (width / height) that fits in the available area.
-- Used for the map canvas and in-world sign apertures, which must never stretch.
function Layout.fitAspect(availW: number, availH: number, aspect: number): (number, number)
	assert(aspect > 0, "aspect must be positive")
	if availW <= 0 or availH <= 0 then
		return 0, 0
	end
	if availW / availH > aspect then
		return availH * aspect, availH
	end
	return availW, availW / aspect
end

-- Height of a vertical stack: `count` items of `itemH` with `gap` between them, no trailing gap.
function Layout.stackHeight(count: number, itemH: number, gap: number): number
	if count <= 0 then
		return 0
	end
	return count * itemH + (count - 1) * gap
end

-- Cab thumb zones for a landscape phone. The left thumb owns reverser, horn and doors; the right
-- thumb owns throttle, brake and emergency brake. Each zone sits in the bottom 45% of the safe
-- area and never overlaps the other. The default Roblox thumbstick is switched off in the cab.
function Layout.cabThumbZones(safe: Rect): { left: Rect, right: Rect }
	local zoneH = safe.h * 0.45
	local zoneY = safe.y + safe.h - zoneH
	local leftW = safe.w * 0.4
	local rightW = safe.w * 0.4
	return {
		left = { x = safe.x, y = zoneY, w = leftW, h = zoneH },
		right = { x = safe.x + safe.w - rightW, y = zoneY, w = rightW, h = zoneH },
	}
end

-- Walk-mode touch controls, inside the same thumb zones the cab uses. The movement pad is a square
-- in the left zone, bottom-aligned so the thumb finds it without looking. The action buttons form a
-- two-column grid in the right zone, filled row by row. `gap` is the space between controls and from
-- the zone edges. Returns the pad and one rect per action, in order. Pure: no requires.
function Layout.touchControls(
	safe: Rect,
	gap: number,
	actionCount: number
): { pad: Rect, actions: { Rect } }
	assert(gap >= 0, "touch gap cannot be negative")
	assert(
		actionCount >= 0 and actionCount == math.floor(actionCount),
		"actionCount must be a whole number"
	)
	local zones = Layout.cabThumbZones(safe)
	local left = zones.left
	local side = math.min(left.w - 2 * gap, left.h - 2 * gap)
	local pad = { x = left.x + gap, y = left.y + left.h - gap - side, w = side, h = side }

	local right = zones.right
	local area =
		{ x = right.x + gap, y = right.y + gap, w = right.w - 2 * gap, h = right.h - 2 * gap }
	local actions: { Rect } = {}
	if actionCount > 0 then
		local rows = math.ceil(actionCount / 2)
		local cells = Layout.gridCells(area, 2, rows, gap)
		for i = 1, actionCount do
			table.insert(actions, cells[i])
		end
	end
	return { pad = pad, actions = actions }
end

-- Converts a touch point on the movement pad into a stick vector: the pad centre is (0, 0), its
-- edge is length 1, and anything beyond the edge is clamped to length 1 so a thumb sliding off the
-- pad still gives a full-speed direction. Screen y grows downward, so "up" is negative y.
function Layout.padVector(pad: Rect, px: number, py: number): (number, number)
	local cx = pad.x + pad.w / 2
	local cy = pad.y + pad.h / 2
	local radius = math.min(pad.w, pad.h) / 2
	if radius <= 0 then
		return 0, 0
	end
	local dx = (px - cx) / radius
	local dy = (py - cy) / radius
	local length = math.sqrt(dx * dx + dy * dy)
	if length > 1 then
		return dx / length, dy / length
	end
	return dx, dy
end

-- Splits a rect into cols × rows equal cells with `gap` between them. Cells are returned row by
-- row, left to right. Used to place cab controls inside a thumb zone without hand-tuned offsets.
function Layout.gridCells(area: Rect, cols: number, rows: number, gap: number): { Rect }
	assert(cols >= 1 and rows >= 1, "grid needs at least one row and one column")
	local cellW = (area.w - (cols - 1) * gap) / cols
	local cellH = (area.h - (rows - 1) * gap) / rows
	local cells: { Rect } = {}
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			table.insert(cells, {
				x = area.x + c * (cellW + gap),
				y = area.y + r * (cellH + gap),
				w = cellW,
				h = cellH,
			})
		end
	end
	return cells
end

-- Device profiles: the named layouts the UI spec promises. Columns and gutters are the numbers the
-- screens use; cabAvailable says whether the train controls can be shown at all. The cab needs
-- landscape width for two thumb zones, so portrait gets a rotate card instead (UI-SPEC §6).
export type Profile = {
	name: string,
	columns: number,
	gutter: number,
	cabAvailable: boolean,
}

-- Gutters are spacing tokens (Theme.space): 16 on phones, 32 on desktop.
local PROFILES: { [string]: Profile } = {
	["phone-portrait"] = { name = "phone-portrait", columns = 1, gutter = 16, cabAvailable = false },
	["phone-landscape"] = {
		name = "phone-landscape",
		columns = 2,
		gutter = 16,
		cabAvailable = true,
	},
	["tablet-portrait"] = {
		name = "tablet-portrait",
		columns = 1,
		gutter = 24,
		cabAvailable = false,
	},
	["tablet-landscape"] = {
		name = "tablet-landscape",
		columns = 2,
		gutter = 24,
		cabAvailable = true,
	},
	["desktop"] = { name = "desktop", columns = 3, gutter = 32, cabAvailable = true },
}

-- Which named profile a viewport is. Built on classify, so the phone threshold is the same
-- everywhere in the UI.
function Layout.profileFor(width: number, height: number): Profile
	local bp = Layout.classify(width, height)
	local key
	if bp.class == "phone" then
		key = if bp.orientation == "portrait" then "phone-portrait" else "phone-landscape"
	elseif bp.class == "tablet" then
		key = if bp.orientation == "portrait" then "tablet-portrait" else "tablet-landscape"
	else
		key = "desktop"
	end
	return PROFILES[key]
end

-- Every profile, in a fixed order, for tests and for the spec table.
Layout.profileNames =
	{ "phone-portrait", "phone-landscape", "tablet-portrait", "tablet-landscape", "desktop" }
Layout.profiles = PROFILES

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="49">
            <Properties>
              <string name="Name">Map</string>
            </Properties>
            <Item class="ModuleScript" referent="50">
              <Properties>
                <string name="Name">MapModel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Network map data: validation, bounds and segment extraction. Pure.

	The data is the network from docs/rail/NETWORK.md (CODE · vector), not anything read from
	Workspace. Under instance streaming a station model may not exist on the client, so the map is
	built entirely from this table. Everything arriving here is untrusted until `validate` passes:
	it is the boundary between the network data and the drawing code.

	Coordinates are world X and Z in studs, in the frame of docs/rail/NETWORK.md §1: X east, Z south.
	The map draws north at the top, so -Z is up the screen. Until BLENDER · atlas's WORLD-MAP.md
	exists, that frame is vector's provisional one; UI-SPEC §8 says so.
]]

local MapModel = {}

export type Point = { x: number, z: number }
export type SectionKind = "surface" | "elevated" | "underground"
export type Section = { kind: SectionKind, points: { Point } }
export type Line = {
	id: string,
	code: string,
	colour: string,
	stops: { string },
	sections: { Section },
}
export type Station = { id: string, name: string, x: number, z: number, interchange: boolean }
export type MapData = { stations: { Station }, lines: { Line } }
export type Segment = {
	lineId: string,
	colour: string,
	kind: SectionKind,
	x1: number,
	z1: number,
	x2: number,
	z2: number,
}
export type Bounds = { minX: number, minZ: number, maxX: number, maxZ: number }

-- Hard limits that keep the map inside its element budget (UI-SPEC §9). Values above these are
-- rejected, not truncated, so an oversized network fails loudly in tests.
MapModel.limits = {
	maxLines = 8,
	maxStations = 32,
	maxSectionsPerLine = 12,
	maxPointsPerSection = 64,
	maxNameLength = 40,
	maxCodeLength = 4,
	maxElements = 300,
}

local SECTION_KINDS: { [string]: boolean } = { surface = true, elevated = true, underground = true }
local COORD_LIMIT = 100000

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Returns (true, {}) when valid, or (false, reasons). Every reason is a sentence a data author can
-- act on. `allowedColours` is the set of colour tokens the theme defines.
function MapModel.validate(data: any, allowedColours: { [string]: boolean }): (boolean, { string })
	local errors: { string } = {}
	local function fail(message: string)
		table.insert(errors, message)
	end

	if type(data) ~= "table" then
		return false, { "map data must be a table with 'stations' and 'lines'" }
	end

	-- Stations.
	local stationIds: { [string]: boolean } = {}
	local stations = data.stations
	if type(stations) ~= "table" or #stations == 0 then
		fail("'stations' must be a non-empty array")
	elseif #stations > MapModel.limits.maxStations then
		fail(`{#stations} stations exceeds the limit of {MapModel.limits.maxStations}`)
	else
		for index, station in stations do
			local where = `stations[{index}]`
			if type(station) ~= "table" then
				fail(`{where} must be a table`)
				continue
			end
			if type(station.id) ~= "string" or station.id == "" then
				fail(`{where}.id must be a non-empty string`)
			elseif stationIds[station.id] then
				fail(`station id '{station.id}' is used more than once`)
			else
				stationIds[station.id] = true
			end
			if type(station.name) ~= "string" or #station.name == 0 then
				fail(`{where}.name must be a non-empty string`)
			elseif #station.name > MapModel.limits.maxNameLength then
				fail(`{where}.name is longer than {MapModel.limits.maxNameLength} characters`)
			end
			if not isFinite(station.x) or not isFinite(station.z) then
				fail(`{where} needs finite numeric x and z`)
			elseif math.abs(station.x) > COORD_LIMIT or math.abs(station.z) > COORD_LIMIT then
				fail(`{where} lies outside the ±{COORD_LIMIT} stud coordinate range`)
			end
			if type(station.interchange) ~= "boolean" then
				fail(`{where}.interchange must be true or false`)
			end
		end
	end

	-- Lines.
	local lines = data.lines
	local lineIds: { [string]: boolean } = {}
	if type(lines) ~= "table" or #lines == 0 then
		fail("'lines' must be a non-empty array")
	elseif #lines > MapModel.limits.maxLines then
		fail(`{#lines} lines exceeds the limit of {MapModel.limits.maxLines}`)
	else
		for index, line in lines do
			local where = `lines[{index}]`
			if type(line) ~= "table" then
				fail(`{where} must be a table`)
				continue
			end
			if type(line.id) ~= "string" or line.id == "" or lineIds[line.id] then
				fail(`{where}.id must be a unique non-empty string`)
			else
				lineIds[line.id] = true
			end
			if
				type(line.code) ~= "string"
				or #line.code == 0
				or #line.code > MapModel.limits.maxCodeLength
			then
				fail(`{where}.code must be 1 to {MapModel.limits.maxCodeLength} characters`)
			end
			if type(line.colour) ~= "string" or not allowedColours[line.colour] then
				fail(`{where}.colour '{tostring(line.colour)}' is not a colour token in Theme`)
			end
			if type(line.stops) ~= "table" then
				fail(`{where}.stops must be an array of station ids`)
			else
				for _, stopId in line.stops do
					if not stationIds[stopId] then
						fail(`{where} stops at unknown station '{tostring(stopId)}'`)
					end
				end
			end
			if type(line.sections) ~= "table" or #line.sections == 0 then
				fail(`{where}.sections must be a non-empty array`)
				continue
			end
			if #line.sections > MapModel.limits.maxSectionsPerLine then
				fail(`{where} has more than {MapModel.limits.maxSectionsPerLine} sections`)
			end
			for sIndex, section in line.sections do
				local sWhere = `{where}.sections[{sIndex}]`
				if type(section) ~= "table" or not SECTION_KINDS[section.kind] then
					fail(`{sWhere}.kind must be surface, elevated or underground`)
					continue
				end
				if type(section.points) ~= "table" or #section.points < 2 then
					fail(`{sWhere} needs at least two points`)
					continue
				end
				if #section.points > MapModel.limits.maxPointsPerSection then
					fail(`{sWhere} has more than {MapModel.limits.maxPointsPerSection} points`)
				end
				for pIndex, point in section.points do
					if type(point) ~= "table" or not isFinite(point.x) or not isFinite(point.z) then
						fail(`{sWhere}.points[{pIndex}] needs finite numeric x and z`)
					end
				end
			end
		end
	end

	-- Budget: the map must stay inside its element limit. Checked here so it fails in tests.
	if #errors == 0 then
		local count = MapModel.elementCount(data)
		if count > MapModel.limits.maxElements then
			fail(`map needs {count} elements, the budget is {MapModel.limits.maxElements}`)
		end
	end

	return #errors == 0, errors
end

-- Every drawn piece of a valid map: one Frame per segment, one marker and one label per station,
-- and one badge per line. The view creates exactly this many GuiObjects.
function MapModel.elementCount(data: MapData): number
	local count = 0
	for _, line in data.lines do
		count += 1 -- badge
		for _, section in line.sections do
			count += #section.points - 1
		end
	end
	count += #data.stations * 2 -- marker + label
	return count
end

-- Each section is split into straight segments: the drawable unit in the view.
function MapModel.segments(data: MapData): { Segment }
	local out: { Segment } = {}
	for _, line in data.lines do
		for _, section in line.sections do
			for i = 1, #section.points - 1 do
				local a = section.points[i]
				local b = section.points[i + 1]
				table.insert(out, {
					lineId = line.id,
					colour = line.colour,
					kind = section.kind,
					x1 = a.x,
					z1 = a.z,
					x2 = b.x,
					z2 = b.z,
				})
			end
		end
	end
	return out
end

-- Bounding box of stations and every line point, so the whole network fits on screen.
function MapModel.bounds(data: MapData): Bounds
	local minX, minZ = math.huge, math.huge
	local maxX, maxZ = -math.huge, -math.huge
	local function include(x: number, z: number)
		minX = math.min(minX, x)
		minZ = math.min(minZ, z)
		maxX = math.max(maxX, x)
		maxZ = math.max(maxZ, z)
	end
	for _, station in data.stations do
		include(station.x, station.z)
	end
	for _, line in data.lines do
		for _, section in line.sections do
			for _, point in section.points do
				include(point.x, point.z)
			end
		end
	end
	return { minX = minX, minZ = minZ, maxX = maxX, maxZ = maxZ }
end

return MapModel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="51">
              <Properties>
                <string name="Name">MapProjection</string>
                <string name="Source"><![CDATA[--!strict
--[[
	World (X, Z) to map-canvas pixels, plus zoom and pan. Pure.

	Frame: NETWORK.md §1 gives X east and Z south, in studs. The map draws north at the top, so the
	anchor is the minimum Z (the northmost point) and screen y grows with Z.

	Model: screen x = (x - minX) * scale + ox ; screen y = (z - minZ) * scale + oy
	- The anchors (minX, minZ) are stored in the transform, so zooming and panning change only the
	  scale and the offset. That keeps the zoom-about-a-point maths in one place.
	- Roblox GUI y also grows downward, so no flip is needed: the orientation comes from the anchor.

	Rotations follow the same screen convention: a Frame's Rotation is clockwise, and atan2 in
	screen space gives clockwise-positive angles, so the two agree. Verifying that Roblox draws a
	rotated segment exactly where the maths says is listed as unverified in the report.
]]

local MapProjection = {}

export type Bounds = { minX: number, minZ: number, maxX: number, maxZ: number }
export type Transform = {
	minX: number,
	minZ: number,
	scale: number,
	ox: number,
	oy: number,
}
export type Segment = { x1: number, z1: number, x2: number, z2: number }
export type Drawn = { cx: number, cy: number, length: number, angleDeg: number }

-- Fits the whole network inside a view of `viewW` × `viewH` pixels, keeping the aspect ratio and
-- centring the leftover space. A degenerate extent (one station) is widened to one stud so the
-- division is defined.
function MapProjection.fit(bounds: Bounds, viewW: number, viewH: number, padding: number): Transform
	assert(viewW > 0 and viewH > 0, "map view must have a positive size")
	local contentW = math.max(bounds.maxX - bounds.minX, 1)
	local contentH = math.max(bounds.maxZ - bounds.minZ, 1)
	local availW = math.max(viewW - 2 * padding, 1)
	local availH = math.max(viewH - 2 * padding, 1)
	local scale = math.min(availW / contentW, availH / contentH)
	return {
		minX = bounds.minX,
		minZ = bounds.minZ,
		scale = scale,
		ox = padding + (availW - contentW * scale) / 2,
		oy = padding + (availH - contentH * scale) / 2,
	}
end

function MapProjection.toScreen(t: Transform, x: number, z: number): (number, number)
	return (x - t.minX) * t.scale + t.ox, (z - t.minZ) * t.scale + t.oy
end

function MapProjection.fromScreen(t: Transform, sx: number, sy: number): (number, number)
	return (sx - t.ox) / t.scale + t.minX, (sy - t.oy) / t.scale + t.minZ
end

-- Zoom by `factor` while keeping the world point under (px, py) fixed on screen. That is what a
-- pinch or a wheel tick should feel like. The scale is clamped, and the anchor stays exact.
function MapProjection.zoomAt(
	t: Transform,
	px: number,
	py: number,
	factor: number,
	minScale: number,
	maxScale: number
): Transform
	assert(factor > 0, "zoom factor must be positive")
	local wx, wz = MapProjection.fromScreen(t, px, py)
	local scale = math.clamp(t.scale * factor, minScale, maxScale)
	return {
		minX = t.minX,
		minZ = t.minZ,
		scale = scale,
		ox = px - (wx - t.minX) * scale,
		oy = py - (wz - t.minZ) * scale,
	}
end

function MapProjection.panBy(t: Transform, dx: number, dy: number): Transform
	return {
		minX = t.minX,
		minZ = t.minZ,
		scale = t.scale,
		ox = t.ox + dx,
		oy = t.oy + dy,
	}
end

-- Stops the network being dragged off screen. At least a quarter of the view, or the whole
-- content if it is smaller, has to stay visible on each axis.
function MapProjection.clampToView(
	t: Transform,
	bounds: Bounds,
	viewW: number,
	viewH: number
): Transform
	local cw = (bounds.maxX - bounds.minX) * t.scale
	local ch = (bounds.maxZ - bounds.minZ) * t.scale
	local keepX = math.min(cw, viewW * 0.25)
	local keepY = math.min(ch, viewH * 0.25)
	return {
		minX = t.minX,
		minZ = t.minZ,
		scale = t.scale,
		ox = math.clamp(t.ox, keepX - cw, viewW - keepX),
		oy = math.clamp(t.oy, keepY - ch, viewH - keepY),
	}
end

-- Screen-space placement of one straight segment: its midpoint, length and angle.
function MapProjection.drawSegment(t: Transform, seg: Segment): Drawn
	local ax, ay = MapProjection.toScreen(t, seg.x1, seg.z1)
	local bx, by = MapProjection.toScreen(t, seg.x2, seg.z2)
	local dx = bx - ax
	local dy = by - ay
	return {
		cx = (ax + bx) / 2,
		cy = (ay + by) / 2,
		length = math.sqrt(dx * dx + dy * dy),
		angleDeg = math.deg(math.atan2(dy, dx)),
	}
end

return MapProjection
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="52">
              <Properties>
                <string name="Name">MapView</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Network map view: draws a validated MapModel as Frames, one per segment, one marker and label
	per station, and one badge per line. Everything it draws comes from the data table. It never
	reads Workspace, so streamed-out stations cannot break it (docs/ARCHITECTURE.md rule 4).

	Lifecycle:
	- `new` validates the data and builds the view. Building is chunked: the work is split across
	  frames so opening the map cannot stall one frame (docs/RESOURCES.md, 16.67 ms budget).
	- Positions are recomputed only when the canvas size or the user's zoom or pan changes.
	- `destroy` disconnects everything. Closing the map must not leave listeners behind.

	Not verified here (no Studio): the sign convention of Frame.Rotation on screen (projection
	tests assume clockwise-positive), label overlap at low zoom, and touch drag feel. These are
	listed in docs/ui/UI-SPEC.md §13 for the Manager's device pass.
]]

local UserInputService = game:GetService("UserInputService")

local MapModel = require(script.Parent.MapModel)
local MapProjection = require(script.Parent.MapProjection)
local NetworkSource = require(script.Parent.NetworkSource)
local Label = require(script.Parent.Parent.Components.Label)
local Theme = require(script.Parent.Parent.Theme)
local Style = require(script.Parent.Parent.Style)

local MapView = {}

export type Placeable = { frame: GuiObject, place: (MapProjection.Transform) -> () }
export type View = {
	root: Frame,
	canvas: Frame,
	data: MapModel.MapData,
	bounds: MapModel.Bounds,
	items: { Placeable },
	transform: MapProjection.Transform?,
	userZoomed: boolean,
	connections: { RBXScriptConnection },
	destroyed: boolean,
}

local PADDING = 24
local MIN_SCALE_FACTOR = 0.5 -- zoom-out limit relative to the fitted scale
local MAX_SCALE_FACTOR = 6
local BUILD_BUDGET_S = 0.004 -- yield to the next frame after roughly a quarter of a frame
local SEGMENT_THICKNESS = 4
local STATION_SIZE = 12
local INTERCHANGE_SIZE = 18

local ALLOWED_COLOURS: { [string]: boolean } = {}
for name in Theme.lineColours do
	ALLOWED_COLOURS[name] = true
end

local function placeMarker(frame: GuiObject, x: number, y: number)
	frame.Position = UDim2.fromOffset(x, y)
end

-- Creates one placeable per drawable piece. Returns the list, so layout code can iterate it.
local function buildSegment(canvas: Frame, segment: MapModel.Segment): Placeable
	local frame = Instance.new("Frame")
	frame.Name = `Segment_{segment.lineId}`
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = Style.hex(Theme.lineColours[segment.colour])
	-- Underground track is drawn at half strength. This is the only visual distinction between
	-- kinds in Phase 1, so it is also named in the spec's legend.
	frame.BackgroundTransparency = if segment.kind == "underground" then 0.5 else 0
	frame.Parent = canvas
	return {
		frame = frame,
		place = function(t: MapProjection.Transform)
			local d = MapProjection.drawSegment(t, segment)
			frame.Position = UDim2.fromOffset(d.cx, d.cy)
			frame.Size = UDim2.fromOffset(d.length + 1, SEGMENT_THICKNESS)
			frame.Rotation = d.angleDeg
		end,
	}
end

local function buildStation(canvas: Frame, station: MapModel.Station): { Placeable }
	local size = if station.interchange then INTERCHANGE_SIZE else STATION_SIZE
	local marker = Instance.new("Frame")
	marker.Name = `Station_{station.id}`
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Size = UDim2.fromOffset(size, size)
	marker.BackgroundColor3 = Style.color("signText")
	marker.BorderSizePixel = 0
	marker.Parent = canvas

	local ring = Instance.new("UIStroke")
	ring.Color = Style.color("ink")
	ring.Thickness = 2
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = marker

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = marker

	local label = Instance.new("TextLabel")
	label.Name = `Label_{station.id}`
	label.BackgroundTransparency = 1
	label.Text = station.name
	label.TextColor3 = Style.color("text")
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, 16)
	label.Parent = canvas
	Style.applyType(label, "label")

	return {
		{
			frame = marker,
			place = function(t: MapProjection.Transform)
				local x, y = MapProjection.toScreen(t, station.x, station.z)
				placeMarker(marker, x, y)
			end,
		},
		{
			frame = label,
			place = function(t: MapProjection.Transform)
				local x, y = MapProjection.toScreen(t, station.x, station.z)
				label.Position = UDim2.fromOffset(x + size / 2 + 4, y - 8)
			end,
		},
	}
end

-- A line badge sits beside the first stop of the line, so the line can be identified without
-- relying on colour alone.
local function buildBadge(canvas: Frame, line: MapModel.Line, station: MapModel.Station?): Placeable
	local badge = Instance.new("TextLabel")
	badge.Name = `Badge_{line.id}`
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Size = UDim2.fromOffset(22, 22)
	badge.BackgroundColor3 = Style.hex(Theme.lineColours[line.colour])
	badge.BorderSizePixel = 0
	badge.Text = line.code
	badge.TextColor3 = Style.color("ink")
	badge.Parent = canvas
	Style.applyType(badge, "label")
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = badge

	return {
		frame = badge,
		place = function(t: MapProjection.Transform)
			if station == nil then
				return
			end
			local x, y = MapProjection.toScreen(t, station.x, station.z)
			badge.Position = UDim2.fromOffset(x - 16, y - 16)
		end,
	}
end

local function currentTransform(view: View): MapProjection.Transform
	local w = view.canvas.AbsoluteSize.X
	local h = view.canvas.AbsoluteSize.Y
	return MapProjection.fit(view.bounds, math.max(w, 1), math.max(h, 1), PADDING)
end

-- Repositions every item for `t`. Cheap enough to call on every pan event: it is one arithmetic
-- pass over at most `maxElements` items, with no instance creation.
local function applyTransform(view: View, t: MapProjection.Transform)
	view.transform = t
	for _, item in view.items do
		item.place(t)
	end
end

function MapView.relayout(view: View)
	if view.destroyed or #view.items == 0 then
		return
	end
	local fitted = currentTransform(view)
	if view.userZoomed and view.transform then
		-- Keep the user's zoom ratio when the window is resized, rather than snapping back.
		local ratio = view.transform.scale / fitted.scale
		local w = view.canvas.AbsoluteSize.X
		local h = view.canvas.AbsoluteSize.Y
		local rescaled = MapProjection.zoomAt(fitted, w / 2, h / 2, ratio, 0, math.huge)
		applyTransform(view, MapProjection.clampToView(rescaled, view.bounds, w, h))
	else
		applyTransform(view, fitted)
	end
end

function MapView.zoom(view: View, factor: number)
	if view.destroyed then
		return
	end
	local fitted = currentTransform(view)
	local current = view.transform or fitted
	local w = view.canvas.AbsoluteSize.X
	local h = view.canvas.AbsoluteSize.Y
	local zoomed = MapProjection.zoomAt(
		current,
		w / 2,
		h / 2,
		factor,
		fitted.scale * MIN_SCALE_FACTOR,
		fitted.scale * MAX_SCALE_FACTOR
	)
	view.userZoomed = true
	applyTransform(view, MapProjection.clampToView(zoomed, view.bounds, w, h))
end

function MapView.pan(view: View, dx: number, dy: number)
	if view.destroyed or view.transform == nil then
		return
	end
	local w = view.canvas.AbsoluteSize.X
	local h = view.canvas.AbsoluteSize.Y
	local panned = MapProjection.panBy(view.transform, dx, dy)
	view.userZoomed = true
	applyTransform(view, MapProjection.clampToView(panned, view.bounds, w, h))
end

-- Builds the map under `parent`. Errors on invalid data, listing every reason, so a bad network
-- file is a clear failure in tests and never a half-drawn map.
function MapView.new(parent: GuiObject, source: NetworkSource.Source): View
	local raw, reason = source.load()
	if raw == nil then
		warn(`MapView: source '{source.name}' has no data: {reason or "no reason given"}`)
		return MapView.unavailable(parent)
	end
	local ok, errors = MapModel.validate(raw, ALLOWED_COLOURS)
	if not ok then
		warn(`MapView: source '{source.name}' rejected: {table.concat(errors, "; ")}`)
		return MapView.unavailable(parent)
	end
	local data: MapModel.MapData = raw

	local root = Instance.new("Frame")
	root.Name = "NetworkMap"
	root.BackgroundColor3 = Style.color("surface")
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 1)
	root.ClipsDescendants = true
	root.Parent = parent

	local canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromScale(1, 1)
	canvas.Parent = root

	local view: View = {
		root = root,
		canvas = canvas,
		data = data,
		bounds = MapModel.bounds(data),
		items = {},
		transform = nil,
		userZoomed = false,
		connections = {},
		destroyed = false,
	}

	-- Lines first, so stations draw on top of track.
	local stationById: { [string]: MapModel.Station } = {}
	for _, station in data.stations do
		stationById[station.id] = station
	end
	local queued: { () -> { Placeable } } = {}
	for _, line in data.lines do
		for _, section in line.sections do
			for i = 1, #section.points - 1 do
				local a = section.points[i]
				local b = section.points[i + 1]
				local segment: MapModel.Segment = {
					lineId = line.id,
					colour = line.colour,
					kind = section.kind,
					x1 = a.x,
					z1 = a.z,
					x2 = b.x,
					z2 = b.z,
				}
				table.insert(queued, function()
					return { buildSegment(canvas, segment) }
				end)
			end
		end
		local firstStop = if #line.stops > 0 then stationById[line.stops[1]] else nil
		table.insert(queued, function()
			return { buildBadge(canvas, line, firstStop) }
		end)
	end
	for _, station in data.stations do
		table.insert(queued, function()
			return buildStation(canvas, station)
		end)
	end

	-- Build in chunks. The task is cancelled by `destroy` setting view.destroyed.
	task.spawn(function()
		local started = os.clock()
		for _, make in queued do
			if view.destroyed then
				return
			end
			for _, item in make() do
				table.insert(view.items, item)
			end
			if os.clock() - started > BUILD_BUDGET_S then
				task.wait()
				started = os.clock()
			end
		end
		MapView.relayout(view)
	end)

	table.insert(
		view.connections,
		canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			MapView.relayout(view)
		end)
	)

	-- Drag to pan with mouse or touch. Pinch is not implemented in Phase 1 (see the spec).
	local dragging = false
	local lastX, lastY = 0, 0
	table.insert(
		view.connections,
		canvas.InputBegan:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragging = true
				lastX = input.Position.X
				lastY = input.Position.Y
			end
		end)
	)
	table.insert(
		view.connections,
		UserInputService.InputChanged:Connect(function(input: InputObject)
			if not dragging then
				return
			end
			if
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			then
				MapView.pan(view, input.Position.X - lastX, input.Position.Y - lastY)
				lastX = input.Position.X
				lastY = input.Position.Y
			end
		end)
	)
	table.insert(
		view.connections,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragging = false
			end
		end)
	)

	return view
end

-- The screen when no valid network exists (UI-SPEC §9.6). One sentence for the player; the reason
-- went to the developer log in `new`. The view is empty but fully destroyable, so the caller's
-- close path does not need a special case.
function MapView.unavailable(parent: GuiObject): View
	local root = Instance.new("Frame")
	root.Name = "NetworkMap"
	root.BackgroundColor3 = Style.color("surface")
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 1)
	root.ClipsDescendants = true
	root.Parent = parent

	local message = Label.new({
		name = "Unavailable",
		text = "Network map unavailable.",
		type = "heading",
		color = "text",
		align = "center",
	})
	message.AnchorPoint = Vector2.new(0.5, 0.5)
	message.Position = UDim2.fromScale(0.5, 0.5)
	message.Size = UDim2.fromScale(0.8, 0.2)
	message.Parent = root

	local empty: MapModel.MapData = { stations = {}, lines = {} }
	local noBounds: MapModel.Bounds = { minX = 0, minZ = 0, maxX = 0, maxZ = 0 }
	return {
		root = root,
		canvas = root,
		data = empty,
		bounds = noBounds,
		items = {},
		transform = nil,
		userZoomed = false,
		connections = {},
		destroyed = false,
	}
end

function MapView.destroy(view: View)
	if view.destroyed then
		return
	end
	view.destroyed = true
	for _, connection in view.connections do
		connection:Disconnect()
	end
	table.clear(view.connections)
	view.root:Destroy()
	table.clear(view.items)
end

return MapView
]]></string>
              </Properties>
            </Item>
