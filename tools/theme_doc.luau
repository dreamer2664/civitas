--!strict
--[[
	Writes docs/ui/THEME-TOKENS.md from src/client/UI/Theme.luau, so the written token list cannot
	drift from the code it describes.

	Usage (from the repo root):
	  lune run tools/theme_doc.luau           -- rewrite docs/ui/THEME-TOKENS.md
	  lune run tools/theme_doc.luau -- --check -- exit 1 if the committed file is stale
]]

local fs = require("@lune/fs")
local process = require("@lune/process")
local Theme = require("../src/client/UI/Theme")

local OUT = "docs/ui/THEME-TOKENS.md"

-- Lune passes arguments differently with and without a "--" separator, so look for the flag anywhere.
local function hasFlag(flag: string): boolean
	for _, arg in process.args do
		if arg == flag then
			return true
		end
	end
	return false
end

local lines: { string } = {}
local function add(line: string)
	table.insert(lines, line)
end

local function ratio(a: string, b: string): string
	return string.format("%.2f", Theme.contrast(a, b))
end

add(
	"<!-- Generated by tools/theme_doc.luau from src/client/UI/Theme.luau. Do not edit by hand. -->"
)
add("# Theme tokens")
add("")
add(
	"Every colour, font, size, spacing value, radius, elevation level and motion duration used by a"
)
add("UI component is read from `src/client/UI/Theme.luau`. This page lists them with the contrast")
add("figures the tests check. Contrast is WCAG 2.x, computed by `Theme.contrast`.")
add("")

add("## Palette")
add("")
add("Text needs 4.5:1 or better on the surface it sits on (WCAG AA). Values under 4.5 are allowed")
add("only for fills, borders and focus rings; `accent` is one of these and is never used for text.")
add("")
add("| Token | Hex | On ink | On surface | On raised |")
add("|---|---|---|---|---|")
local paletteNames: { string } = {}
for name in Theme.palette do
	table.insert(paletteNames, name)
end
table.sort(paletteNames)
for _, name in paletteNames do
	local hex = Theme.palette[name]
	add(
		`| {name} | \`{hex}\` | {ratio(hex, Theme.palette.ink)} | {ratio(hex, Theme.palette.surface)} | {ratio(
			hex,
			Theme.palette.raised
		)} |`
	)
end
add("")

add("## Line colours (network map)")
add("")
add("| Line | Hex | On ink | On surface |")
add("|---|---|---|---|")
local lineNames: { string } = {}
for name in Theme.lineColours do
	table.insert(lineNames, name)
end
table.sort(lineNames)
for _, name in lineNames do
	local hex = Theme.lineColours[name]
	add(
		`| {name} | \`{hex}\` | {ratio(hex, Theme.palette.ink)} | {ratio(hex, Theme.palette.surface)} |`
	)
end
add("")

add("## Elevation")
add("")
add("Elevation is a fill step, not a shadow. Each level is lighter than the one below it.")
add("")
add("| Level | Palette token |")
add("|---|---|")
for _, level in { "flat", "raised", "overlay" } do
	add(`| {level} | {Theme.elevation[level]} |`)
end
add("")

add("## Typography")
add("")
add("| Style | Face | Size (px) |")
add("|---|---|---|")
local typeNames: { string } = {}
for name in Theme.type do
	table.insert(typeNames, name)
end
table.sort(typeNames)
for _, name in typeNames do
	local style = Theme.type[name]
	add(`| {name} | {style.face} | {style.size} |`)
end
add("")
add(`Text size limits: {Theme.size.minTextSize} px minimum, {Theme.size.maxTextSize} px maximum.`)
add("")

add("## Spacing (4-point grid)")
add("")
add("| Token | Pixels |")
add("|---|---|")
local spaceNames: { string } = {}
for name in Theme.space do
	table.insert(spaceNames, name)
end
table.sort(spaceNames, function(a: string, b: string)
	return Theme.space[a] < Theme.space[b]
end)
for _, name in spaceNames do
	add(`| {name} | {Theme.space[name]} |`)
end
add("")

add("## Radius")
add("")
add("| Token | Pixels |")
add("|---|---|")
for _, name in { "sign", "control", "panel" } do
	add(`| {name} | {Theme.radius[name]} |`)
end
add("")

add("## Sizes")
add("")
add("| Token | Pixels | Note |")
add("|---|---|---|")
add(`| touchMin | {Theme.size.touchMin} | smallest tappable control on any device |`)
add(`| touchComfort | {Theme.size.touchComfort} | cab controls and primary actions |`)
add(`| hairline | {Theme.size.hairline} | 1 px borders, decorative only |`)
add(`| focusRing | {Theme.size.focusRing} | keyboard and gamepad focus |`)
add(`| dot | {Theme.size.dot} | status dot diameter |`)
add("")

add("## Motion")
add("")
add("Durations in seconds. With reduced motion on, every duration except `instant` is 0.")
add("")
add("| Token | Seconds |")
add("|---|---|")
for _, name in { "instant", "fast", "base", "slow" } do
	add(`| {name} | {Theme.motion[name]} |`)
end
add(`Easing: {Theme.motion.easeStyle} {Theme.motion.easeDirection}.`)
add("")

local text = table.concat(lines, "\n") .. "\n"

if hasFlag("--check") then
	local current = fs.readFile(OUT)
	if current ~= text then
		print(`theme_doc: {OUT} is stale; run lune run tools/theme_doc.luau`)
		process.exit(1)
	end
	print(`theme_doc: {OUT} is current`)
else
	fs.writeFile(OUT, text)
	print(`theme_doc: wrote {OUT} ({#lines} lines)`)
end
