        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">BoardingRules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure admission rule for the experimental shuttle, not a complete passenger service.
-- The server must derive every argument from its own train, platform and seat state.
local BoardingRules = {}

function BoardingRules.canBoard(
	doorsOpen: boolean,
	speedMs: number,
	atPlatform: boolean,
	seatFree: boolean
): boolean
	if
		type(speedMs) ~= "number"
		or speedMs ~= speedMs
		or speedMs == math.huge
		or speedMs == -math.huge
	then
		return false
	end
	return doorsOpen == true
		and atPlatform == true
		and seatFree == true
		and math.abs(speedMs) <= 0.01
end

-- `isPassenger` must be determined by finding this character in the server's passenger seats.
function BoardingRules.canAlight(
	doorsOpen: boolean,
	speedMs: number,
	atPlatform: boolean,
	isPassenger: boolean
): boolean
	return BoardingRules.canBoard(doorsOpen, speedMs, atPlatform, isPassenger)
end

return BoardingRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">ControlGate</string>
            <string name="Source"><![CDATA[--!strict
-- Pure helpers for a server-owned driver's remote. The server supplies identity and time;
-- clients never choose the character or occupant used by `authorized`.
local ControlGate = {}

export type Bucket = { tokens: number, time: number }
local RATE = 10
local CAPACITY = 20

function ControlGate.authorized(character: any, occupantCharacter: any): boolean
	return character ~= nil and occupantCharacter ~= nil and character == occupantCharacter
end

-- Per-player token bucket. Rejected requests do not spend a token. Clock rollback and non-finite
-- time fail closed; the service must remove a player's bucket when that player leaves.
function ControlGate.consume(bucket: Bucket?, now: number): (Bucket?, boolean)
	if type(now) ~= "number" or now ~= now or now == math.huge or now == -math.huge then
		return bucket, false
	end
	if bucket == nil then
		return { tokens = CAPACITY - 1, time = now }, true
	end
	if now < bucket.time then
		return bucket, false
	end
	local tokens = math.min(CAPACITY, bucket.tokens + (now - bucket.time) * RATE)
	if tokens < 1 then
		return { tokens = tokens, time = now }, false
	end
	return { tokens = tokens - 1, time = now }, true
end

return ControlGate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">DriverControl</string>
            <string name="Source"><![CDATA[--!strict
-- Pure command boundary for a future server-owned driving service. No remotes are installed here.
-- Authority, player identity, rate limiting, and platform detection MUST be supplied by the server.
-- Reject malformed inputs rather than coercing or accepting non-finite values.
local DriverControl = {}

export type Command = {
	throttle: number,
	brake: number,
	reverser: number,
	horn: boolean?,
	doors: string?,
}

local function finiteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function DriverControl.validate(raw: any): (Command?, string?)
	if type(raw) ~= "table" then
		return nil, "command must be a table"
	end
	if not finiteNumber(raw.throttle) or raw.throttle < -1 or raw.throttle > 1 then
		return nil, "throttle must be finite and between -1 and 1"
	end
	if not finiteNumber(raw.brake) or raw.brake < 0 or raw.brake > 1 then
		return nil, "brake must be finite and between 0 and 1"
	end
	if
		not finiteNumber(raw.reverser)
		or (raw.reverser ~= -1 and raw.reverser ~= 0 and raw.reverser ~= 1)
	then
		return nil, "reverser must be -1, 0 or 1"
	end
	if raw.horn ~= nil and type(raw.horn) ~= "boolean" then
		return nil, "horn must be boolean"
	end
	if
		raw.doors ~= nil
		and raw.doors ~= "open"
		and raw.doors ~= "close"
		and raw.doors ~= "hold"
	then
		return nil, "doors must be open, close or hold"
	end
	if raw.throttle ~= 0 and raw.throttle * raw.reverser <= 0 then
		return nil, "throttle direction must match reverser"
	end
	-- Copy only the recognised fields. No client-supplied position or unknown fields propagate.
	return {
		throttle = raw.throttle,
		brake = raw.brake,
		reverser = raw.reverser,
		horn = raw.horn,
		doors = raw.doors :: string?,
	},
		nil
end

return DriverControl
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Kinematics</string>
            <string name="Source"><![CDATA[--!strict
--[[
Kinematics.luau — train dynamics along a spline (pure Luau).

Pure Luau: no DataModel access, testable with lune without Studio. All integration units are
SI internally (metres, m/s, newtons, kilograms); distances exposed to the simulation are
converted to studs (1 m = 3.571... studs, docs/STANDARDS.md).

Model
-----
Longitudinal dynamics only — lateral/vertical behaviour is handled by the spline (the train
is constrained to the track centre line by construction).

	force = tractiveEffort - brakeForce - rollingResistance - airResistance - mass * g * grade
	acceleration = force / mass

where grade is the track slope (sin of the incline, -1 for straight down, +1 for straight up).
Braking distance under constant deceleration: d = v^2 / (2 * deceleration), used for stop
markers and signal braking curves.

Integration is semi-implicit Euler with speed clamping; the caller subdivides dt as needed
for stability (a fixed 30 Hz tick with at most one integration per tick is the intended use).
--]]

local STUD_PER_METER = 1 / 0.28 -- 1 m = 3.571... studs
local GRAVITY = 9.81 -- m/s^2

export type TrainConfig = {
	massKg: number,
	-- Tractive effort at full throttle (newtons), flat track, from standstill.
	maxTractiveEffortN: number,
	-- Service brake force at full application (newtons).
	serviceBrakeForceN: number,
	-- Emergency brake force at full application (newtons).
	emergencyBrakeForceN: number,
	-- Maximum allowed speed (m/s).
	maxSpeedMs: number,
	-- Constant rolling resistance (newtons).
	rollingResistanceN: number,
	-- Air resistance coefficient: force = airResistanceCoeff * speed^2 (newtons).
	airResistanceCoeff: number,
}

export type MotionState = {
	speedMs: number, -- signed speed along the track (m/s)
	distanceStuds: number, -- arc-length position on the spline (studs)
}

export type Controls = {
	tractive: number, -- -1 (full reverse) to 1 (full forward)
	serviceBrake: number, -- 0 (none) to 1 (full)
	emergencyBrake: boolean,
}

local Kinematics = {}

-- Clamp a value to [min, max].
local function clamp(value: number, min: number, max: number): number
	if value < min then
		return min
	end
	if value > max then
		return max
	end
	return value
end

-- Signed sign: -1, 0 or 1.
local function sign(value: number): number
	if value > 0 then
		return 1
	end
	if value < 0 then
		return -1
	end
	return 0
end

-- Total resistive force opposing motion (newtons), always >= 0 and acting against velocity.
local function resistanceForce(config: TrainConfig, speedMs: number): number
	local speed = math.abs(speedMs)
	return config.rollingResistanceN + config.airResistanceCoeff * speed * speed
end

-- Longitudinal acceleration (m/s^2) for the given controls and track grade.
function Kinematics.computeAcceleration(
	state: MotionState,
	controls: Controls,
	config: TrainConfig,
	grade: number
): number
	local speed = state.speedMs
	local direction = sign(speed)

	-- Brake demand interlocks traction. Signed traction is along the track coordinate.
	local brakeDemand = clamp(controls.serviceBrake, 0, 1)
	local tractive = 0
	if not controls.emergencyBrake and brakeDemand == 0 then
		tractive = clamp(controls.tractive, -1, 1) * config.maxTractiveEffortN
	end

	local brakeForce = if controls.emergencyBrake
		then config.emergencyBrakeForceN
		else brakeDemand * config.serviceBrakeForceN
	brakeForce = math.min(brakeForce, config.massKg * GRAVITY)
	local gradeForce = config.massKg * GRAVITY * grade
	local driveForce = tractive - gradeForce
	local opposingForce = brakeForce + resistanceForce(config, speed)

	if direction == 0 then
		-- Static holding: brakes and rolling resistance oppose the force trying to move
		-- the stationary train, up to their combined capacity.
		if math.abs(driveForce) <= opposingForce then
			return 0
		end
		return (driveForce - sign(driveForce) * opposingForce) / config.massKg
	end
	return (driveForce - direction * opposingForce) / config.massKg
end

-- Integrate one step (semi-implicit Euler), returning a new state.
function Kinematics.integrate(
	state: MotionState,
	dt: number,
	controls: Controls,
	config: TrainConfig,
	grade: number
): MotionState
	local acceleration = Kinematics.computeAcceleration(state, controls, config, grade)
	assert(dt >= 0 and dt < math.huge, "integration timestep must be finite and non-negative")
	local newSpeed = state.speedMs + acceleration * dt
	local travelTime = dt
	-- Resistance and braking must not create a spurious reversal when a tick crosses zero.
	-- Integrate only until the stop, then reevaluate static forces on the next tick.
	if state.speedMs ~= 0 and state.speedMs * newSpeed < 0 then
		travelTime = math.abs(state.speedMs / acceleration)
		newSpeed = 0
	end
	newSpeed = clamp(newSpeed, -config.maxSpeedMs, config.maxSpeedMs)

	local averageSpeed = (state.speedMs + newSpeed) / 2
	local distanceMeters = averageSpeed * travelTime
	return {
		speedMs = newSpeed,
		distanceStuds = state.distanceStuds + distanceMeters * STUD_PER_METER,
	}
end

-- Braking distance (metres) to come to a complete stop from speedMs under constant deceleration.
-- grade positive (uphill) helps braking; negative (downhill) hurts it.
function Kinematics.brakingDistance(
	speedMs: number,
	brakeForceN: number,
	massKg: number,
	grade: number
): number
	local speed = math.abs(speedMs)
	-- Uphill (grade > 0) adds to braking; downhill reduces it.
	local deceleration = (brakeForceN + massKg * GRAVITY * grade) / massKg
	-- Resistance also helps braking; including it would require integrating over speed, so we
	-- report the conservative (longer) pure-brake distance plus a small resistance margin.
	if deceleration <= 0 then
		return math.huge
	end
	return (speed * speed) / (2 * deceleration)
end

-- Distance (studs) required to stop from the current state under the given brake, in either direction.
function Kinematics.stopDistanceStuds(
	state: MotionState,
	controls: Controls,
	config: TrainConfig,
	grade: number
): number
	if state.speedMs == 0 then
		return 0
	end
	local brakeForce = controls.emergencyBrake and config.emergencyBrakeForceN
		or clamp(controls.serviceBrake, 0, 1) * config.serviceBrakeForceN
	brakeForce = math.min(brakeForce, config.massKg * GRAVITY)
	if brakeForce <= 0 then
		return math.huge
	end
	-- Grade is defined in the positive track direction; reverse travel sees the opposite slope.
	local meters = Kinematics.brakingDistance(
		state.speedMs,
		brakeForce,
		config.massKg,
		grade * sign(state.speedMs)
	)
	return meters * STUD_PER_METER
end

-- Create a default EMU-ish configuration (numbers are placeholder targets, to be replaced by
-- the measured EMU-1 data from assets/trains/EMU-1/README.md once mason publishes it).
function Kinematics.defaultConfig(): TrainConfig
	return {
		massKg = 120000, -- 120 t EMU two-car
		maxTractiveEffortN = 120000,
		serviceBrakeForceN = 90000,
		emergencyBrakeForceN = 200000,
		maxSpeedMs = 33.3, -- 120 km/h
		rollingResistanceN = 4000,
		airResistanceCoeff = 60,
	}
end

-- Create a stopped state at the given arc-length position (studs).
function Kinematics.stopped(distanceStuds: number): MotionState
	return { speedMs = 0, distanceStuds = distanceStuds }
end

return Kinematics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ShuttleService</string>
            <string name="Source"><![CDATA[--!strict
-- Experimental two-stop automatic service. Pure rules, not signalling or production ATP.
-- The server supplies motion and fixed dt, and applies commands through TrainSimulation.
local ShuttleService = {}
export type Stop = { id: string, name: string, distanceStuds: number }
export type Route = { stops: { Stop }, dwellSeconds: number, maxSpeedMs: number }
export type State = {
	target: number,
	phase: string,
	remaining: number,
	completedLegs: number,
}
export type Motion = { distanceStuds: number, speedMs: number }
export type Command = { throttle: number, brake: number, reverser: number, doors: string }

local function finite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

function ShuttleService.validate(route: Route)
	assert(#route.stops == 2, "experimental service requires exactly two stops")
	assert(finite(route.dwellSeconds) and route.dwellSeconds >= 5, "invalid dwell")
	assert(
		finite(route.maxSpeedMs) and route.maxSpeedMs > 0 and route.maxSpeedMs <= 10,
		"invalid speed"
	)
	for _, stop in route.stops do
		assert(finite(stop.distanceStuds), "invalid stop position")
		assert(#stop.id > 0 and #stop.name > 0, "missing stop identity")
	end
	assert(route.stops[2].distanceStuds - route.stops[1].distanceStuds > 160, "stops overlap")
	assert(route.stops[1].id ~= route.stops[2].id, "duplicate stop id")
end

function ShuttleService.new(route: Route, motion: Motion): State
	ShuttleService.validate(route)
	local a = math.abs(motion.distanceStuds - route.stops[1].distanceStuds)
	local b = math.abs(motion.distanceStuds - route.stops[2].distanceStuds)
	-- Recover toward the current direction when moving; choose the nearest stop when stopped.
	local target = if math.abs(motion.speedMs) > 0.01
		then (if motion.speedMs > 0 then 2 else 1)
		else (if a < b then 1 else 2)
	return { target = target, phase = "approaching", remaining = 0, completedLegs = 0 }
end

function ShuttleService.atStop(route: Route, distance: number): Stop?
	if not finite(distance) then
		return nil
	end
	for _, stop in route.stops do
		if math.abs(distance - stop.distanceStuds) <= 2 then
			return stop
		end
	end
	return nil
end

-- A docking correction is returned only inside 0.6 studs and below 0.12 m/s. It is a
-- documented prototype snap, not proof of real stopping accuracy or passenger transport.
function ShuttleService.step(
	state: State,
	route: Route,
	motion: Motion,
	dt: number
): (State, Command, number?)
	assert(finite(dt) and dt > 0 and dt <= 1 / 15, "requires bounded fixed dt")
	assert(finite(motion.distanceStuds) and finite(motion.speedMs), "invalid motion")
	local nextState: State = {
		target = state.target,
		phase = state.phase,
		remaining = state.remaining,
		completedLegs = state.completedLegs,
	}
	local target = route.stops[state.target]
	local error = target.distanceStuds - motion.distanceStuds
	local direction = if error >= 0 then 1 else -1
	local hold: Command = { throttle = 0, brake = 1, reverser = 0, doors = "open" }
	if state.phase == "dwelling" then
		nextState.remaining = math.max(0, state.remaining - dt)
		if nextState.remaining == 0 then
			nextState.phase = "closing"
			nextState.remaining = 1.5
			hold.doors = "close"
		end
		return nextState, hold, nil
	end
	if state.phase == "closing" then
		hold.doors = "close"
		nextState.remaining = math.max(0, state.remaining - dt)
		if nextState.remaining == 0 then
			nextState.target = 3 - state.target
			nextState.phase = "approaching"
		end
		return nextState, hold, nil
	end
	if math.abs(error) <= 0.6 and math.abs(motion.speedMs) <= 0.12 then
		nextState.phase = "dwelling"
		nextState.remaining = route.dwellSeconds
		nextState.completedLegs += 1
		return nextState, hold, target.distanceStuds
	end
	-- Conservative flat-track braking envelope, well below the prototype's service brake.
	local desired =
		math.min(route.maxSpeedMs, math.sqrt(2 * 0.4 * math.max(0, math.abs(error) * 0.28 - 0.1)))
	local speed = math.abs(motion.speedMs)
	local wrongWay = motion.speedMs * direction < -0.01
	local brake = if wrongWay then 1 else math.clamp((speed - desired) * 3, 0, 1)
	local throttle = if brake > 0 or wrongWay
		then 0
		else direction * math.clamp((desired - speed) * 0.9 + 0.04, 0, 0.65)
	-- Never change reverser in motion, including recovery after a manual overshoot.
	local reverser = if speed > 0.01 then (if motion.speedMs > 0 then 1 else -1) else direction
	return nextState,
		{ throttle = throttle, brake = brake, reverser = reverser, doors = "close" },
		nil
end

return ShuttleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Spline</string>
            <string name="Source"><![CDATA[--!strict
--[[
Spline.luau — arc-length parameterised cubic Catmull-Rom spline for railway centre lines.

Pure Luau: no DataModel access, no Roblox globals, testable with lune without Studio.
All units are studs.

Model
-----
A spline is a piecewise cubic curve through a list of control points. Segment i runs from
controlPoints[i] to controlPoints[i+1] (open spline) or wraps around (closed spline) and is
evaluated with the standard centripetal Catmull-Rom formulation, parameterised by t in [0, 1]
over the segment.

Arc length
----------
Each segment is approximated by sampling sub-points and summing chord lengths, giving a
cumulative arc-length table per segment. Mapping arc length s -> (segment, local t) is a
binary search; evaluating at t integrates the same table. Position, tangent and frame normal
are all available in arc-length parameterisation, which is what train movement needs: speed is
studs per second, so the simulation integrates s directly and can never drift off the track.

The arc-length table is an approximation: sub-sample count targets a maximum chord of 1 stud
per segment, so length error is well below a millimetre for typical track segments and far
below train braking tolerances.
--]]

local STUD_PER_METER = 1 / 0.28 -- 1 m = 3.571... studs (docs/STANDARDS.md)

export type Vec3 = {
	x: number,
	y: number,
	z: number,
}

type SubSample = {
	t: number,
	length: number, -- cumulative length within the segment up to this sub-sample
	position: Vec3,
}

type Segment = {
	p0: Vec3,
	p1: Vec3,
	p2: Vec3,
	p3: Vec3,
	subSamples: { SubSample },
	length: number,
	sStart: number,
}

export type Spline = {
	controlPoints: { Vec3 },
	segments: { Segment },
	totalLength: number,
	closed: boolean,
	sample: (self: Spline, t: number) -> Vec3,
	sampleSegment: (self: Spline, segmentIndex: number, t: number) -> Vec3,
	tangent: (self: Spline, t: number) -> Vec3,
	segmentTangent: (self: Spline, segmentIndex: number, t: number) -> Vec3,
	sampleArcLength: (self: Spline, s: number) -> { position: Vec3, tangent: Vec3 },
	arcLengthToT: (self: Spline, s: number) -> { segmentIndex: number, t: number },
	lengthTo: (self: Spline, segmentIndex: number, t: number) -> number,
	addPoint: (self: Spline, point: Vec3) -> number,
	-- distanceToPoint returns the closest point on the spline to a world point, the arc-length
	-- position s of that closest point, and the distance between them. Used by station stop
	-- markers to snap a platform position onto the track centre line.
	distanceToPoint: (self: Spline, point: Vec3) -> { position: Vec3, s: number, distance: number },
}

-- -----------------------------------------------------------------------------
-- Vector helpers (pure)
-- -----------------------------------------------------------------------------

local function vec3(x: number, y: number, z: number): Vec3
	return { x = x, y = y, z = z }
end

local function sub(a: Vec3, b: Vec3): Vec3
	return { x = a.x - b.x, y = a.y - b.y, z = a.z - b.z }
end

local function dot(a: Vec3, b: Vec3): number
	return a.x * b.x + a.y * b.y + a.z * b.z
end

local function len(a: Vec3): number
	return math.sqrt(dot(a, a))
end

-- -----------------------------------------------------------------------------
-- Catmull-Rom segment evaluation
-- -----------------------------------------------------------------------------

local function catmullRom(p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3, t: number): Vec3
	local t2 = t * t
	local t3 = t2 * t
	return {
		x = 0.5
			* (
				(2 * p1.x)
				+ (-p0.x + p2.x) * t
				+ (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2
				+ (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3
			),
		y = 0.5
			* (
				(2 * p1.y)
				+ (-p0.y + p2.y) * t
				+ (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2
				+ (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3
			),
		z = 0.5
			* (
				(2 * p1.z)
				+ (-p0.z + p2.z) * t
				+ (2 * p0.z - 5 * p1.z + 4 * p2.z - p3.z) * t2
				+ (-p0.z + 3 * p1.z - 3 * p2.z + p3.z) * t3
			),
	}
end

local function catmullRomTangent(p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3, t: number): Vec3
	local t2 = t * t
	return {
		x = 0.5
			* (
				(-p0.x + p2.x)
				+ 2 * (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t
				+ 3 * (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t2
			),
		y = 0.5
			* (
				(-p0.y + p2.y)
				+ 2 * (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t
				+ 3 * (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t2
			),
		z = 0.5
			* (
				(-p0.z + p2.z)
				+ 2 * (2 * p0.z - 5 * p1.z + 4 * p2.z - p3.z) * t
				+ 3 * (-p0.z + 3 * p1.z - 3 * p2.z + p3.z) * t2
			),
	}
end

-- -----------------------------------------------------------------------------
-- Segment construction
-- -----------------------------------------------------------------------------

local function clampIndex(index: number, count: number): number
	if index < 1 then
		return 1
	end
	if index > count then
		return count
	end
	return index
end

local function wrapIndex(index: number, count: number): number
	while index < 1 do
		index += count
	end
	while index > count do
		index -= count
	end
	return index
end

local function buildSubSamples(p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3): { SubSample }
	-- Sub-sample count chosen generously; track segments are short enough that this keeps the
	local count = 97
	local samples = table.create(count)
	local previous: Vec3? = nil
	local cumulative = 0
	for k = 0, count - 1 do
		local t = k / (count - 1)
		local position = catmullRom(p0, p1, p2, p3, t)
		if previous ~= nil then
			cumulative += len(sub(position, previous))
		end
		samples[k + 1] = { t = t, length = cumulative, position = position }
		previous = position
	end
	return samples
end

local function segmentLengthAt(samples: { SubSample }, t: number): number
	if t <= 0 then
		return 0
	end
	if t >= 1 then
		return samples[#samples].length
	end
	local count = #samples
	local step = 1 / (count - 1)
	local k = math.floor(t / step)
	if k < 1 then
		k = 1
	end
	if k > count - 1 then
		k = count - 1
	end
	local t0 = (k - 1) * step
	local t1 = k * step
	local s = (t - t0) / (t1 - t0)
	local a = samples[k].length
	local b = samples[k + 1].length
	return a + (b - a) * s
end

local function buildSegment(p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3, sStart: number): Segment
	local samples = buildSubSamples(p0, p1, p2, p3)
	return {
		p0 = p0,
		p1 = p1,
		p2 = p2,
		p3 = p3,
		subSamples = samples,
		length = samples[#samples].length,
		sStart = sStart,
	}
end

-- -----------------------------------------------------------------------------
-- Spline
-- -----------------------------------------------------------------------------

local Spline = {}

local function rebuild(self: Spline)
	local points = self.controlPoints
	local count = #points
	local segments =
		table.create(count > 0 and (self.closed and count or math.max(count - 1, 0)) or 0)
	local sStart = 0
	if count >= 2 then
		for i = 1, (self.closed and count or count - 1) do
			local p0 = points[self.closed and wrapIndex(i - 1, count) or clampIndex(i - 1, count)]
			local p1 = points[i]
			local p2 = points[self.closed and wrapIndex(i + 1, count) or clampIndex(i + 1, count)]
			local p3 = points[self.closed and wrapIndex(i + 2, count) or clampIndex(i + 2, count)]
			local segment = buildSegment(p0, p1, p2, p3, sStart)
			table.insert(segments, segment)
			sStart += segment.length
		end
	end
	self.segments = segments
	self.totalLength = sStart
end

function Spline.sample(self: Spline, t: number): Vec3
	if self.totalLength <= 0 then
		return { x = 0, y = 0, z = 0 }
	end
	if t <= 0 then
		return self.controlPoints[1]
	end
	if t >= 1 then
		return self.controlPoints[#self.controlPoints]
	end
	return self:sampleArcLength(t * self.totalLength).position
end

function Spline.sampleSegment(self: Spline, segmentIndex: number, t: number): Vec3
	if segmentIndex < 1 or segmentIndex > #self.segments then
		return { x = 0, y = 0, z = 0 }
	end
	local segment = self.segments[segmentIndex]
	if t <= 0 then
		return segment.p1
	end
	if t >= 1 then
		return segment.p2
	end
	return catmullRom(segment.p0, segment.p1, segment.p2, segment.p3, t)
end

function Spline.tangent(self: Spline, t: number): Vec3
	return self:sampleArcLength(t * self.totalLength).tangent
end

function Spline.sampleArcLength(self: Spline, s: number): { position: Vec3, tangent: Vec3 }
	if self.totalLength <= 0 then
		return { position = { x = 0, y = 0, z = 0 }, tangent = { x = 0, y = 0, z = 0 } }
	end
	if self.closed then
		while s < 0 do
			s += self.totalLength
		end
		while s > self.totalLength do
			s -= self.totalLength
		end
	else
		if s <= 0 then
			local first = self.controlPoints[1]
			return { position = first, tangent = self:segmentTangent(1, 0) }
		end
		if s >= self.totalLength then
			local last = self.controlPoints[#self.controlPoints]
			local segCount = #self.segments
			return { position = last, tangent = self:segmentTangent(segCount, 1) }
		end
	end

	-- Binary search the segment containing s.
	local segments = self.segments
	local low, high = 1, #segments
	local segmentIndex = 1
	while low <= high do
		local mid = math.floor((low + high) / 2)
		if segments[mid].sStart <= s then
			segmentIndex = mid
			low = mid + 1
		else
			high = mid - 1
		end
	end

	local segment = segments[segmentIndex]
	local localS = s - segment.sStart
	local samples = segment.subSamples
	local count = #samples

	-- Binary search the sub-sample bracket containing localS.
	if localS <= 0 then
		return {
			position = samples[1].position,
			tangent = catmullRomTangent(segment.p0, segment.p1, segment.p2, segment.p3, 0),
		}
	end
	if localS >= segment.length then
		return {
			position = samples[count].position,
			tangent = catmullRomTangent(segment.p0, segment.p1, segment.p2, segment.p3, 1),
		}
	end

	low, high = 1, count - 1
	local bracket = 1
	while low <= high do
		local mid = math.floor((low + high) / 2)
		if samples[mid].length <= localS then
			bracket = mid
			low = mid + 1
		else
			high = mid - 1
		end
	end

	local a = samples[bracket]
	local b = samples[bracket + 1]
	local segSpan = b.length - a.length
	local u = 0
	if segSpan > 0 then
		u = (localS - a.length) / segSpan
	end
	local t = a.t + (b.t - a.t) * u
	local position = catmullRom(segment.p0, segment.p1, segment.p2, segment.p3, t)
	local tangent = catmullRomTangent(segment.p0, segment.p1, segment.p2, segment.p3, t)
	return { position = position, tangent = tangent }
end

function Spline.segmentTangent(self: Spline, segmentIndex: number, t: number): Vec3
	local segment = self.segments[segmentIndex]
	return catmullRomTangent(segment.p0, segment.p1, segment.p2, segment.p3, t)
end

function Spline.arcLengthToT(self: Spline, s: number): { segmentIndex: number, t: number }
	if self.totalLength <= 0 then
		return { segmentIndex = 1, t = 0 }
	end
	if self.closed then
		while s < 0 do
			s += self.totalLength
		end
		while s > self.totalLength do
			s -= self.totalLength
		end
	else
		if s <= 0 then
			return { segmentIndex = 1, t = 0 }
		end
		if s >= self.totalLength then
			return { segmentIndex = #self.segments, t = 1 }
		end
	end
	local segments = self.segments
	local low, high = 1, #segments
	local segmentIndex = 1
	while low <= high do
		local mid = math.floor((low + high) / 2)
		if segments[mid].sStart <= s then
			segmentIndex = mid
			low = mid + 1
		else
			high = mid - 1
		end
	end
	local segment = segments[segmentIndex]
	local localS = s - segment.sStart
	local samples = segment.subSamples
	low, high = 1, #samples - 1
	local bracket = 1
	while low <= high do
		local mid = math.floor((low + high) / 2)
		if samples[mid].length <= localS then
			bracket = mid
			low = mid + 1
		else
			high = mid - 1
		end
	end
	local a = samples[bracket]
	local b = samples[bracket + 1]
	local segSpan = b.length - a.length
	local u = 0
	if segSpan > 0 then
		u = (localS - a.length) / segSpan
	end
	local t = a.t + (b.t - a.t) * u
	return { segmentIndex = segmentIndex, t = t }
end

function Spline.lengthTo(self: Spline, segmentIndex: number, t: number): number
	if segmentIndex < 1 or segmentIndex > #self.segments then
		return 0
	end
	local segment = self.segments[segmentIndex]
	local base = segment.sStart
	if t <= 0 then
		return base
	end
	if t >= 1 then
		return base + segment.length
	end
	return base + segmentLengthAt(segment.subSamples, t)
end

function Spline.addPoint(self: Spline, point: Vec3): number
	table.insert(self.controlPoints, point)
	rebuild(self)
	return #self.controlPoints
end

function Spline.distanceToPoint(
	self: Spline,
	point: Vec3
): { position: Vec3, s: number, distance: number }
	local best: { position: Vec3, s: number, distance: number }? = nil
	for segmentIndex = 1, #self.segments do
		local segment = self.segments[segmentIndex]
		local samples = segment.subSamples
		for k = 1, #samples do
			local distance = len(sub(samples[k].position, point))
			if best == nil or distance < best.distance then
				best = {
					position = samples[k].position,
					s = segment.sStart + samples[k].length,
					distance = distance,
				}
			end
		end
	end
	if best == nil then
		return { position = { x = 0, y = 0, z = 0 }, s = 0, distance = 0 }
	end
	-- Refine around the best sub-sample with a shrinking window search.
	local segmentIndex = 1
	for i = 1, #self.segments do
		if self.segments[i].sStart <= best.s then
			segmentIndex = i
		end
	end
	local segment = self.segments[segmentIndex]
	-- Recover t from the stored sample instead: find sub-sample matching best.position distance.
	-- Simpler: refine in s-space around best.s.
	local searchS = best.s
	local searchStep = math.min(segment.length, 4) -- studs
	for _ = 1, 10 do
		searchStep /= 2
		local candidates = {
			{ s = searchS - searchStep },
			{ s = searchS },
			{ s = searchS + searchStep },
		}
		local improved = false
		for _, c in ipairs(candidates) do
			local s = c.s
			if self.closed then
				while s < 0 do
					s += self.totalLength
				end
				while s > self.totalLength do
					s -= self.totalLength
				end
			elseif s < 0 or s > self.totalLength then
				continue
			end
			local sampled = self:sampleArcLength(s)
			local distance = len(sub(sampled.position, point))
			if distance < best.distance then
				best.distance = distance
				best.position = sampled.position
				best.s = s
				searchS = s
				improved = true
			end
		end
		if not improved then
			break
		end
	end
	return best
end

-- -----------------------------------------------------------------------------
-- Constructor
-- -----------------------------------------------------------------------------

local function new(points: { Vec3 }, closed: boolean?): Spline
	local self: Spline = {
		controlPoints = points,
		segments = {},
		totalLength = 0,
		closed = closed == true,
		sample = Spline.sample,
		sampleSegment = Spline.sampleSegment,
		tangent = Spline.tangent,
		sampleArcLength = Spline.sampleArcLength,
		segmentTangent = Spline.segmentTangent,
		arcLengthToT = Spline.arcLengthToT,
		lengthTo = Spline.lengthTo,
		addPoint = Spline.addPoint,
		distanceToPoint = Spline.distanceToPoint,
	}
	rebuild(self)
	return self
end

return {
	new = new,
	vec3 = vec3,
	STUD_PER_METER = STUD_PER_METER,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">TrainSimulation</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic, single-train driving prototype. It is NOT a Roblox service or signalling system.
-- Server callers must authenticate/rate-limit drivers, supply trustworthy platform/track state,
-- and run bounded fixed ticks. The hard end clamps are a prototype fallback, not real railway ATP.
local TrainSimulation = {}

export type MotionState = { speedMs: number, distanceStuds: number }
export type Command = {
	throttle: number,
	brake: number,
	reverser: number,
	horn: boolean?,
	doors: string?,
}
export type TrainConfig = {
	massKg: number,
	maxTractiveEffortN: number,
	serviceBrakeForceN: number,
	emergencyBrakeForceN: number,
	maxSpeedMs: number,
	rollingResistanceN: number,
	airResistanceCoeff: number,
}

export type Settings = {
	trackLengthStuds: number,
	marginStuds: number,
	commandTimeoutSeconds: number,
	maxSpeedMs: number,
}
export type State = {
	motion: MotionState,
	reverser: number,
	doorsOpen: boolean,
	lastCommand: Command?,
	commandTime: number?,
	intervention: string?,
}

local function finite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

function TrainSimulation.create(Kinematics: any, DriverControl: any)
	local Engine = {}

	function Engine.new(position: number, settings: Settings): State
		assert(
			finite(settings.trackLengthStuds) and settings.trackLengthStuds > 0,
			"invalid track length"
		)
		assert(finite(settings.marginStuds) and settings.marginStuds >= 0, "invalid safety margin")
		assert(
			finite(settings.commandTimeoutSeconds) and settings.commandTimeoutSeconds > 0,
			"invalid timeout"
		)
		assert(finite(settings.maxSpeedMs) and settings.maxSpeedMs > 0, "invalid speed limit")
		assert(
			finite(position) and position >= 0 and position <= settings.trackLengthStuds,
			"invalid position"
		)
		return {
			motion = Kinematics.stopped(position),
			reverser = 0,
			doorsOpen = false,
			lastCommand = nil,
			commandTime = nil,
			intervention = nil,
		}
	end

	-- The caller must perform authorization and rate limiting before this function.
	function Engine.submit(state: State, raw: any, now: number): (State?, string?)
		if not finite(now) or (state.commandTime ~= nil and now < state.commandTime) then
			return nil, "invalid or non-monotonic command time"
		end
		local command, reason = DriverControl.validate(raw)
		if command == nil then
			return nil, reason
		end
		return {
			motion = state.motion,
			reverser = state.reverser,
			doorsOpen = state.doorsOpen,
			lastCommand = command,
			commandTime = now,
			intervention = state.intervention,
		},
			nil
	end

	-- `atPlatform` is a SERVER-DERIVED alignment/permission decision, never a client assertion.
	-- A missing/stale command applies service brake; open doors inhibit traction and hold the brake.
	function Engine.step(
		state: State,
		settings: Settings,
		config: TrainConfig,
		dt: number,
		now: number,
		grade: number,
		atPlatform: boolean
	): State
		assert(finite(dt) and dt > 0 and dt <= 1 / 15, "step requires bounded fixed timestep")
		assert(finite(now) and finite(grade) and math.abs(grade) <= 1, "invalid time or grade")
		local speed = state.motion.speedMs
		local doorsOpen = state.doorsOpen
		local reverser = state.reverser
		local command = state.lastCommand
		local fresh = command ~= nil
			and state.commandTime ~= nil
			and now >= state.commandTime
			and now - state.commandTime <= settings.commandTimeoutSeconds
		local traction = 0
		local brake = 1
		local emergency = false
		local intervention: string? = nil

		if fresh and command then
			if math.abs(speed) <= 0.01 then
				reverser = command.reverser
			elseif command.reverser ~= reverser then
				intervention = "reverser change while moving"
			end
			if command.doors == "close" then
				doorsOpen = false
			elseif command.doors == "open" and math.abs(speed) <= 0.01 and atPlatform then
				doorsOpen = true
			end
			if intervention == nil then
				traction = command.throttle
				brake = command.brake
			end
		else
			intervention = "command timeout"
		end

		if doorsOpen then
			traction = 0
			brake = 1
			intervention = "doors open"
		end
		if math.abs(speed) > settings.maxSpeedMs then
			traction = 0
			brake = 1
			intervention = "speed limit"
		end

		local distanceToEnd = if speed < 0
			then state.motion.distanceStuds
			else settings.trackLengthStuds - state.motion.distanceStuds
		local emergencyStop = Kinematics.stopDistanceStuds(
			state.motion,
			{ tractive = 0, serviceBrake = 0, emergencyBrake = true },
			config,
			grade
		)
		if speed ~= 0 and distanceToEnd <= emergencyStop + settings.marginStuds then
			traction = 0
			brake = 1
			emergency = true
			intervention = "track end"
		end

		-- Do not repeatedly power toward an end while within the stop margin. Reverse power
		-- away from the end remains possible after stopping.
		if
			(state.motion.distanceStuds <= settings.marginStuds and traction < 0)
			or (
				state.motion.distanceStuds >= settings.trackLengthStuds - settings.marginStuds
				and traction > 0
			)
		then
			traction = 0
			brake = 1
			intervention = "track end"
		end

		local motion = Kinematics.integrate(state.motion, dt, {
			tractive = traction,
			serviceBrake = brake,
			emergencyBrake = emergency,
		}, config, grade)
		if motion.distanceStuds < 0 or motion.distanceStuds > settings.trackLengthStuds then
			motion = {
				distanceStuds = math.clamp(motion.distanceStuds, 0, settings.trackLengthStuds),
				speedMs = 0,
			}
			intervention = "track end hard clamp"
		end
		return {
			motion = motion,
			reverser = reverser,
			doorsOpen = doorsOpen,
			lastCommand = state.lastCommand,
			commandTime = state.commandTime,
			intervention = intervention,
		}
	end

	return Engine
end

return TrainSimulation
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">RailDemo</string>
        </Properties>
        <Item class="Script" referent="17">
          <Properties>
            <string name="Name">RailDemo</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[--!strict
-- Experimental single-track shuttle behind the District A placeholder station.
-- Separate from the proposed network: it is not a signalling system or production rail service.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local rail = ReplicatedStorage.Shared.Rail
local Kinematics = require(rail.Kinematics)
local DriverControl = require(rail.DriverControl)
local ControlGate = require(rail.ControlGate)
local BoardingRules = require(rail.BoardingRules)
local ShuttleService = require(rail.ShuttleService)
local Simulation = require(rail.TrainSimulation).create(Kinematics, DriverControl)
local station = require(script.Parent.Parent.World.CityConfig).station

local MIN_X = station.railMinX
local MAX_X = station.railMaxX
local START_DISTANCE = station.centerX - MIN_X
local DT = 1 / 30
local settings = {
	trackLengthStuds = MAX_X - MIN_X,
	marginStuds = 80, -- more than half the prototype's 148.2-stud length
	commandTimeoutSeconds = 0.6,
	maxSpeedMs = 20,
}
local state = Simulation.new(START_DISTANCE, settings)
local dynamics = Kinematics.defaultConfig()
local route = {
	stops = {
		{ id = "garden", name = "West Gardens", distanceStuds = station.westStopX - MIN_X },
		{ id = "central", name = "Civitas Central", distanceStuds = START_DISTANCE },
	},
	dwellSeconds = 18,
	maxSpeedMs = 6,
}
local service = ShuttleService.new(route, state.motion)
local doorFraction = 0
local function currentStop(): ShuttleService.Stop?
	return ShuttleService.atStop(route, state.motion.distanceStuds)
end

local geometry = require(script.Parent.RailGeometry).build(station, Workspace)
local train = geometry.train
local anchor = geometry.anchor
local seat = geometry.seat
local passengerSeats = geometry.passengerSeats
local prompt = geometry.prompt
local passengerPrompt = geometry.passengerPrompt
prompt.Triggered:Connect(function(player: Player)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if
		humanoid
		and root
		and root:IsA("BasePart")
		and humanoid.Health > 0
		and not humanoid.Sit
		and seat.Occupant == nil
		and (root.Position - anchor.Position).Magnitude <= prompt.MaxActivationDistance + 3
		and BoardingRules.canBoard(
			state.doorsOpen,
			state.motion.speedMs,
			currentStop() ~= nil,
			true
		)
	then
		seat:Sit(humanoid)
	end
end)
passengerPrompt.Triggered:Connect(function(player: Player)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if
		not humanoid
		or not root
		or not root:IsA("BasePart")
		or humanoid.Health <= 0
		or humanoid.Sit
	then
		return
	end
	if (root.Position - anchor.Position).Magnitude > passengerPrompt.MaxActivationDistance + 3 then
		return
	end
	local atPlatform = currentStop() ~= nil
	for _, passengerSeat in ipairs(passengerSeats) do
		if
			BoardingRules.canBoard(
				state.doorsOpen,
				state.motion.speedMs,
				atPlatform,
				passengerSeat.Occupant == nil
			)
		then
			passengerSeat:Sit(humanoid)
			return
		end
	end
end)

local remotes = Instance.new("Folder")
remotes.Name = "ExperimentalShuttleRemotes"
remotes.Parent = ReplicatedStorage
local control = Instance.new("RemoteEvent")
control.Name = "Control"
control.Parent = remotes
local snapshot = Instance.new("RemoteEvent")
snapshot.Name = "Snapshot"
snapshot.Parent = remotes
local alight = Instance.new("RemoteEvent")
alight.Name = "Alight"
alight.Parent = remotes

local buckets: { [Player]: ControlGate.Bucket } = {}
local function allow(player: Player, now: number): boolean
	local updated, allowed = ControlGate.consume(buckets[player], now)
	if updated then
		buckets[player] = updated
	end
	return allowed
end
Players.PlayerRemoving:Connect(function(player: Player)
	buckets[player] = nil
end)
control.OnServerEvent:Connect(function(player: Player, raw: any)
	local now = os.clock()
	if not allow(player, now) then
		return
	end
	local occupant = seat.Occupant
	if not ControlGate.authorized(player.Character, if occupant then occupant.Parent else nil) then
		return
	end
	local nextState = Simulation.submit(state, raw, now)
	if nextState then
		state = nextState
	end
end)
alight.OnServerEvent:Connect(function(player: Player)
	if not allow(player, os.clock()) then
		return
	end
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	local isPassenger = false
	for _, passengerSeat in ipairs(passengerSeats) do
		if passengerSeat.Occupant == humanoid then
			isPassenger = true
			break
		end
	end
	local atPlatform = currentStop() ~= nil
	if
		not BoardingRules.canAlight(state.doorsOpen, state.motion.speedMs, atPlatform, isPassenger)
	then
		return
	end
	local destination = currentStop()
	if destination == nil then
		return
	end
	humanoid.Sit = false
	-- Let the seat weld release before repositioning; still requires live Studio verification.
	task.delay(0.1, function()
		if player.Character == character and root.Parent ~= nil and not humanoid.Sit then
			root.CFrame = CFrame.new(
				MIN_X + destination.distanceStuds,
				station.platformTopY + 3,
				station.platformCenterZ - 3
			)
		end
	end)
end)
local accumulator = 0
local ticks = 0
local previousOccupant: Humanoid? = nil
RunService.Heartbeat:Connect(function(elapsed: number)
	accumulator = math.min(accumulator + elapsed, 4 * DT)
	while accumulator >= DT do
		accumulator -= DT
		if seat.Occupant ~= previousOccupant then
			state.lastCommand = nil
			state.commandTime = nil
			previousOccupant = seat.Occupant
			if previousOccupant == nil then
				service = ShuttleService.new(route, state.motion)
			end
		end
		if seat.Occupant == nil then
			local command, docking
			service, command, docking = ShuttleService.step(service, route, state.motion, DT)
			if docking then
				state.motion = { distanceStuds = docking, speedMs = 0 }
			end
			local accepted = Simulation.submit(state, command, os.clock())
			if accepted then
				state = accepted
			end
		end
		local atPlatform = currentStop() ~= nil
		state = Simulation.step(state, settings, dynamics, DT, os.clock(), 0, atPlatform)
		local hasFreeSeat = false
		for _, passengerSeat in ipairs(passengerSeats) do
			if passengerSeat.Occupant == nil then
				hasFreeSeat = true
				break
			end
		end
		local canBoard =
			BoardingRules.canBoard(state.doorsOpen, state.motion.speedMs, atPlatform, hasFreeSeat)
		if passengerPrompt.Enabled ~= canBoard then
			passengerPrompt.Enabled = canBoard
		end
		local pivot = CFrame.new(MIN_X + state.motion.distanceStuds, 0, station.railCenterZ)
		train:PivotTo(pivot)
		-- Only the platform-facing side opens. Door leaves remain visual/non-colliding;
		-- seat admission is still server gated. This is not a walk-through boarding system.
		local desiredFraction = if state.doorsOpen then 1 else 0
		doorFraction += math.clamp(desiredFraction - doorFraction, -DT * 3, DT * 3)
		for _, leaf in ipairs(geometry.doorLeaves) do
			local onPlatformSide = leaf.closed.Position.Z < 0
			local fraction = if onPlatformSide then doorFraction else 0
			leaf.part.CFrame = pivot * leaf.closed * CFrame.new(leaf.slide * fraction, 0, 0)
		end
		prompt.Enabled = BoardingRules.canBoard(
			state.doorsOpen,
			state.motion.speedMs,
			atPlatform,
			seat.Occupant == nil
		)
		ticks += 1
		if ticks % 6 == 0 then
			snapshot:FireAllClients({
				speedKph = math.abs(state.motion.speedMs) * 3.6,
				position = state.motion.distanceStuds,
				atPlatform = atPlatform,
				doorsOpen = state.doorsOpen,
				intervention = state.intervention,
				mode = if seat.Occupant == nil then "automatic" else "manual",
				stopName = if currentStop()
					then (currentStop() :: ShuttleService.Stop).name
					else nil,
				targetName = if seat.Occupant == nil
					then route.stops[service.target].name
					else "Driver-operated shuttle",
				phase = if seat.Occupant == nil then service.phase else "manual",
				dwellRemaining = if seat.Occupant == nil then service.remaining else 0,
				completedLegs = service.completedLegs,
			})
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">RailGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Shared geometry recipe used by the server and the offline Lune/Blender review pipeline.
-- Offline rendering executes this recipe; it does not imply Roblox runtime verification.
local RailGeometry = {}

function RailGeometry.build(station: any, rootParent: Instance)
	local MIN_X = station.railMinX
	local MAX_X = station.railMaxX
	local function part(
		parent: Instance,
		name: string,
		size: Vector3,
		position: Vector3,
		color: Color3,
		material: Enum.Material
	): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Position = position
		p.Color = color
		p.Material = material
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanTouch = false
		p.Parent = parent
		return p
	end

	local function visual(
		parent: Instance,
		name: string,
		size: Vector3,
		position: Vector3,
		color: Color3,
		material: Enum.Material
	): Part
		local p = part(parent, name, size, position, color, material)
		p.CanCollide = false
		p.CanQuery = false
		return p
	end

	local model = Instance.new("Model")
	model.Name = "ExperimentalRailway"
	model:SetAttribute("Status", "Single-track prototype; not the final Civitas network")
	model.Parent = rootParent
	local track = Instance.new("Model")
	track.Name = "TestTrack"
	track.Parent = model
	local centerX = (MIN_X + MAX_X) / 2
	visual(
		track,
		"Ballast",
		Vector3.new(MAX_X - MIN_X, 0.18, 12),
		Vector3.new(centerX, 0.09, station.railCenterZ),
		Color3.fromRGB(92, 86, 76),
		Enum.Material.Slate
	)
	for _, offset in ipairs({ -2.56285, 2.56285 }) do
		visual(
			track,
			"Rail",
			Vector3.new(MAX_X - MIN_X, 0.25, 0.25),
			Vector3.new(centerX, station.railTopY - 0.125, station.railCenterZ + offset),
			Color3.fromRGB(142, 146, 145),
			Enum.Material.Metal
		)
	end
	local sleeperSpacing = 2.1429
	for index = 0, math.floor((MAX_X - MIN_X) / sleeperSpacing) do
		visual(
			track,
			"Sleeper",
			Vector3.new(0.8, 0.22, 9),
			Vector3.new(MIN_X + index * sleeperSpacing, 0.21, station.railCenterZ),
			Color3.fromRGB(82, 68, 54),
			Enum.Material.WoodPlanks
		)
	end

	-- West Gardens is a second provisional halt, not part of the final city network.
	local halt = Instance.new("Model")
	halt.Name = "WestGardensHalt"
	halt.Parent = model
	local westX = station.westStopX
	local function slab(name: string, size: Vector3, pos: Vector3, color: Color3): Part
		return part(halt, name, size, pos, color, Enum.Material.Concrete)
	end
	slab(
		"WestPlatform",
		Vector3.new(200, 0.8, 21),
		Vector3.new(westX, station.platformTopY - 0.4, station.platformCenterZ),
		Color3.fromRGB(184, 179, 165)
	)
	visual(
		halt,
		"WestTactile",
		Vector3.new(200, 0.08, 2.14),
		Vector3.new(westX, station.platformTopY + 0.04, station.platformCenterZ + 9.4),
		Color3.fromRGB(211, 189, 130),
		Enum.Material.Concrete
	)
	-- A forecourt walk and west approach avoid the Central shell and running rail.
	slab(
		"GardenPromenade",
		Vector3.new(math.abs(station.centerX - westX) + 20, 0.5, 12),
		Vector3.new((westX + station.centerX) / 2, 0.38, station.forecourtZ),
		Color3.fromRGB(186, 177, 158)
	)
	local rise = station.platformTopY - 0.63
	local run = 34.5
	slab(
		"GardenAccessWalk",
		Vector3.new(12, 0.5, 1000 - run - station.forecourtZ + 0.2),
		Vector3.new(westX, 0.38, (station.forecourtZ + 1000 - run) / 2),
		Color3.fromRGB(186, 177, 158)
	)
	local angle = math.atan2(rise, run)
	local ramp = slab(
		"WestAccessRamp",
		Vector3.new(20, 0.4, math.sqrt(run * run + rise * rise) + 0.4),
		Vector3.new(
			westX,
			(station.platformTopY + 0.63) / 2 - 0.2 * math.cos(angle),
			1000 - run / 2
		),
		Color3.fromRGB(184, 179, 165)
	)
	ramp.Orientation = Vector3.new(-math.deg(angle), 0, 0)
	ramp:SetAttribute("Walkable", true)
	for _, stop in ipairs({
		{ x = westX, name = "WEST GARDENS" },
		{ x = station.centerX, name = "CIVITAS CENTRAL" },
	}) do
		local board = visual(
			halt,
			"StationName_" .. stop.name,
			Vector3.new(34, 4, 0.45),
			Vector3.new(stop.x, station.platformTopY + 8.5, station.platformCenterZ - 7),
			Color3.fromRGB(28, 51, 55),
			Enum.Material.Metal
		)
		board:SetAttribute("SignText", stop.name)
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local gui = Instance.new("SurfaceGui")
			gui.Face = face
			gui.PixelsPerStud = 32
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.Parent = board
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.TextColor3 = Color3.fromRGB(239, 232, 210)
			text.Font = Enum.Font.BuilderSansBold
			text.TextScaled = true
			text.Text = stop.name
			text.Parent = gui
		end
	end
	for _, offset in ipairs({ -78, -38, 38, 78 }) do
		visual(
			halt,
			"WestCanopyPost",
			Vector3.new(1.2, 12, 1.2),
			Vector3.new(westX + offset, station.platformTopY + 6, station.platformCenterZ - 6),
			Color3.fromRGB(68, 83, 86),
			Enum.Material.Metal
		)
	end
	visual(
		halt,
		"WestCanopy",
		Vector3.new(196, 0.8, 16),
		Vector3.new(westX, station.platformTopY + 12.4, station.platformCenterZ),
		Color3.fromRGB(76, 92, 96),
		Enum.Material.Metal
	)
	for _, offset in ipairs({ -55, 55 }) do
		visual(
			halt,
			"WestBench",
			Vector3.new(9, 0.6, 2.2),
			Vector3.new(westX + offset, station.platformTopY + 1.8, station.platformCenterZ - 3),
			Color3.fromRGB(130, 97, 65),
			Enum.Material.WoodPlanks
		)
	end

	local train = Instance.new("Model")
	train.Name = "ExperimentalShuttle"
	train:SetAttribute("Status", "Prototype geometry; not the imported EMU-1")
	train.Parent = model
	local anchor = visual(
		train,
		"Pivot",
		Vector3.new(1, 1, 1),
		Vector3.new(station.centerX, 0, station.railCenterZ),
		Color3.new(),
		Enum.Material.SmoothPlastic
	)
	anchor.Transparency = 1
	train.PrimaryPart = anchor
	local bodyWidth = 10.1786
	local bodyBottom = station.railTopY + 3
	local bodyHeight = 11.1429
	local totalLength = 75 + 1.7857 + 71.4286
	local carCenters = {
		station.centerX - totalLength / 2 + 37.5,
		station.centerX - totalLength / 2 + 75 + 1.7857 + 71.4286 / 2,
	}
	local carLengths = { 75, 71.4286 }
	local doorLeaves: { { part: Part, closed: CFrame, slide: number } } = {}
	for index, carX in ipairs(carCenters) do
		local length = carLengths[index]
		local car = Instance.new("Model")
		car.Name = if index == 1 then "CabCar" else "IntermediateCar"
		car.Parent = train
		visual(
			car,
			"Floor",
			Vector3.new(length, 0.5, bodyWidth),
			Vector3.new(carX, bodyBottom, station.railCenterZ),
			Color3.fromRGB(81, 87, 84),
			Enum.Material.Metal
		)
		visual(
			car,
			"Roof",
			Vector3.new(length, 0.65, bodyWidth + 0.2),
			Vector3.new(carX, bodyBottom + bodyHeight + 0.325, station.railCenterZ),
			Color3.fromRGB(95, 106, 107),
			Enum.Material.Metal
		)
		for _, endSign in ipairs({ -1, 1 }) do
			visual(
				car,
				"EndWall",
				Vector3.new(0.45, bodyHeight, bodyWidth),
				Vector3.new(
					carX + endSign * length / 2,
					bodyBottom + bodyHeight / 2,
					station.railCenterZ
				),
				Color3.fromRGB(211, 216, 210),
				Enum.Material.Metal
			)
			visual(
				car,
				"EndGlazing",
				Vector3.new(0.5, 3.4, bodyWidth * 0.72),
				Vector3.new(
					carX + endSign * (length / 2 + 0.1),
					bodyBottom + 7.1,
					station.railCenterZ
				),
				Color3.fromRGB(29, 67, 75),
				Enum.Material.Glass
			)
		end
		for _, side in ipairs({ -1, 1 }) do
			local faceZ = station.railCenterZ + side * (bodyWidth / 2 + 0.1)
			local doorWidth = 4.6429
			local spans = {
				{ -length / 2, -length * 0.25 - doorWidth / 2 },
				{ -length * 0.25 + doorWidth / 2, length * 0.25 - doorWidth / 2 },
				{ length * 0.25 + doorWidth / 2, length / 2 },
			}
			for _, span in ipairs(spans) do
				local width = span[2] - span[1]
				local center = carX + (span[1] + span[2]) / 2
				visual(
					car,
					"SidePanel",
					Vector3.new(width, 4.5, 0.35),
					Vector3.new(center, bodyBottom + 2.25, faceZ),
					Color3.fromRGB(211, 216, 210),
					Enum.Material.Metal
				)
				visual(
					car,
					"Window",
					Vector3.new(width - 1, 3.6, 0.25),
					Vector3.new(center, bodyBottom + 6.4, faceZ),
					Color3.fromRGB(29, 67, 75),
					Enum.Material.Glass
				)
				visual(
					car,
					"UpperPanel",
					Vector3.new(width, 2.95, 0.35),
					Vector3.new(center, bodyBottom + 9.675, faceZ),
					Color3.fromRGB(211, 216, 210),
					Enum.Material.Metal
				)
				visual(
					car,
					"LiveryStripe",
					Vector3.new(width, 0.65, 0.38),
					Vector3.new(center, bodyBottom + 3.5, faceZ),
					Color3.fromRGB(155, 57, 48),
					Enum.Material.Metal
				)
			end
			for _, doorX in ipairs({ -length * 0.25, length * 0.25 }) do
				visual(
					car,
					"DoorHeader",
					Vector3.new(doorWidth, bodyHeight - 7.1, 0.35),
					Vector3.new(carX + doorX, bodyBottom + (bodyHeight + 7.1) / 2, faceZ),
					Color3.fromRGB(211, 216, 210),
					Enum.Material.Metal
				)
				for _, leaf in ipairs({ -1, 1 }) do
					local door = visual(
						car,
						"SlidingDoor",
						Vector3.new(doorWidth / 2 - 0.08, 7.1, 0.4),
						Vector3.new(
							carX + doorX + leaf * doorWidth / 4,
							bodyBottom + 3.55,
							faceZ + side * 0.2
						),
						Color3.fromRGB(155, 57, 48),
						Enum.Material.Metal
					)
					table.insert(doorLeaves, {
						part = door,
						closed = CFrame.new(door.Position - anchor.Position),
						slide = leaf * (doorWidth / 2 + 0.1),
					})
				end
			end
		end
		for _, offset in ipairs({ -length / 2 + 10.7143, length / 2 - 10.7143 }) do
			visual(
				car,
				"Bogie",
				Vector3.new(9, 2.5, 8),
				Vector3.new(carX + offset, station.railTopY + 1.5, station.railCenterZ),
				Color3.fromRGB(43, 48, 48),
				Enum.Material.Metal
			)
			for _, axle in ipairs({ -2.5, 2.5 }) do
				for _, side in ipairs({ -1, 1 }) do
					local wheel = visual(
						car,
						"Wheel",
						Vector3.new(0.6, 2.6, 2.6),
						Vector3.new(
							carX + offset + axle,
							station.railTopY + 1.3,
							station.railCenterZ + side * 3.6
						),
						Color3.fromRGB(39, 43, 43),
						Enum.Material.Metal
					)
					wheel.Shape = Enum.PartType.Cylinder
					wheel.Orientation = Vector3.new(0, 90, 0)
				end
			end
		end
	end
	local seat = Instance.new("Seat")
	seat.Name = "CivitasShuttleDriverSeat"
	seat.Size = Vector3.new(3, 1, 3)
	seat.Position = Vector3.new(station.centerX + 55, bodyBottom + 4, station.railCenterZ)
	seat.Anchored = true
	seat.CanCollide = false
	seat.Transparency = 1
	seat.Parent = train
	local passengerSeats: { Seat } = {}
	for index, carX in ipairs(carCenters) do
		for _, offset in ipairs({ -20, 0, 20 }) do
			local passengerSeat = Instance.new("Seat")
			passengerSeat.Name = "PassengerSeat_" .. tostring(index) .. "_" .. tostring(offset)
			passengerSeat.Size = Vector3.new(3, 1, 3)
			passengerSeat.Position = Vector3.new(carX + offset, bodyBottom + 3, station.railCenterZ)
			passengerSeat.Anchored = true
			passengerSeat.CanCollide = false
			passengerSeat.Transparency = 1
			passengerSeat.Parent = train
			visual(
				train,
				"PassengerCushion",
				Vector3.new(3.2, 0.6, 2.5),
				passengerSeat.Position - Vector3.new(0, 0.5, 0),
				Color3.fromRGB(55, 94, 95),
				Enum.Material.Fabric
			)
			visual(
				train,
				"PassengerBack",
				Vector3.new(0.5, 3.2, 2.5),
				passengerSeat.Position + Vector3.new(-1.4, 1, 0),
				Color3.fromRGB(55, 94, 95),
				Enum.Material.Fabric
			)
			table.insert(passengerSeats, passengerSeat)
		end
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Board test shuttle"
	prompt.ObjectText = "Experimental driver seat"
	prompt.MaxActivationDistance = 24
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	local passengerPrompt = Instance.new("ProximityPrompt")
	passengerPrompt.Name = "PassengerBoarding"
	passengerPrompt.ActionText = "Board as passenger"
	passengerPrompt.ObjectText = "Experimental shuttle"
	passengerPrompt.MaxActivationDistance = 24
	passengerPrompt.RequiresLineOfSight = false
	passengerPrompt.Enabled = false
	passengerPrompt.Parent = anchor
	local generatedPartCount = 0
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			generatedPartCount += 1
		end
	end
	model:SetAttribute("GeneratedPartCount", generatedPartCount)
	print(
		string.format(
			"Civitas ExperimentalRailway: %d parts (separate from city count)",
			generatedPartCount
		)
	)

	return {
		model = model,
		train = train,
		anchor = anchor,
		seat = seat,
		passengerSeats = passengerSeats,
		prompt = prompt,
		passengerPrompt = passengerPrompt,
		doorLeaves = doorLeaves,
	}
end
return RailGeometry
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">CityBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Converts the pure city plan into anchored, collidable Roblox geometry. No per-frame work.
local FacadeMath = require(script.Parent.FacadeMath)
local CityBuilder = {}

local function createPart(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	material: Enum.Material,
	color: Color3
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Anchored = true
	part.CanCollide = true
	part.CanTouch = false
	part.CanQuery = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = material
	part.Color = color
	part.Parent = parent
	return part
end

local function makeModel(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

local function axisSize(axis: string, length: number, width: number, height: number): Vector3
	if axis == "x" then
		return Vector3.new(length, height, width)
	end
	return Vector3.new(width, height, length)
end

local function buildStreet(
	parent: Instance,
	street: any,
	config: any,
	intersections: { any },
	layer: number
)
	-- Separate overlapping road/sidewalk recipe surfaces by tiny deterministic layers.
	-- This avoids coplanar z-fighting without materially changing the walk datum.
	local function streetPart(
		parentModel: Instance,
		name: string,
		size: Vector3,
		position: Vector3,
		material: Enum.Material,
		color: Color3
	): Part
		return createPart(
			parentModel,
			name,
			size,
			position + Vector3.new(0, layer, 0),
			material,
			color
		)
	end

	if street.axis == "segment" then
		local dx = street.finishX - street.startX
		local dz = street.finishZ - street.startZ
		local length = math.sqrt(dx * dx + dz * dz)
		local yaw = math.deg(math.atan2(dx, dz))
		local midpointX = (street.startX + street.finishX) / 2
		local midpointZ = (street.startZ + street.finishZ) / 2
		local perpendicularX = dz / length
		local perpendicularZ = -dx / length
		local road = streetPart(
			parent,
			street.name .. "_Carriageway",
			Vector3.new(street.width, 0.3, length),
			Vector3.new(midpointX, 0.17, midpointZ),
			Enum.Material.Asphalt,
			Color3.fromRGB(72, 75, 77)
		)
		road.Orientation = Vector3.new(0, yaw, 0)
		road:SetAttribute("StreetKind", "narrow diagonal lane")
		for side = -1, 1, 2 do
			local sidewalkOffset = street.width / 2 + config.streets.sidewalkWidth / 2
			local curbOffset = street.width / 2
				+ config.streets.sidewalkWidth
				+ config.streets.curbWidth / 2
			local sidewalk = streetPart(
				parent,
				street.name .. "_Sidewalk_" .. tostring(side),
				Vector3.new(config.streets.sidewalkWidth, 0.4, length),
				Vector3.new(
					midpointX + side * perpendicularX * sidewalkOffset,
					0.22,
					midpointZ + side * perpendicularZ * sidewalkOffset
				),
				Enum.Material.Concrete,
				Color3.fromRGB(184, 179, 165)
			)
			sidewalk.Orientation = Vector3.new(0, yaw, 0)
			sidewalk:SetAttribute("Walkable", true)
			local curb = streetPart(
				parent,
				street.name .. "_Curb_" .. tostring(side),
				Vector3.new(config.streets.curbWidth, config.streets.curbHeight, length),
				Vector3.new(
					midpointX + side * perpendicularX * curbOffset,
					0.18,
					midpointZ + side * perpendicularZ * curbOffset
				),
				Enum.Material.Concrete,
				Color3.fromRGB(126, 124, 117)
			)
			curb.Orientation = Vector3.new(0, yaw, 0)
			curb:SetAttribute("AccessibleCornerRadius", config.streets.cornerRadius)
		end
		return
	end

	local length = street.finish - street.start
	local center = (street.start + street.finish) / 2
	local roadColor = if street.kind == "arterial"
		then Color3.fromRGB(62, 66, 69)
		else Color3.fromRGB(72, 75, 77)
	local road = streetPart(
		parent,
		"Carriageway_" .. street.axis .. "_" .. tostring(street.center),
		axisSize(street.axis, length, street.width, 0.3),
		if street.axis == "x"
			then Vector3.new(center, 0.16, street.center)
			else Vector3.new(street.center, 0.15, center),
		Enum.Material.Asphalt,
		roadColor
	)
	road:SetAttribute("StreetKind", street.kind)

	for side = -1, 1, 2 do
		local offset = street.width / 2 + config.streets.sidewalkWidth / 2
		local curbOffset = street.width / 2
			+ config.streets.sidewalkWidth
			+ config.streets.curbWidth / 2
		local sidewalkCenter = street.center + side * offset
		local curbCenter = street.center + side * curbOffset
		local sidewalk = streetPart(
			parent,
			"Sidewalk_" .. street.axis .. "_" .. tostring(street.center) .. "_" .. tostring(side),
			axisSize(street.axis, length, config.streets.sidewalkWidth, 0.4),
			if street.axis == "x"
				then Vector3.new(center, 0.21, sidewalkCenter)
				else Vector3.new(sidewalkCenter, 0.2, center),
			Enum.Material.Concrete,
			Color3.fromRGB(184, 179, 165)
		)
		sidewalk:SetAttribute("Walkable", true)
		local curbGaps = {}
		for _, intersection in ipairs(intersections) do
			local matches = if street.axis == "z"
				then intersection.x == street.center
				else intersection.z == street.center
			if matches then
				local coordinate = if street.axis == "z" then intersection.z else intersection.x
				local crossingWidth = if street.axis == "z"
					then intersection.widthZ
					else intersection.widthX
				local halfGap = crossingWidth / 2 + intersection.radius
				table.insert(
					curbGaps,
					{ start = coordinate - halfGap, finish = coordinate + halfGap }
				)
			end
		end
		table.sort(curbGaps, function(a, b)
			return a.start < b.start
		end)
		local cursor = street.start
		local piece = 0
		for _, gap in ipairs(curbGaps) do
			local gapStart = math.max(street.start, gap.start)
			local gapFinish = math.min(street.finish, gap.finish)
			if gapStart > cursor then
				piece += 1
				local curbLength = gapStart - cursor
				local curbCenterline = (gapStart + cursor) / 2
				local curb = streetPart(
					parent,
					"CurbReturn_"
						.. street.axis
						.. "_"
						.. tostring(street.center)
						.. "_"
						.. tostring(side)
						.. "_"
						.. tostring(piece),
					axisSize(
						street.axis,
						curbLength,
						config.streets.curbWidth,
						config.streets.curbHeight
					),
					if street.axis == "x"
						then Vector3.new(curbCenterline, 0.18, curbCenter)
						else Vector3.new(curbCenter, 0.18, curbCenterline),
					Enum.Material.Concrete,
					Color3.fromRGB(126, 124, 117)
				)
				curb:SetAttribute("AccessibleCornerRadius", config.streets.cornerRadius)
			end
			cursor = math.max(cursor, gapFinish)
		end
		if cursor < street.finish then
			piece += 1
			local curbLength = street.finish - cursor
			local curbCenterline = (street.finish + cursor) / 2
			local curb = streetPart(
				parent,
				"CurbReturn_"
					.. street.axis
					.. "_"
					.. tostring(street.center)
					.. "_"
					.. tostring(side)
					.. "_"
					.. tostring(piece),
				axisSize(
					street.axis,
					curbLength,
					config.streets.curbWidth,
					config.streets.curbHeight
				),
				if street.axis == "x"
					then Vector3.new(curbCenterline, 0.18, curbCenter)
					else Vector3.new(curbCenter, 0.18, curbCenterline),
				Enum.Material.Concrete,
				Color3.fromRGB(126, 124, 117)
			)
			curb:SetAttribute("AccessibleCornerRadius", config.streets.cornerRadius)
		end
	end
end

local function buildBuilding(parent: Instance, building: any, palette: any)
	local model = makeModel(parent, building.name)
	model:SetAttribute("Typology", building.style)
	model:SetAttribute("Landmark", building.landmark)
	model:SetAttribute("Frontage", building.frontage or "monumental-entry")
	local color = palette[building.style] or Color3.fromRGB(181, 164, 139)
	local groundHeight = math.min(10, building.height / 3)
	local upperHeight = building.height - groundHeight
	local groundColor = if building.frontage == "shopfront"
		then Color3.fromRGB(83, 104, 106)
		elseif building.frontage == "recessed-entry" then Color3.fromRGB(112, 98, 80)
		elseif building.frontage == "awning" then Color3.fromRGB(151, 119, 84)
		else Color3.fromRGB(139, 129, 111)
	local groundStorey = createPart(
		model,
		"GroundStorey_DarkerStreetBand",
		Vector3.new(building.width, groundHeight, building.depth),
		Vector3.new(building.x, groundHeight / 2, building.z),
		Enum.Material.Brick,
		groundColor
	)
	groundStorey.Orientation = Vector3.new(0, building.rotation, 0)
	local upper = createPart(
		model,
		"UpperMassing",
		Vector3.new(building.width, upperHeight, building.depth),
		Vector3.new(building.x, groundHeight + upperHeight / 2, building.z),
		Enum.Material.Brick,
		color
	)
	upper.Orientation = Vector3.new(0, building.rotation, 0)

	local function facadePart(
		name: string,
		localX: number,
		localY: number,
		localZ: number,
		size: Vector3,
		partColor: Color3,
		material: Enum.Material
	)
		local worldX, worldZ =
			FacadeMath.worldPoint(building.x, building.z, building.rotation, localX, localZ)
		local part =
			createPart(model, name, size, Vector3.new(worldX, localY, worldZ), material, partColor)
		part.Orientation = Vector3.new(0, building.rotation, 0)
		-- These are visual overlays on the solid ground-storey mass, not entrances or
		-- walkable surfaces. Protruding awnings must not snag characters or raycasts.
		part.CanCollide = false
		part.CanQuery = false
		return part
	end

	if not building.landmark then
		-- Non-colliding window overlays on both long faces. Storey spacing scales with
		-- the massing height; these are not openings into a building interior.
		local windowRows = math.max(1, math.floor((upperHeight - 2) / 8))
		for _, side in ipairs({ -1, 1 }) do
			for row = 1, windowRows do
				for _, column in ipairs({ -0.3, 0, 0.3 }) do
					facadePart(
						"UpperWindow",
						building.width * column,
						groundHeight + upperHeight * (row - 0.5) / windowRows,
						side * (building.depth / 2 + 0.18),
						Vector3.new(
							math.min(4, building.width * 0.18),
							math.min(4, upperHeight / windowRows * 0.52),
							0.4
						),
						Color3.fromRGB(81, 110, 116),
						Enum.Material.Glass
					)
				end
			end
		end
		if building.frontage == "shopfront" then
			facadePart(
				"DisplayWindow_Left",
				-building.width * 0.24,
				groundHeight * 0.58,
				-building.depth / 2 - 0.15,
				Vector3.new(building.width * 0.28, 4, 0.35),
				Color3.fromRGB(104, 145, 148),
				Enum.Material.Glass
			)
			facadePart(
				"DisplayWindow_Right",
				building.width * 0.24,
				groundHeight * 0.58,
				-building.depth / 2 - 0.15,
				Vector3.new(building.width * 0.28, 4, 0.35),
				Color3.fromRGB(104, 145, 148),
				Enum.Material.Glass
			)
			facadePart(
				"RecessedShopDoor",
				0,
				groundHeight * 0.42,
				-building.depth / 2 - 0.22,
				Vector3.new(4, groundHeight * 0.72, 0.45),
				Color3.fromRGB(54, 63, 62),
				Enum.Material.WoodPlanks
			)
			facadePart(
				"CanvasAwning",
				0,
				groundHeight * 0.96,
				-building.depth / 2 - 1.35,
				Vector3.new(building.width * 0.88, 1, 2.4),
				Color3.fromRGB(154, 91, 68),
				Enum.Material.Fabric
			)
		elseif building.frontage == "recessed-entry" then
			facadePart(
				"RecessedDoor",
				0,
				groundHeight * 0.4,
				-building.depth / 2 - 0.15,
				Vector3.new(4, groundHeight * 0.72, 0.3),
				Color3.fromRGB(63, 58, 52),
				Enum.Material.WoodPlanks
			)
			facadePart(
				"EntryLintel",
				0,
				groundHeight * 0.88,
				-building.depth / 2 - 0.22,
				Vector3.new(7, 1.3, 0.45),
				Color3.fromRGB(157, 142, 116),
				Enum.Material.Slate
			)
		elseif building.frontage == "awning" then
			facadePart(
				"SingleShopAwning",
				0,
				groundHeight * 0.9,
				-building.depth / 2 - 1.1,
				Vector3.new(building.width * 0.58, 0.8, 2),
				Color3.fromRGB(114, 124, 102),
				Enum.Material.Fabric
			)
		end
	end

	if not building.landmark then
		local roof = createPart(
			model,
			"RoofCap",
			Vector3.new(math.max(4, building.width - 2), 1.5, math.max(4, building.depth - 2)),
			Vector3.new(building.x, building.height + 0.75, building.z),
			Enum.Material.Slate,
			Color3.fromRGB(80, 70, 65)
		)
		roof.Orientation = Vector3.new(0, building.rotation, 0)
	else
		local roofHeight = if building.style == "tower" then 8 else 3
		createPart(
			model,
			"Crown",
			Vector3.new(building.width * 0.42, roofHeight, building.depth * 0.42),
			Vector3.new(building.x, building.height + roofHeight / 2, building.z),
			Enum.Material.Slate,
			Color3.fromRGB(104, 76, 54)
		)
		if building.style == "tower" then
			createPart(
				model,
				"Lantern",
				Vector3.new(7, 12, 7),
				Vector3.new(building.x, building.height + 14, building.z),
				Enum.Material.Metal,
				Color3.fromRGB(73, 82, 84)
			)
		end
	end
	return model
end

local function buildWalkLink(parent: Instance, first: any, last: any, index: number)
	local dx = last.x - first.x
	local dz = last.z - first.z
	local length = math.sqrt(dx * dx + dz * dz)
	local midpoint =
		Vector3.new((first.x + last.x) / 2, 0.43 + index * 0.003, (first.z + last.z) / 2)
	local slab = createPart(
		parent,
		"RouteLink_" .. tostring(index) .. "_" .. first.label,
		Vector3.new(7, 0.25, length + 0.25),
		midpoint,
		Enum.Material.Concrete,
		Color3.fromRGB(195, 190, 176)
	)
	slab.Orientation = Vector3.new(0, math.deg(math.atan2(dx, dz)), 0)
	slab:SetAttribute("Walkable", true)
end

local function buildStation(parent: Instance, station: any, palette: any)
	local model = makeModel(parent, "CentralStation_WalkablePlaceholder")
	model:SetAttribute("InterfaceStatus", "City shell only; station architecture handoff pending")
	local x = station.centerX
	local entry = station.entryZ
	createPart(
		model,
		"ConcourseFloor",
		Vector3.new(station.width - 20, 0.5, station.depth * 0.55),
		Vector3.new(x, 0.38, station.concourseZ),
		Enum.Material.Marble,
		Color3.fromRGB(186, 177, 158)
	)
	for side = -1, 1, 2 do
		createPart(
			model,
			"ConcourseSideWall_" .. tostring(side),
			Vector3.new(8, 19, station.depth * 0.55),
			Vector3.new(x + side * (station.width / 2 - 7), 9.5, station.concourseZ),
			Enum.Material.Brick,
			palette.civic
		)
	end
	-- Open a central doorway to the experimental platform. The existing building shell is
	-- provisional and will still need reconciliation with the final station asset.
	local openingWidth = 24
	local wallWidth = (station.width - 22 - openingWidth) / 2
	local rearZ = station.concourseZ + station.depth * 0.275
	for side = -1, 1, 2 do
		createPart(
			model,
			"StationRearWall_" .. tostring(side),
			Vector3.new(wallWidth, 19, 8),
			Vector3.new(x + side * (openingWidth / 2 + wallWidth / 2), 9.5, rearZ),
			Enum.Material.Brick,
			palette.civic
		)
	end
	createPart(
		model,
		"StationRearLintel",
		Vector3.new(openingWidth, 5, 8),
		Vector3.new(x, 16.5, rearZ),
		Enum.Material.Brick,
		palette.civic
	)
	-- A small, original architectural pass on the provisional shell. Keep openings clear;
	-- all trims are visual/non-colliding and do not change the accepted walk surfaces.
	local function detail(
		name: string,
		size: Vector3,
		position: Vector3,
		color: Color3,
		material: Enum.Material
	): Part
		local p = createPart(model, name, size, position, material, color)
		p.CanCollide = false
		p.CanQuery = false
		return p
	end
	local stone = Color3.fromRGB(206, 196, 174)
	local metal = Color3.fromRGB(68, 83, 86)
	detail(
		"ConcourseRoof",
		Vector3.new(station.width - 4, 1.2, station.depth * 0.55 + 8),
		Vector3.new(x, 20.2, station.concourseZ),
		metal,
		Enum.Material.Metal
	)
	detail(
		"StationRearCornice",
		Vector3.new(station.width - 4, 1.1, 2),
		Vector3.new(x, 18.9, rearZ + 4.8),
		stone,
		Enum.Material.Marble
	)
	for _, offset in ipairs({ -66, -44, 44, 66 }) do
		detail(
			"StationRearWindow",
			Vector3.new(9, 8, 0.25),
			Vector3.new(x + offset, 10.4, rearZ + 4.15),
			Color3.fromRGB(42, 68, 72),
			Enum.Material.Glass
		)
		detail(
			"StationWindowSill",
			Vector3.new(10.5, 0.7, 1),
			Vector3.new(x + offset, 6.1, rearZ + 4.5),
			stone,
			Enum.Material.Marble
		)
	end
	for _, offset in ipairs({ -75, -55, -33, 33, 55, 75 }) do
		detail(
			"StationRearPilaster",
			Vector3.new(2, 17.5, 0.7),
			Vector3.new(x + offset, 8.75, rearZ + 4.4),
			stone,
			Enum.Material.Marble
		)
	end
	detail(
		"PorticoEntablature",
		Vector3.new(136, 3, 7),
		Vector3.new(x, 21.5, entry - 18),
		stone,
		Enum.Material.Marble
	)
	detail(
		"PorticoRoof",
		Vector3.new(140, 0.8, 47),
		Vector3.new(x, 23.4, entry + 2),
		metal,
		Enum.Material.Metal
	)
	local board = detail(
		"CentralStationName",
		Vector3.new(54, 4, 0.5),
		Vector3.new(x, 21.3, entry - 21.6),
		Color3.fromRGB(28, 51, 55),
		Enum.Material.Metal
	)
	board:SetAttribute("SignText", "CIVITAS CENTRAL")
	local sign = Instance.new("SurfaceGui")
	sign.Face = Enum.NormalId.Front
	sign.PixelsPerStud = 24
	sign.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sign.Parent = board
	local lettering = Instance.new("TextLabel")
	lettering.Size = UDim2.fromScale(1, 1)
	lettering.BackgroundTransparency = 1
	lettering.TextColor3 = Color3.fromRGB(239, 232, 210)
	lettering.Font = Enum.Font.BuilderSansBold
	lettering.TextScaled = true
	lettering.Text = "CIVITAS CENTRAL"
	lettering.Parent = sign
	local startTop = 0.63
	local rise = station.platformTopY - startTop
	local run = station.rampEndZ - station.rampStartZ
	local angle = math.atan2(rise, run)
	local ramp = createPart(
		model,
		"PlatformAccessRamp",
		Vector3.new(20, 0.4, math.sqrt(run * run + rise * rise) + 0.4),
		Vector3.new(
			x,
			(startTop + station.platformTopY) / 2 - 0.2 * math.cos(angle),
			(station.rampStartZ + station.rampEndZ) / 2
		),
		Enum.Material.Concrete,
		Color3.fromRGB(184, 179, 165)
	)
	ramp.Orientation = Vector3.new(-math.deg(angle), 0, 0)
	ramp:SetAttribute("Walkable", true)
	local platform = createPart(
		model,
		"ExperimentalPlatform",
		Vector3.new(station.platformWidth, 0.8, station.platformDepth),
		Vector3.new(x, station.platformTopY - 0.4, station.platformCenterZ),
		Enum.Material.Concrete,
		Color3.fromRGB(184, 179, 165)
	)
	platform:SetAttribute("Walkable", true)
	local tactile = createPart(
		model,
		"ExperimentalPlatformTactile",
		Vector3.new(station.platformWidth, 0.08, 2.14),
		Vector3.new(
			x,
			station.platformTopY + 0.04,
			station.platformCenterZ + station.platformDepth / 2 - 1.1
		),
		Enum.Material.Concrete,
		Color3.fromRGB(211, 189, 130)
	)
	tactile.CanCollide = false
	tactile.CanQuery = false
	for _, offset in ipairs({ -80, -40, 40, 80 }) do
		createPart(
			model,
			"PlatformCanopyColumn_" .. tostring(offset),
			Vector3.new(1.2, 12, 1.2),
			Vector3.new(x + offset, station.platformTopY + 6, station.platformCenterZ - 5),
			Enum.Material.Metal,
			Color3.fromRGB(68, 83, 86)
		)
	end
	createPart(
		model,
		"PlatformCanopy",
		Vector3.new(station.platformWidth - 4, 0.8, station.platformDepth - 5),
		Vector3.new(x, station.platformTopY + 12.4, station.platformCenterZ),
		Enum.Material.Metal,
		Color3.fromRGB(76, 92, 96)
	)
	for _, offset in ipairs({ -50, 50 }) do
		local bench = createPart(
			model,
			"PlatformBenchSeat_" .. tostring(offset),
			Vector3.new(9, 0.5, 2),
			Vector3.new(x + offset, station.platformTopY + 1.8, station.platformCenterZ - 2),
			Enum.Material.WoodPlanks,
			Color3.fromRGB(130, 97, 65)
		)
		bench.CanCollide = false
		bench.CanQuery = false
		for _, side in ipairs({ -1, 1 }) do
			local support = createPart(
				model,
				"PlatformBenchSupport",
				Vector3.new(0.5, 1.6, 1.8),
				Vector3.new(
					x + offset + side * 3.5,
					station.platformTopY + 0.8,
					station.platformCenterZ - 2
				),
				Enum.Material.Metal,
				Color3.fromRGB(68, 83, 86)
			)
			support.CanCollide = false
			support.CanQuery = false
		end
	end
	for _, offset in ipairs({ -56, -28, 28, 56 }) do
		createPart(
			model,
			"ForecourtColonnade_" .. tostring(offset),
			Vector3.new(5, 20, 5),
			Vector3.new(x + offset, 10, entry - 18),
			Enum.Material.Marble,
			Color3.fromRGB(206, 196, 174)
		)
	end
	return model
end

function CityBuilder.build(plan: any, config: any, rootParent: Instance): Model
	local old = rootParent:FindFirstChild("CivitasWorld")
	if old then
		old:Destroy()
	end
	local world = makeModel(rootParent, "CivitasWorld")
	world:SetAttribute("GeneratorVersion", "0.1.0")
	world:SetAttribute("Slice", "District A Historic Centre + central station approach")
	world:SetAttribute("PlannedBuildingCount", plan.stats.buildingCount)

	local city = makeModel(world, "City")
	local district = makeModel(city, "DistrictA_HistoricCentreSlice")
	district:SetAttribute("MinX", plan.districtBounds[1].minX)
	district:SetAttribute("MaxX", plan.districtBounds[1].maxX)
	district:SetAttribute("MinZ", plan.districtBounds[1].minZ)
	district:SetAttribute("MaxZ", plan.districtBounds[1].maxZ)
	local terrain = createPart(
		district,
		"CollidableGround",
		Vector3.new(config.ground.width, config.ground.thickness, config.ground.depth),
		Vector3.new(config.ground.centerX, -config.ground.thickness / 2, config.ground.centerZ),
		Enum.Material.Ground,
		Color3.fromRGB(91, 113, 76)
	)
	terrain:SetAttribute("GroundCoverage", "continuous slice base; no void beneath roads or plots")

	local streetsModel = makeModel(district, "Streets")
	for index, street in ipairs(plan.streets) do
		buildStreet(streetsModel, street, config, plan.intersections, index * 0.0005)
	end
	local buildingsModel = makeModel(district, "BuildingMassing")
	local palette = {
		["historic-terrace"] = Color3.fromRGB(186, 164, 133),
		["corner-shop"] = Color3.fromRGB(195, 177, 148),
		church = Color3.fromRGB(177, 166, 145),
		market = Color3.fromRGB(162, 131, 99),
		civic = Color3.fromRGB(194, 182, 155),
		tower = Color3.fromRGB(174, 157, 131),
		hotel = Color3.fromRGB(184, 168, 144),
	}
	for _, building in ipairs(plan.buildings) do
		buildBuilding(buildingsModel, building, palette)
	end
	for _, landmark in ipairs(plan.landmarks) do
		buildBuilding(buildingsModel, landmark, palette)
	end

	local publicRealm = makeModel(district, "PublicRealm")
	local plaza = createPart(
		publicRealm,
		"OldTownSquare",
		Vector3.new(plan.plaza.width, 0.45, plan.plaza.depth),
		Vector3.new(plan.plaza.centerX, 0.35, plan.plaza.centerZ),
		Enum.Material.Cobblestone,
		Color3.fromRGB(151, 143, 125)
	)
	plaza:SetAttribute("Walkable", true)
	local pocketSquares = makeModel(publicRealm, "IrregularPocketSquares")
	for _, square in ipairs(plan.pocketSquares) do
		local paving = createPart(
			pocketSquares,
			square.name:gsub(" ", "") .. "_Paving",
			Vector3.new(square.width, 0.45, square.depth),
			Vector3.new(square.centerX, 0.34, square.centerZ),
			Enum.Material.Cobblestone,
			Color3.fromRGB(164, 153, 130)
		)
		paving:SetAttribute("Walkable", true)
		paving:SetAttribute("IrregularJunctionSquare", true)
	end
	local fountain = createPart(
		publicRealm,
		"SquareFountainBasin",
		Vector3.new(1.1, 18, 18),
		Vector3.new(plan.plaza.centerX, 0.95, plan.plaza.centerZ + 28),
		Enum.Material.Slate,
		Color3.fromRGB(112, 126, 128)
	)
	fountain.Shape = Enum.PartType.Cylinder
	fountain.Orientation = Vector3.new(0, 0, 90)
	fountain:SetAttribute("CollisionNote", "Low decorative basin; route passes west of basin")
	local station = buildStation(makeModel(district, "Stations"), plan.station, palette)
	local walkways = makeModel(publicRealm, "AcceptanceWalkRoute")
	for index = 2, #plan.route do
		buildWalkLink(walkways, plan.route[index - 1], plan.route[index], index - 1)
	end
	walkways:SetAttribute("AcceptanceLengthStuds", plan.stats.routeLength)
	walkways:SetAttribute(
		"AcceptanceSequence",
		"sidewalk > grid > public square > forecourt > concourse"
	)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CoreSidewalkSpawn"
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = Vector3.new(plan.route[1].x, 0.65, plan.route[1].z)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = Enum.Material.Concrete
	spawn.Color = Color3.fromRGB(176, 166, 145)
	spawn.Parent = publicRealm
	spawn:SetAttribute("AcceptanceStart", true)
	station:SetAttribute("AcceptanceDestination", "concourse")

	local actualPartCount = 0
	for _, descendant in ipairs(world:GetDescendants()) do
		if descendant:IsA("BasePart") then
			actualPartCount += 1
		end
	end
	world:SetAttribute("EstimatedGeneratedParts", plan.stats.estimatedParts)
	world:SetAttribute("GeneratedPartCount", actualPartCount)
	return world
end

return CityBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
