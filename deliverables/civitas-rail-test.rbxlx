            <string name="Name">GeometryContract</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GeometryContract — ratified dimensional constants (Manager A, 2026-11-01).

	Single source of truth for every physical interface between art and code.
	Mirrors docs/ASSET-INTERFACES.md. Change only by PR with Manager approval.

	Units: all values are in ROBLOX STUDS unless the field name ends in `M` (metres).
]]

local GeometryContract = {}

-- 1 m = 3.5714286 studs (Roblox default 0.28 m/stud)
GeometryContract.STUDS_PER_METRE = 1 / 0.28 :: number

-- §2 Permanent way -----------------------------------------------------------
GeometryContract.RAIL_GAUGE = 1.435 * GeometryContract.STUDS_PER_METRE -- 5.1257
GeometryContract.RAIL_HEAD_WIDTH = 0.07 * GeometryContract.STUDS_PER_METRE
GeometryContract.SLEEPER_SPACING = 0.6 * GeometryContract.STUDS_PER_METRE
GeometryContract.MIN_CURVE_RADIUS_RUNNING = 120 * GeometryContract.STUDS_PER_METRE
GeometryContract.MIN_CURVE_RADIUS_DEPOT = 60 * GeometryContract.STUDS_PER_METRE
GeometryContract.MAX_GRADIENT = 0.025
GeometryContract.TRACK_CENTRE_SPACING = 3.4 * GeometryContract.STUDS_PER_METRE

-- §3 Platforms ---------------------------------------------------------------
GeometryContract.PLATFORM_TOP_ABOVE_RAIL = 0.76 * GeometryContract.STUDS_PER_METRE
GeometryContract.PLATFORM_EDGE_SETBACK = 1.7 * GeometryContract.STUDS_PER_METRE
GeometryContract.PLATFORM_MIN_ISLAND_WIDTH = 6.0 * GeometryContract.STUDS_PER_METRE
GeometryContract.CANOPY_CLEARANCE = 3.2 * GeometryContract.STUDS_PER_METRE
GeometryContract.TACTILE_STRIP_WIDTH = 0.6 * GeometryContract.STUDS_PER_METRE

-- §4 Rolling stock -----------------------------------------------------------
GeometryContract.CAR_WIDTH = 2.85 * GeometryContract.STUDS_PER_METRE
GeometryContract.CAR_HEIGHT_ABOVE_RAIL = 4.1 * GeometryContract.STUDS_PER_METRE
GeometryContract.CLEARANCE_WIDTH = 3.2 * GeometryContract.STUDS_PER_METRE
GeometryContract.CLEARANCE_HEIGHT = 4.6 * GeometryContract.STUDS_PER_METRE
GeometryContract.CAB_CAR_LENGTH = 21.0 * GeometryContract.STUDS_PER_METRE
GeometryContract.INTERMEDIATE_CAR_LENGTH = 20.0 * GeometryContract.STUDS_PER_METRE
GeometryContract.INTER_CAR_GAP = 0.5 * GeometryContract.STUDS_PER_METRE
GeometryContract.DOOR_WIDTH = 1.3 * GeometryContract.STUDS_PER_METRE
GeometryContract.DOOR_HEIGHT = 1.95 * GeometryContract.STUDS_PER_METRE
GeometryContract.DOOR_TRAVEL = 1.35 * GeometryContract.STUDS_PER_METRE
GeometryContract.BOGIE_CENTRES_FROM_END = 3.0 * GeometryContract.STUDS_PER_METRE
GeometryContract.WHEEL_DIAMETER = 0.84 * GeometryContract.STUDS_PER_METRE
GeometryContract.KIT_MODULE_LENGTH = 4.0 * GeometryContract.STUDS_PER_METRE

-- §5 Pivots: car root is at rail-top level on the centreline at the leading
-- coupling face. Expressed here so code and art agree without interpretation.
GeometryContract.CAR_ROOT_Y = 0 -- rail top datum
GeometryContract.BOGIE_PIVOT_Y = 0

export type Geometry = typeof(GeometryContract)

return table.freeze(GeometryContract)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">RailContract</string>
            <string name="Source"><![CDATA[--!strict
--[[
RailContract.luau — PROPOSED rail types.

OWNERSHIP: src/shared/Contracts/** is Manager A-owned. This file is a PROPOSAL by CODE · vector;
it is not merged or frozen until the Manager ratifies it in the PR thread, after agreement with
CODE · lumen (who implements the client side).

CONTENTS: types only — TrainState, TrainCommand, TrackSegment, SignalState. No implementation.

NOTE: selene 0.32.0's parser does not accept inline literal types (e.g. `"closed" | "open"`)
inside type tables, so literal domains are declared as aliases first and referenced by name.
--]]

export type Direction = number -- train direction along the line: -1 backward, 1 forward (validated at the remote boundary)
export type Reverser = number -- reverser handle: -1, 0 (neutral), or 1 (validated at the remote boundary)
export type DoorState = "closed" | "opening" | "open" | "closing"
export type DoorCommand = "open" | "close" | "hold"
export type SignalAspect = "red" | "yellow" | "green"

-- Server-authoritative snapshot of one train, replicated at the fixed tick.
-- All distances are studs along the train's current line (arc-length position).
export type TrainState = {
	trainId: string,
	lineId: string,
	distanceStuds: number,
	speedStudsPerS: number,
	direction: Direction,
	doorState: DoorState,
	signalAspect: SignalAspect,
	speedLimitKph: number,
	updatedAt: number, -- server os.clock() when this state was computed
}

-- Driving intent sent by the client. The server validates and decides; the client never sends
-- position. Numeric fields are bounded (-1..1 or 0..1) — see RemoteContract validators.
export type TrainCommand = {
	throttle: number, -- -1 (full reverse power) .. 1 (full forward power)
	brake: number, -- 0 (none) .. 1 (full service brake)
	reverser: Reverser,
	horn: boolean?,
	doors: DoorCommand?,
}

-- One tracked section of the network. Control points are studs in the world frame defined by
-- docs/rail/NETWORK.md. The server holds the authoritative spline; clients interpolate visually.
export type TrackSegment = {
	segmentId: string,
	lineId: string,
	-- Cubic Catmull-Rom control points defining the centre line, in order.
	spline: { { x: number, y: number, z: number } },
	lengthStuds: number,
	speedLimitKph: number,
	-- Track grade (slope sine, -1 = straight down, 1 = straight up), used by Kinematics.luau.
	grade: number,
}

export type SignalState = {
	segmentId: string,
	aspect: SignalAspect,
}

-- A scheduled stop marker on a line (timetable data, Phase 2).
export type StationStop = {
	stationId: string,
	lineId: string,
	distanceStuds: number, -- stop marker arc-length position on the line
	platformLengthStuds: number,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">RemoteContract</string>
            <string name="Source"><![CDATA[--!strict
--[[
RemoteContract.luau — PROPOSED remote table.

OWNERSHIP: src/shared/Contracts/** is Manager A-owned. This file is a PROPOSAL by CODE · vector;
it is not merged or frozen until the Manager ratifies it in the PR thread, after agreement with
CODE · lumen (who implements the client side).

CONTENTS: data only — remote names, directions, request/response shape references and per-player
rate limits. No implementation. Every remote is validated server-side on type, finite numbers,
bounds, rate limit, player state and authority (STANDARDS.md; Remote events/security resource).

RATE LIMITS are per player: maxPerSecond sustained, burst allowed.
--]]

export type RemoteDirection = "ClientToServer" | "ServerToClient"

export type RemoteRate = {
	maxPerSecond: number,
	burst: number,
}

export type RemoteEntry = {
	name: string,
	direction: RemoteDirection,
	request: string?, -- shape name in RailContract / GameplayContract, if any
	response: string?, -- shape name, if any
	rate: RemoteRate,
}

local RemoteContract = {
	Train = {
		-- Player drives a train: intent only; the server applies it at the fixed tick.
		Control = {
			name = "Train.Control",
			direction = "ClientToServer",
			request = "TrainCommand",
			response = nil,
			rate = { maxPerSecond = 30, burst = 60 }, -- one per client tick at 30 Hz
		},
		-- Server publishes authoritative train state at the fixed tick.
		State = {
			name = "Train.State",
			direction = "ServerToClient",
			request = nil,
			response = "TrainState[]",
			rate = { maxPerSecond = 30, burst = 60 },
		},
	},
	Station = {
		-- Player requests to board/alight at a station (Phase 2 passenger system).
		Board = {
			name = "Station.Board",
			direction = "ClientToServer",
			request = "StationBoardRequest",
			response = "StationBoardResponse",
			rate = { maxPerSecond = 2, burst = 4 },
		},
	},
	Signal = {
		-- Server pushes current signal aspects for the lines relevant to a player.
		Observe = {
			name = "Signal.Observe",
			direction = "ServerToClient",
			request = nil,
			response = "SignalState[]",
			rate = { maxPerSecond = 10, burst = 20 },
		},
	},
}

return RemoteContract
]]></string>
          </Properties>
